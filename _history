: number): void {\" line80=\"        let buf = pins.createBuffer(2);\" line81=\"        buf[0] = reg;\" line82=\"        buf[1] = dat;\" line83=\"        pins.i2cWriteBuffer(BME280_I2C_ADDR, buf);\" line84=\"    }\" line85=\"\" line86=\"    /**\" line87=\"     * Function &quot;Reads 1 byte from a register of the BME280&quot;.\" line88=\"     * BME280の任意のレジスタから 1 バイトの値を読み取る関数。\" line89=\"     *\" line90=\"     * @param reg Register address (integer) / レジストリアドレス（整数値）\" line91=\"     * @returns Value read (integer) / 読み取った値（整数値）\" line92=\"     *\" line93=\"     * Sends the register address via I2C using UInt8BE format,\" line94=\"     * then reads 1 byte from the device.\" line95=\"     * レジストリアドレスを UInt8BE 形式で送信し、1 バイトを読み取って返します。\" line96=\"     */\" line97=\"    function getreg(reg: number): number {\" line98=\"        pins.i2cWriteNumber(BME280_I2C_ADDR, reg, NumberFormat.UInt8BE);\" line99=\"        return pins.i2cReadNumber(BME280_I2C_ADDR, NumberFormat.UInt8BE);\" line100=\"    }\" line101=\"\" line102=\"    /**\" line103=\"     * Function &quot;Reads a 16-bit unsigned integer&quot;.\" line104=\"     * 8 ビットの符号付き整数を読み取る関数。\" line105=\"     *\" line106=\"     * Used for calibration parameters such as dig_H6..\" line107=\"     * 補正パラメータ dig_H6 に使用。\" line108=\"     *\" line109=\"     * @param reg Register address / レジストリアドレス\" line110=\"     * @returns Unsigned 8-bit integer / 符号付き8ビット整数\" line111=\"       */\" line112=\"    function getInt8LE(reg: number): number {\" line113=\"        pins.i2cWriteNumber(BME280_I2C_ADDR, reg, NumberFormat.UInt8BE);\" line114=\"        return pins.i2cReadNumber(BME280_I2C_ADDR, NumberFormat.Int8LE);\" line115=\"    }\" line116=\"\" line117=\"    /**\" line118=\"     * Function &quot;Reads a 16-bit unsigned integer&quot;.\" line119=\"     * 16 ビットの符号なし整数を読み取る関数。\" line120=\"     *\" line121=\"     * Used for calibration parameters such as dig_T1, dig_P1, etc.\" line122=\"     * dig_T1、dig_P1 などの補正パラメータ用に使用します。\" line123=\"     *\" line124=\"     * @param reg Register address / レジストリアドレス\" line125=\"     * @returns Unsigned 16-bit integer / 符号なし 16 ビット整数\" line126=\"       */\" line127=\"    function getUInt16LE(reg: number): number {\" line128=\"        pins.i2cWriteNumber(BME280_I2C_ADDR, reg, NumberFormat.UInt8BE);\" line129=\"        return pins.i2cReadNumber(BME280_I2C_ADDR, NumberFormat.UInt16LE);\" line130=\"    }\" line131=\"\" line132=\"    /**\" line133=\"       * Function &quot;Reads a 16-bit signed integer&quot;.\" line134=\"       * 16 ビットの符号付き整数を読み取る関数。\" line135=\"       * \" line136=\"       * Used for calibration parameters such as dig_T2, dig_T3, dig_P2.\" line137=\"       * dig_T2、dig_T3、dig_P2 などの補正パラメータ用に使用します。\" line138=\"     *\" line139=\"       * @param reg Register address / レジストリアドレス\" line140=\"       * @returns Signed 16-bit integer / 符号付き 16 ビット整数\" line141=\"       */\" line142=\"    function getInt16LE(reg: number): number {\" line143=\"        pins.i2cWriteNumber(BME280_I2C_ADDR, reg, NumberFormat.UInt8BE);\" line144=\"        return pins.i2cReadNumber(BME280_I2C_ADDR, NumberFormat.Int16LE);\" line145=\"    }\" line146=\"\" line147=\"    // Rounding numbers/数値の四捨五入\" line148=\"    // Integer/demicl 1 place /demicl 2 place\" line149=\"    // 整数 / 小数第1位 / 小数第２位\" line150=\"    export function Rnber(dt:number,Rdp:number): number {\" line151=\"        return Math.round(dt*Rdp)/Rdp\" line152=\"    }\" line153=\"\" line154=\"    // Function &quot;Get Tempratuer , Pressuer and humidity&quot;.\" line155=\"    // 気温・気圧・湿度取得の関数\" line156=\"    /**\" line157=\"         * BME280 calibration parameters for temperature, pressure and humidity.\" line158=\"         * BME280 の温度・気圧・湿度補正用キャリブレーションパラメータ。\" line159=\"     * \" line160=\"         * Address range: 0x88 to 0xE7 (factory-programmed values)\" line161=\"         * アドレス範囲：0x88 ～ 0xE7（工場出荷時に書き込まれた補正値）\" line162=\"         * \" line163=\"         * Common to BMP280 &amp; BME280 sensors\" line164=\"     * (excluding humidity-related registers 0xA1 to 0xE7)\" line165=\"         * BMP280・BME280 センサーで共通\" line166=\"     *（湿度関連のレジスタ 0xA1 ～ 0xE7は除く）\" line167=\"         */\" line168=\"    /**\" line169=\"         * Set &quot;BME280 calibration parameter registers&quot;\" line170=\"     * BME280温度・気圧・湿度補正用キャリブレーションパラメータのレジストリ　\" line171=\"           * dig_T1 to dig_T3: temperature/気温補正\" line172=\"     * dig_P1 to dig_P9: pressuere/気圧補正\" line173=\"     * dig_H1 to dig_H6: humidity/湿度補正\" line174=\"     */\" line175=\"    // Temperature calibration parameters / 気温補正用パラメータ\" line176=\"    let dig_T1 = getUInt16LE(0x88)\" line177=\"    let dig_T2 = getInt16LE(0x8A)\" line178=\"    let dig_T3 = getInt16LE(0x8C)\" line179=\"\" line180=\"    // Pressure calibration parameters / 気圧補正用パラメータ\" line181=\"    let dig_P1 = getUInt16LE(0x8E)\" line182=\"    let dig_P2 = getInt16LE(0x90)\" line183=\"    let dig_P3 = getInt16LE(0x92)\" line184=\"    let dig_P4 = getInt16LE(0x94)\" line185=\"    let dig_P5 = getInt16LE(0x96)\" line186=\"    let dig_P6 = getInt16LE(0x98)\" line187=\"    let dig_P7 = getInt16LE(0x9A)\" line188=\"    let dig_P8 = getInt16LE(0x9C)\" line189=\"    let dig_P9 = getInt16LE(0x9E)\" line190=\"\" line191=\"    // Humidity calibration parameters / 湿度補正用パラメータ   &#9;&#9;\" line192=\"    let dig_H1 = getreg(0xA1)\" line193=\"    let dig_H2 = getInt16LE(0xE1)\" line194=\"    let dig_H3 = getreg(0xE3)\" line195=\"    let a = getreg(0xE5)\" line196=\"    let dig_H4 = (getreg(0xE4) &lt;&lt; 4) + (a % 16)\" line197=\"    let dig_H5 = (getreg(0xE6) &lt;&lt; 4) + (a &gt;&gt; 4)\" line198=\"    let dig_H6 = getInt8LE(0xE7)\" line199=\"\" line200=\"    /**\" line201=\"         * Sensor configuration:\" line202=\"         * - Set humidity oversampling to x4 (ctrl_hum, 0xF2)\" line203=\"         * - Set temperature oversampling to x16, pressure oversampling to x1, normal mode (ctrl_meas, 0xF4)\" line204=\"         * - Set standby time to 250ms and filter coefficient to x4 (config, 0xF5)\" line205=\"         *\" line206=\"         * センサーの設定：\" line207=\"         * - 湿度のオーバーサンプリングを4倍に設定（ctrl_hum、0xF2）\" line208=\"         * - 温度のオーバーサンプリングを16倍、気圧を1倍、動作モードをノーマルに設定（ctrl_meas、0xF4）\" line209=\"         * - スタンバイ時間を250ms、フィルター係数を4倍に設定（config、0xF5）\" line210=\"         */\" line211=\"    setreg(0xF2, 0x04)\" line212=\"    setreg(0xF4, 0x2F)\" line213=\"    setreg(0xF5, 0x0C)\" line214=\"\" line215=\"    /**\" line216=\"     * Calculate Temperatuer , Pressure and Humidity\" line217=\"         * 気温・気圧・湿度の算出\" line218=\"         * Reads raw data from the sensor and calculates\" line219=\"     * corrected temperature , pressure and humidity.\" line220=\"         * センサーから生データを読み取り、\" line221=\"     * 補正済みの気温・気圧・湿度を算出。\" line222=\"         */\" line223=\"    function get(): void {\" line224=\"        // Calculate Temperatuer/気温の計算\" line225=\"        // Read raw temperature data (20 bits)\" line226=\"        // 温度の生データ（20ビット）読み取り\" line227=\"        let adc_T = (getreg(0xFA) &lt;&lt; 12) + (getreg(0xFB) &lt;&lt; 4) + (getreg(0xFC) &gt;&gt; 4)\" line228=\"        let var1 = (((adc_T &gt;&gt; 3) - (dig_T1 &lt;&lt; 1)) * dig_T2) &gt;&gt; 11\" line229=\"        let var2 = (((((adc_T &gt;&gt; 4) - dig_T1) * ((adc_T &gt;&gt; 4) - dig_T1)) &gt;&gt; 12) * dig_T3) &gt;&gt; 14\" line230=\"        let t_fine = var1 + var2;\" line231=\"        let temp = t_fine;\" line232=\"        // Calculate corrected temperature(no rounding)\" line233=\"        // 補正後の気温を計算（数値の丸めなし）\" line234=\"        T = ((temp * 5 + 128) / 256.0) / 100.0 ;\" line235=\"\" line236=\"        // Calculate Pressure/気圧の計算\" line237=\"        // Read raw pressure data (20 bits)\" line238=\"        // 気圧の生データ（20ビット）読み取り\" line239=\"        let adc_P = (getreg(0xF7) &lt;&lt; 12) + (getreg(0xF8) &lt;&lt; 4) + (getreg(0xF9) &gt;&gt; 4);\" line240=\"\" line241=\"        // Pressure compensation calculation\" line242=\"        // 気圧補正の計算\" line243=\"        var1 = (t_fine &gt;&gt; 1) - 64000;\" line244=\"        var2 = (((var1 &gt;&gt; 2) * (var1 &gt;&gt; 2)) &gt;&gt; 11) * dig_P6;\" line245=\"        var2 = var2 + ((var1 * dig_P5) &lt;&lt; 1);\" line246=\"        var2 = (var2 &gt;&gt; 2) + (dig_P4 &lt;&lt; 16);\" line247=\"        var1 = (((dig_P3 * ((var1 &gt;&gt; 2) * (var1 &gt;&gt; 2)) &gt;&gt; 13) &gt;&gt; 3) + ((dig_P2 * var1) &gt;&gt; 1)) &gt;&gt; 18;\" line248=\"        var1 = ((32768 + var1) * dig_P1) &gt;&gt; 15;\" line249=\"        if (var1 == 0) {\" line250=\"            return; // Prevent division by zero / 0除算防止\" line251=\"        }\" line252=\"        let _p = ((1048576 - adc_P) - (var2 &gt;&gt; 12)) * 3125;\" line253=\"\" line254=\"        // Calculate Pressure (no rounding)/気圧を算出（数値の丸めなし）\" line255=\"        _p = (_p / var1) * 2 ;\" line256=\"        var1 = (dig_P9 * (((_p &gt;&gt; 3) * (_p &gt;&gt; 3)) &gt;&gt; 13)) &gt;&gt; 12;\" line257=\"        var2 = (((_p &gt;&gt; 2)) * dig_P8) &gt;&gt; 13;\" line258=\"        P = _p + ((var1 + var2 + dig_P7) &gt;&gt; 4);\" line259=\"\" line260=\"        // Calculate Humidity/&#9;湿度の計算\" line261=\"        // Read raw pressure data (16 bits)\" line262=\"        // 湿度の生データ（16ビット）読み取り\" line263=\"        let adc_H = (getreg(0xFD) &lt;&lt; 8) + getreg(0xFE)\" line264=\"        var1 = t_fine - 76800\" line265=\"        var2 = (((adc_H &lt;&lt; 14) - (dig_H4 &lt;&lt; 20) - (dig_H5 * var1)) + 16384) &gt;&gt; 15\" line266=\"        var1 = var2 * (((((((var1 * dig_H6) &gt;&gt; 10) * (((var1 * dig_H3) &gt;&gt; 11) + 32768)) &gt;&gt; 10) + 2097152) * dig_H2 + 8192) &gt;&gt; 14)\" line267=\"        var2 = var1 - (((((var1 &gt;&gt; 15) * (var1 &gt;&gt; 15)) &gt;&gt; 7) * dig_H1) &gt;&gt; 4)\" line268=\"        if (var2 &lt; 0) var2 = 0\" line269=\"        if (var2 &gt; 419430400) var2 = 419430400\" line270=\"        // Calculate Humidity (no rounding)/湿度を算出（数値の丸めなし）\" line271=\"        H = var2 / 4194304.0\" line272=\"    }\" line273=\"    //\" line274=\"    /**\" line275=\"     *  Get pressure value from BME280 sensor/BME280 センサーから気圧を取得\" line276=\"         *   \" line277=\"         *  @param u Pressure unit (Pa or hPa) / 気圧の単位（Pa または hPa）\" line278=\"         *  @returns Pressure value / 気圧の値（単位に応じた小数第1位）\" line279=\"         */\" line280=\"    //% blockId=&quot;BME280_GET_PRESSURE&quot;\" line281=\"    //% block=&quot;Pressuer / 気圧 %Pu　Accuracy / 精度 %Prd&quot;\" line282=\"    //% weight=80 blockGap=8\" line283=\"    export function pressure(Pu: BME280_P,Prd: RPoint): number {\" line284=\"        get();\" line285=\"        return Rnber(P/Pu,Prd)\" line286=\"    }\" line287=\"\" line288=\"    /**\" line289=\"     * Get temperature value from BME280 sensor/ BME280 センサーから気温を取得します\" line290=\"         *\" line291=\"         * @param u Temperature unit (C or F) / 温度の単位（C または F）\" line292=\"         * @returns Temperature value / 気温の値（単位に応じた小数第1位）\" line293=\"         */\" line294=\"    //% blockId=&quot;BME280_GET_TEMPERATURE&quot;\" line295=\"    //% block=&quot;Tempratuere /気温 %Tu Accuracy / 精度 %Trd&quot;\" line296=\"    //% weight=80 blockGap=8\" line297=\"    export function temperature(Tu: BME280_T, Trd: RPoint): number {\" line298=\"        get();\" line299=\"        let tmp=T\" line300=\"        if (Tu == BME280_T.T_F) { \" line301=\"            //Fahrenheit degree/華氏&#9;\" line302=\"            tmp = T * 9 / 5 + 32;\" line303=\"        }\" line304=\"        return Rnber(tmp , Trd)\" line305=\"    }\" line306=\"\" line307=\"    /**\" line308=\"     * Get humidity value from BME280 sensor / BME280 センサーから湿度を取得します\" line309=\"         *\" line310=\"         * @param u Humidity unit % / 湿度の単位 %\" line311=\"         * @returns Temperature value / 湿度の値（小数第1位）\" line312=\"         */\" line313=\"    //% blockId=&quot;BME280_GET_HUMIDITY&quot;\" line314=\"    //% block=&quot;Humidity / 湿度 精度 %Hrd&quot;\" line315=\"    //% weight=80 blockGap=8\" line316=\"    export function humidity(Hrd:RPoint): number {\" line317=\"        get();\" line318=\"        return Rnber(H,Hrd);\" line319=\"    }\" line320=\"    //Sensor power control (Power ON and OFF)\" line321=\"    //センサーの電源管理（起動と停止）\" line322=\"    /**\" line323=\"     * power on / センサー起動\" line324=\"       */\" line325=\"    //% blockId=&quot;BME280_POWER_ON&quot; block=&quot;\" line326=\"    //% block=&quot;Power On Sensor /センサー起動&quot;&quot;\" line327=\"    //% weight=22 blockGap=8\" line328=\"    export function PowerOn() {\" line329=\"        setreg(0xF4, 0x2F)\" line330=\"    }\" line331=\"\" line332=\"    /**\" line333=\"     * power oFF　センサー停止\" line334=\"       */\" line335=\"    //% blockId=&quot;BME280_POWER_OFF&quot;\" line336=\"    //% block=&quot;Power OFF Sensor/センサー停止&quot;\" line337=\"    //% weight=21 blockGap=8\" line338=\"    export function PowerOff() {\" line339=\"        setreg(0xF4, 0)\" line340=\"    }\" line341=\"\" line342=\"    /**\" line343=\"     * Calculate Dewpoint　露点計算\" line344=\"     */\" line345=\"    //% block=&quot;Dewpoint / 露点&quot;\" line346=\"    //% weight=60 blockGap=8\" line347=\"    export function Dewpoint(Drd:RPoint): number {\" line348=\"        get();\" line349=\"        return T - Math.idiv(100 - H, 5)\" line350=\"    }\" line351=\"\" line352=\"    /**\" line353=\"     * Event Block\" line354=\"     * イベントブロック\" line355=\"     */\" line356=\"    /**\" line357=\"        * Triggered when pressure is Lower than a specified value. / 気圧が指定値より低い場合\" line358=\"        *\" line359=\"        * @param dat Threshold value / しきい値（Pa）\" line360=\"        * @param body Action to perform / 実行する処理\" line361=\"        */\" line362=\"    //% block=&quot;Pressuer / 気圧 &lt;  %dat&quot; dat.defl=100000\" line363=\"    export function PressureBelowThan(dat: number, body: () =&gt; void): void {\" line364=\"        control.inBackground(function () {\" line365=\"            while (true) {\" line366=\"                get()\" line367=\"                if (P &lt; dat) {\" line368=\"                    body()\" line369=\"                }\" line370=\"                basic.pause(1000)\" line371