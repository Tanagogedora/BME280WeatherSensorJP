  // Temperature units: C (Celsius) or F (Fahrenheit) / 温度単位：C（摂氏）または F（華氏）\" line12=\"    export enum BME280_T {\" line13=\"        //% block=&quot;C&quot;\" line14=\"        T_C = 0,\" line15=\"        //% block=&quot;F&quot;\" line16=\"        T_F = 1\" line17=\"    }\" line18=\"\" line19=\"    // Pressure Unit / 気圧の単位\" line20=\"    // Pressure units: Pa or hPa / 単位：Pa（パスカル）または hPa（ヘクトパスカル）\" line21=\"    export enum BME280_P {\" line22=\"        //% block=&quot;Pa&quot;\" line23=\"        Pa = 1,\" line24=\"        //% block=&quot;hPa&quot;\" line25=\"        hPa = 100\" line26=\"    }\" line27=\"\" line28=\"    // Unit of Elevation difference / 標高差の単位（m/ft）\" line29=\"    export enum Eldf {\" line30=\"        //Units meter/単位 メートル\" line31=\"        //% block=&quot;m&quot;\" line32=\"            altd_m=1,\" line33=\"        //Units feet/単位 フィート\" line34=\"        //% block=&quot;ft&quot;\" line35=\"            altd_f = 2\" line36=\"    }\" line37=\"\" line38=\"    // Selection of Saturated Water Vapor Pressure,\" line39=\"    // Saturated Water Vapor Amount\" line40=\"    // and Dew Point\" line41=\"    // 飽和水蒸気圧・飽和水蒸気量・露点の選択\" line42=\"\" line43=\"    export enum Spad {\" line44=\"        //% block=&quot;Saturated Water Vapor Presure / 飽和水蒸気圧&quot;\" line45=\"            swp=1,\" line46=\"        //% block=&quot;Saturated Water Vapor Amount / 飽和水蒸気量&quot;\" line47=\"            swa=2,\" line48=\"        //% block=&quot;Dew Point / 露点&quot;\" line49=\"            dwp=3\" line50=\"    }\" line51=\"\" line52=\"    // Selection Humidity Selection,Water Vapor Pressure and Water Vapor Amount \" line53=\"    // 相対湿度・水蒸気圧・水蒸気量の選択\" line54=\"    export enum SelecHPA {\" line55=\"        // block=&quot;Humidit / 湿度&quot;\" line56=\"            hmdy=1,\" line57=\"        // block=&quot;Water Vapor Pressure / 水蒸気圧&quot;\" line58=\"            wvp=2,\" line59=\"        // block=&quot;Water Vapor Amount / 水蒸気量&quot;\" line60=\"            wva=3\" line61=\"    }\" line62=\"   \" line63=\"    // Numerical precision\" line64=\"    // 数値の精度\" line65=\"    // Integer / 1　decimal place\" line66=\"    // 整数 / 小数第1位\" line67=\"    export enum RPoint {\" line68=\"        //% block=&quot;Integer/整数&quot;\" line69=\"            Rint=1,\" line70=\"        //% block=&quot;1 demicl place / 小数第1位&quot;\" line71=\"            RPt=10,\" line72=\"    }\" line73=\"        \" line74=\"    /**\" line75=\"     * Global variables to store the final compensated\" line76=\"     * temperature, pressure and humidity \" line77=\"     * temperature&#9;: unit  °C\" line78=\"     * pressuere&#9;: unit Pa\" line79=\"     * humidity&#9;&#9;: unit %\" line80=\"     * \" line81=\"     * グローバル変数：補正後の気温・気圧・湿度\" line82=\"     * 単位　気温：℃　気圧：Pa　湿度：％\" line83=\"     */\" line84=\"    let T = 0;\" line85=\"    let P = 0;\" line86=\"    let H = 0;\" line87=\"\" line88=\"    // Default I2C address: 0x77 / デフォルトの I2C アドレス：0x77\" line89=\"    let BME280_I2C_ADDR = BME280_I2C_ADDRESS.ADDR_0x76\" line90=\"\" line91=\"    // Defining Functions / 関数の定義\" line92=\"    /** \" line93=\"     * Functions &quot;Access to BME280 Registers&quot;\" line94=\"     * BME280のレジスタへのアクセスを行う関数群\" line95=\"     * A set of functions for reading from and writing to BME280\" line96=\"     * registers via I2C communication.\" line97=\"     * I2C 通信を用いて、各種レジスタへの読み書きを行う\" line98=\"     */\" line99=\"\" line100=\"    /**\" line101=\"     * Function &quot;Writes 1 byte from a register of the BME280&quot;.\" line102=\"     * BME280のレジスタに1バイトのデータを書き込む関数\" line103=\"     *\" line104=\"     * @param reg Register address (integer) / レジストリアドレス（整数値）\" line105=\"     * @returns dat write (integer) / 書き込んだ値（整数値）\" line106=\"     * @returns None/戻り値はない\" line107=\"     *\" line108=\"     * Creates a 2-byte buffer: the first byte is the register address (buf[0]),\" line109=\"     * the second byte is the data to write (buf[1]), and sends it via I2C.\" line110=\"     * レジスタアドレス（buf[0]）と書き込むデータ（buf[1]）を格納した2バイトのバッファを作成し、\" line111=\"     * I2C を使ってデバイスに送信。\" line112=\"     */\" line113=\"    function setreg(reg: number, dat: number): void {\" line114=\"        let buf = pins.createBuffer(2);\" line115=\"        buf[0] = reg;\" line116=\"        buf[1] = dat;\" line117=\"        pins.i2cWriteBuffer(BME280_I2C_ADDR, buf);\" line118=\"    }\" line119=\"\" line120=\"    /**\" line121=\"     * Function &quot;Reads 1 byte from a register of the BME280&quot;.\" line122=\"     * BME280の任意のレジスタから 1 バイトの値を読み取る関数。\" line123=\"     *\" line124=\"     * @param reg Register address (integer) / レジストリアドレス（整数値）\" line125=\"     * @returns Value read (integer) / 読み取った値（整数値）\" line126=\"     *\" line127=\"     * Sends the register address via I2C using UInt8BE format,\" line128=\"     * then reads 1 byte from the device.\" line129=\"     * レジストリアドレスを UInt8BE 形式で送信し、1 バイトを読み取って返す。\" line130=\"     */\" line131=\"    function getreg(reg: number): number {\" line132=\"        pins.i2cWriteNumber(BME280_I2C_ADDR, reg, NumberFormat.UInt8BE);\" line133=\"        return pins.i2cReadNumber(BME280_I2C_ADDR, NumberFormat.UInt8BE);\" line134=\"    }\" line135=\"\" line136=\"    /**\" line137=\"     * Function &quot;Reads a 16-bit unsigned integer&quot;.\" line138=\"     * 8 ビットの符号付き整数を読み取る関数。\" line139=\"     *\" line140=\"     * Used for calibration parameters such as dig_H6..\" line141=\"     * 補正パラメータ dig_H6 に使用。\" line142=\"     *\" line143=\"     * @param reg Register address / レジストリアドレス\" line144=\"     * @returns Unsigned 8-bit integer / 符号付き8ビット整数\" line145=\"     */\" line146=\"    function getInt8LE(reg: number): number {\" line147=\"        pins.i2cWriteNumber(BME280_I2C_ADDR, reg, NumberFormat.UInt8BE);\" line148=\"        return pins.i2cReadNumber(BME280_I2C_ADDR, NumberFormat.Int8LE);\" line149=\"    }\" line150=\"\" line151=\"    /**\" line152=\"     * Function &quot;Reads a 16-bit unsigned integer&quot;.\" line153=\"     * 16 ビットの符号なし整数を読み取る関数。\" line154=\"     *\" line155=\"     * Used for calibration parameters such as dig_T1, dig_P1, etc.\" line156=\"     * dig_T1、dig_P1 などの補正パラメータ用に使用。\" line157=\"     *\" line158=\"     * @param reg Register address / レジストリアドレス\" line159=\"     * @returns Unsigned 16-bit integer / 符号なし 16 ビット整数\" line160=\"     */\" line161=\"    function getUInt16LE(reg: number): number {\" line162=\"        pins.i2cWriteNumber(BME280_I2C_ADDR, reg, NumberFormat.UInt8BE);\" line163=\"        return pins.i2cReadNumber(BME280_I2C_ADDR, NumberFormat.UInt16LE);\" line164=\"    }\" line165=\"\" line166=\"    /**\" line167=\"     * Function &quot;Reads a 16-bit signed integer&quot;.\" line168=\"     * 16 ビットの符号付き整数を読み取る関数。\" line169=\"     * \" line170=\"     * Used for calibration parameters such as dig_T2, dig_T3, dig_P2.\" line171=\"     * dig_T2、dig_T3、dig_P2 などの補正パラメータ用に使用します。\" line172=\"     *\" line173=\"     * @param reg Register address / レジストリアドレス\" line174=\"     * @returns Signed 16-bit integer / 符号付き 16 ビット整数\" line175=\"     */\" line176=\"    function getInt16LE(reg: number): number {\" line177=\"        pins.i2cWriteNumber(BME280_I2C_ADDR, reg, NumberFormat.UInt8BE);\" line178=\"        return pins.i2cReadNumber(BME280_I2C_ADDR, NumberFormat.Int16LE);\" line179=\"    }\" line180=\"\" line181=\"    // Rounding numbers/数値の四捨五入\" line182=\"    // Integer/demicl 1 place /demicl 2 place\" line183=\"    // 整数 / 小数第1位 / 小数第２位\" line184=\"    export function Rnber(dt:number,Rdp:number): number {\" line185=\"        return Math.round(dt*Rdp)/Rdp\" line186=\"    }\" line187=\"\" line188=\"    // Function &quot;Get Tempratuer , Pressuer and humidity&quot;.\" line189=\"    // 気温・気圧・湿度取得の関数\" line190=\"    /**\" line191=\"     * BME280 calibration parameters for temperature, pressure and humidity.\" line192=\"     * BME280 の温度・気圧・湿度補正用キャリブレーションパラメータ。\" line193=\"     * \" line194=\"     * Address range: 0x88 to 0xE7 (factory-programmed values)\" line195=\"     * アドレス範囲：0x88 ～ 0xE7（工場出荷時に書き込まれた補正値）\" line196=\"     * \" line197=\"     * Common to BMP280 &amp; BME280 sensors\" line198=\"     * (excluding humidity-related registers 0xA1 to 0xE7)\" line199=\"     * BMP280・BME280 センサーで共通\" line200=\"     *（湿度関連のレジスタ 0xA1 ～ 0xE7は除く）\" line201=\"     */\" line202=\"\" line203=\"    /**\" line204=\"     * Set &quot;BME280 calibration parameter registers&quot;\" line205=\"     * BME280温度・気圧・湿度補正用キャリブレーションパラメータのレジストリ　\" line206=\"     * dig_T1 to dig_T3: temperature/気温補正\" line207=\"     * dig_P1 to dig_P9: pressuere/気圧補正\" line208=\"     * dig_H1 to dig_H6: humidity/湿度補正\" line209=\"     */\" line210=\"    // Temperature calibration parameters / 気温補正用パラメータ\" line211=\"    let dig_T1 = getUInt16LE(0x88)\" line212=\"    let dig_T2 = getInt16LE(0x8A)\" line213=\"    let dig_T3 = getInt16LE(0x8C)\" line214=\"\" line215=\"    // Pressure calibration parameters / 気圧補正用パラメータ\" line216=\"    let dig_P1 = getUInt16LE(0x8E)\" line217=\"    let dig_P2 = getInt16LE(0x90)\" line218=\"    let dig_P3 = getInt16LE(0x92)\" line219=\"    let dig_P4 = getInt16LE(0x94)\" line220=\"    let dig_P5 = getInt16LE(0x96)\" line221=\"    let dig_P6 = getInt16LE(0x98)\" line222=\"    let dig_P7 = getInt16LE(0x9A)\" line223=\"    let dig_P8 = getInt16LE(0x9C)\" line224=\"    let dig_P9 = getInt16LE(0x9E)\" line225=\"\" line226=\"    // Humidity calibration parameters / 湿度補正用パラメータ   &#9;&#9;\" line227=\"    let dig_H1 = getreg(0xA1)\" line228=\"    let dig_H2 = getInt16LE(0xE1)\" line229=\"    let dig_H3 = getreg(0xE3)\" line230=\"    let a = getreg(0xE5)\" line231=\"    let dig_H4 = (getreg(0xE4) &lt;&lt; 4) + (a % 16)\" line232=\"    let dig_H5 = (getreg(0xE6) &lt;&lt; 4) + (a &gt;&gt; 4)\" line233=\"    let dig_H6 = getInt8LE(0xE7)\" line234=\"\" line235=\"    /**\" line236=\"     * Sensor configuration:\" line237=\"     * - Set humidity oversampling to x4 (ctrl_hum, 0xF2)\" line238=\"     * - Set temperature oversampling to x16, pressure oversampling to x1, normal mode (ctrl_meas, 0xF4)\" line239=\"     * - Set standby time to 250ms and filter coefficient to x4 (config, 0xF5)\" line240=\"     *\" line241=\"     * センサーの設定：\" line242=\"     * - 湿度のオーバーサンプリングを4倍に設定（ctrl_hum、0xF2）\" line243=\"     * - 温度のオーバーサンプリングを16倍、気圧を1倍、動作モードをノーマルに設定（ctrl_meas、0xF4）\" line244=\"     * - スタンバイ時間を250ms、フィルター係数を4倍に設定（config、0xF5）\" line245=\"     */\" line246=\"    setreg(0xF2, 0x04)\" line247=\"    setreg(0xF4, 0x2F)\" line248=\"    setreg(0xF5, 0x0C)\" line249=\"\" line250=\"    /**\" line251=\"     * Calculate Temperatuer , Pressure and Humidity\" line252=\"     * 気温・気圧・湿度の算出\" line253=\"     * Reads raw data from the sensor and calculates\" line254=\"     * corrected temperature , pressure and humidity.\" line255=\"     * センサーから生データを読み取り、\" line256=\"     * 補正済みの気温・気圧・湿度を算出。\" line257=\"     */\" line258=\"    function get(): void {\" line259=\"        // Calculate Temperatuer/気温の計算\" line260=\"        // Read raw temperature data (20 bits)\" line261=\"        // 温度の生データ（20ビット）読み取り\" line262=\"        let adc_T = (getreg(0xFA) &lt;&lt; 12) + (getreg(0xFB) &lt;&lt; 4) + (getreg(0xFC) &gt;&gt; 4)\" line263=\"        let var1 = (((adc_T &gt;&gt; 3) - (dig_T1 &lt;&lt; 1)) * dig_T2) &gt;&gt; 11\" line264=\"        let var2 = (((((adc_T &gt;&gt; 4) - dig_T1) * ((adc_T &gt;&gt; 4) - dig_T1)) &gt;&gt; 12) * dig_T3) &gt;&gt; 14\" line265=\"        let t_fine = var1 + var2;\" line266=\"        let temp = t_fine;\" line267=\"        // Calculate corrected temperature(no rounding)\" line268=\"        // 補正後の気温を計算（数値の丸めなし）\" line269=\"        T = ((temp * 5 + 128) / 256.0) / 100.0 ;\" line270=\"\" line271=\"        // Calculate Pressure/気圧の計算\" line272=\"        // Read raw pressure data (20 bits)\" line273=\"        // 気圧の生データ（20ビット）読み取り\" line274=\"        let adc_P = (getreg(0xF7) &lt;&lt; 12) + (getreg(0xF8) &lt;&lt; 4) + (getreg(0xF9) &gt;&gt; 4);\" line275=\"\" line276=\"        // Pressure compensation calculation\" line277=\"        // 気圧補正の計算\" line278=\"        var1 = (t_fine &gt;&gt; 1) - 64000;\" line279=\"        var2 = (((var1 &gt;&gt; 2) * (var1 &gt;&gt; 2)) &gt;&gt; 11) * dig_P6;\" line280=\"        var2 = var2 + ((var1 * dig_P5) &lt;&lt; 1);\" line281=\"        var2 = (var2 &gt;&gt; 2) + (dig_P4 &lt;&lt; 16);\" line282=\"        var1 = (((dig_P3 * ((var1 &gt;&gt; 2) * (var1 &gt;&gt; 2)) &gt;&gt; 13) &gt;&gt; 3) + ((dig_P2 * var1) &gt;&gt; 1)) &gt;&gt; 18;\" line283=\"        var1 = ((32768 + var1) * dig_P1) &gt;&gt; 15;\" line284=\"        if (var1 == 0) {\" line285=\"            return; // Prevent division by zero / 0除算防止\" line286=\"        }\" line287=\"        let _p = ((1048576 - adc_P) - (var2 &gt;&gt; 12)) * 3125;\" line288=\"\" line289=\"        // Calculate Pressure (no rounding)/気圧を算出（数値の丸めなし）\" line290=\"        _p = (_p / var1) * 2 ;\" line291=\"        var1 = (dig_P9 * (((_p &gt;&gt; 3) * (_p &gt;&gt; 3)) &gt;&gt; 13)) &gt;&gt; 12;\" line292=\"        var2 = (((_p &gt;&gt; 2)) * dig_P8) &gt;&gt; 13;\" line293=\"        P = _p + ((var1 + var2 + dig_P7) &gt;&gt; 4);\" line294=\"\" line295=\"        // Calculate Humidity/&#9;湿度の計算\" line296=\"        // Read raw pressure data (16 bits)\" line297=\"        // 湿度の生データ（16ビット）読み取り\" line298=\"        let adc_H = (getreg(0xFD) &lt;&lt; 8) + getreg(0xFE)\" line299=\"        var1 = t_fine - 76800\" line300=\"        var2 = (((adc_H &lt;&lt; 14) - (dig_H4 &lt;&lt; 20) - (dig_H5 * var1)) + 16384) &gt;&gt; 15\" line301=\"        var1 = var2 * (((((((var1 * dig_H6) &gt;&gt; 10) * (((var1 * dig_H3) &gt;&gt; 11) + 32768)) &gt;&gt; 10) + 2097152) * dig_H2 + 8192) &gt;&gt; 14)\" line302=\"        var2 = var1 - (((((var1 &gt;&gt; 15) * (var1 &gt;&gt; 15)) &gt;&gt; 7) * dig_H1) &gt;&gt; 4)\" line303=\"        if (var2 &lt; 0) var2 = 0\" line304=\"        if (var2 &gt; 419430400) var2 = 419430400\" line305=\"        // Calculate Humidity (no rounding)/湿度を算出（数値の丸めなし）\" line306=\"        H = var2 / 4194304.0;\" line307=\"    }\" line308=\"    \" line309=\"    /**\" line310=\"     * Function Calculate saturation vapor pressure from temperature.\" line311=\"     * 気温から飽和水蒸気圧を計算する関数\" line312=\"     * Calculation precision 2nd decimal placen: 2 decimal place\" line313=\"     * 計算精度　小数点第2位\" line314=\"     * Saturation vapor pressure:Tetens-approximation\" line315=\"     * 飽和水蒸気圧：テテンスの近似式\" line316=\"     * 6.1078 * 10 ** ((7.5 * Temp)/(237.3 + Temp))\" line317=\"     * Dew Point:Improved Magnus formula / 改良マグヌス式\" line318=\"     */\" line319=\"    export function SatVpad(Temp: number ,RH: number) :{SVP: number,SVA: number,DPoint:number} {\" line320=\"        // numerator（分子）べき乗部の分子部　\" line321=\"        let NMER = 7.5 * Temp;\" line322=\"        // denominator(分母)　べき乗の分母部　\" line323=\"        let DMN = 237.3 + Temp;\" line324=\"        // Calcrate saturation vapor pressure / 飽和水蒸気圧の計算\" line325=\"        let SVP = 6.1078 * Math.pow(10, NMER / DMN);\" line326=\"        SVP=Rnber(SVP, 100);\" line327=\"        let SVA=217*SVP/(Temp+273.15);\" line328=\"        SVP=Rnber(SVA,100);\" line329=\"        // Calcrate Dewpoint / 露点の計算\" line330=\"        let da=17.62;\" line331=\"        let db=243.12;\" line332=\"        let alpha=(Temp+da)/(Temp+db)+Math.log(RH/100);\" line333=\"        let DPoint=(db*alpha)/(da-alpha);\" line334=\"        DPoint=Rnber(DPoint,100);\" line335=\"        return {\" line336=\"            SVP: SVP,\" line337=\"            SVA: SVA,\" line338=\"            DPoint: DPoint\" line339=\"            }\" line340=\"    }\" line341=\"    /**\" line342=\"     *  Get pressure value from BME280 sensor/BME280 センサーから気圧を取得\" line343=\"     *   \" line344=\"     *  @param u Pressure unit (Pa or hPa) / 気圧の単位（Pa または hPa）\" line345=\"     *  @returns Pressure value / 気圧の値（単位に応じた小数第1位）         \" line346=\"     */\" line347=\"    //% blockId=&quot;BME280_GET_PRESSURE&quot;\" line348=\"    //% block=&quot;Pressuer / 気圧 %Pu　Accuracy / 精度 %Prd&quot;\" line349=\"    //% weight=80 blockGap=8\" line350=\"    export function pressure(Pu: BME280_P,Prd: RPoint): number {\" line351=\"        get();\" line352=\"        return Rnber(P/Pu,Prd);\" line353=\"    }\" line354=\"\" line355=\"    /**\" line356=\"     * Get temperature value from BME280 sensor/ BME280 センサーから気温を取得\" line357=\"     *\" line358=\"     * @param u Temperature unit (C or F) / 温度の単位（C または F）\" line359=\"     * @returns Temperature value / 気温の値（単位に応じた小数第1位）\" line360=\"     */\" line361=\"    //% blockId=&quot;BME280_GET_TEMPERATURE&quot;\" line362=\"    //% block=&quot;Tempratuere /気温 %Tu Accuracy / 精度 %Trd&quot;\" line363=\"    //% weight=80 blockGap=8\" line364=\"    export function temperature(Tu: BME280_T, Trd: RPoint): number {\" line365=\"        get();\" line366=\"        let tmp=T\" line367=\"        if (Tu == BME280_T.T_F) { \" line368=\"            //Fahrenheit degree/華氏&#9;\" line369=\"            tmp = T * 9 / 5 + 32;\" line370=\"        }\" line371=\"        return Rnber(tmp , Trd);\" line372=\"    }\" line373=\"\" line374=\"    /**\" line375=\"     * Get humidity value from BME280 sensor / BME280 センサーから湿度を取得\" line376=\"     *\" line377=\"     * @param u Humidity unit % / 湿度の単位 %\" line378=\"     * @returns Temperature value / 湿度の値（小数第1位）\" line379=\"     */\" line380=\"    //% blockId=&quot;BME280_GET_HUMIDITY&quot;\" line381=\"    //% block=&quot;Humidity / 湿度 精度 %Hrd&quot;\" line382=\"    //% weight=80 blockGap=8\" line383=\"    export function humidity(Hrd:RPoint): number {\" line384=\"        get();\" line385=\"        return Rnber(H,Hrd);\" line386=\"    }\" line387=\"    //Sensor power control (Power ON and OFF)\" line388=\"    //センサーの電源管理（起動と停止）\" line389=\"    /**\" line390=\"     * power on / センサー起動\" line391=\"     */\" line392=\"    //% blockId=&quot;BME280_POWER_ON&quot; block=&quot;\" line393=\"    //% block=&quot;Power On Sensor /センサー起動&quot;&quot;\" line394=\"    //% weight=22 blockGap=8\" line395=\"    export function PowerOn() {\" line396=\"        setreg(0xF4, 0x2F)\" line397=\"    }\" line398=\"\" line399=\"    /**\" line400=\"     * power oFF　センサー停止\" line401=\"     */\" line402=\"    //% blockId=&quot;BME280_POWER_OFF&quot;\" line403=\"    //% block=&quot;Power OFF Sensor/センサー停止&quot;\" line404=\"    //% weight=21 blockGap=8\" line405=\"    export function PowerOff() {\" line406=\"        setreg(0xF4, 0)\" line407=\"    }\" line408=\"\" line409=\"    /**\" line410=\"     * Calculate Elevation difference /標高差の計算\" line411=\"     * Input the reference point pressure P0 into the block\" line412=\"     * Get the current pressure and temperature from the sensor.\" line413=\"     * 基準点の気圧P0をブロックに入力\" line414=\"     * 現在の気圧・気温はセンサ-から取得\" line415=\"     */\" line416=\"    //% block=&quot;Elevation difference(標高差) %ELU Pressure (reference point)(気圧(基準点)) %P0 %uP0&quot;\" line417=\"    //% blockId=&quot;Elevation_difference&quot;\" line418=\"    //% weight=80  blockGap=8\" line419=\"    export function getElevationdifference(Elu:Eldf,P0: number, uP0: BME280_P):number {\" line420=\"        get();\" line421=\"        // Eprs:Current Pressure / 現地点の気圧\" line422=\"        let Eprs = P    \" line423=\"         // Etemp:Current Temperatuer（kelvin） /　現地点の気温（絶対温度）\" line424=\"        let Etemp = T+273.15 //Celsius-&gt;kelvin　/ 摂氏－＞絶対温度\" line425=\"        // Unification of units /単位の統一\" line426=\"        // If the unit of the pressure P0 at the reference point is Pa, multiply P0 by 1. \" line427=\"        // If the unit is hPa, multiply P0 by 100.\" line428=\"        // 基準点の気圧P0の単位がPaならそのまま、hPaなら1/100\" line429=\"        // uP0:P-&gt;1 hPa-&gt;1/100\" line430=\"        Eprs = Eprs *1/uP0 \" line431=\"        // Calculate Elevation difference / 標高差計算\" line432=\"        // 0.0065-&gt; Tropospheric temperature lapse rate (0.65℃/100m) \" line433=\"        // 0.0065-&gt; 対流圏の気温減率（0.65℃/100ｍ）\" line434=\"        let rt=((P0/Eprs)**(1/5.257)-1)*Etemp\" line435=\"        //　Calculate Elevation difference / 標高差を算出 (Units/単位:m)\" line436=\"        let Diffelev=rt/0.0065\" line437=\"        // Convert values ​​according to altitude units /高度の単位に応じて数値を変換\" line438=\"        if(Elu==2){\" line439=\"            Diffelev=Diffelev*3.2808;}\" line440=\"         return Rnber(Diffelev,10);\" line441=\"    }\" line442=\"\" line443=\"    /**\" line444=\"     * Calculate Dewpoint　露点計算\" line445=\"     */\" line446=\"    //% block=&quot;Dewpoint / 露点&quot;\" line447=\"    //% weight=60 blockGap=8\" line448=\"    export function Dewpoint(Drd:RPoint): number {\" line449=\"        get();\" line450=\"        return T - Math.idiv(100 - H, 5)\" line451=\"    }\" line452=\"\" line453=\"    /**\" line454=\"     * Event Block\" line455=\"     * イベントブロック\" line456=\"    */\" line457=\"    /**\" line458=\"     * Triggered when pressure is Lower than a specified value. / 気圧が指定値より低い場合\" line459=\"     *\" line460=\"     * @param dat Threshold value / しきい値（Pa）\" line461=\"     * @param body Action to perform / 実行する処理\" line462=\"     */\" line463=\"    //% block=&quot;Pressuer / 気圧 &lt;  %dat&quot; dat.defl=100000\" line464=\"    export function PressureBelowThan(dat: number, body: () =&gt; void): void {\" line465=\"        control.inBackground(function () {\" line466=\"            while (true) {\" line467=\"                get()\" line468=\"                if (P &lt; dat) {\" line469=\"                    body()\" line470=\"                }\" line471=\"                basic.pause(1000)\" line472=\"            }\" line473=\"        })\" line474=\"    }\" line475=\"\" line476=\"    /**\" line477=\"     * Triggered when pressure is Higher than a specified value.\" line478=\"     * 気圧が指定値より高い場合\" line479=\"     * @param dat Threshold value / しきい値（Pa）\" line480=\"     * @param body Action to perform / 実行する処理\" line481=\"     */\" line482=\"    //% block=&quot;Pressuer / 気圧 &gt; %dat&quot; dat.defl=100000\" line483=\"    export function PressureHigherThan(dat: number, body: () =&gt; void): void {\" line484=\"        control.inBackground(function () {\" line485=\"            while (true) {\" line486=\"                get()\" line487=\"                if (P &gt; dat) {\" line488=\"                    body()\" line489=\"                }\" line490=\"                basic.pause(1000)\" line491=\"            }\" line492=\"        })\" line493=\"    }\" line494=\"\" line495=\"    /**\" line496=\"     * Triggered when temprature is Lower than a specified value. \" line497=\"     *  気温が指定値より低い場合\" line498=\"     *\" line499=\"     * @param dat Threshold value / しきい値（C）\" line500=\"     * @param body Action to perform / 実行する処理\" line501=\"     */\" line502=\"    //% block=&quot;Temperature / 気温 &lt; %dat&quot; dat.defl=10\" line503=\"    export function TemperatureBelowThan(dat: number, body: () =&gt; void): void {\" line504=\"        control.inBackground(function () {\" line505=\"            while (true) {\" line506=\"                get()\" line507=\"                if (T &lt; dat) {\" line508=\"                    body()\" line509=\"                }\" line510=\"                basic.pause(1000)\" line511=\"            }\" line512=\"        })\" line513=\"    }\" line514=\"\" line515=\"    /**\" line516=\"     * Triggered when tempratuere is Lower than a specified value.\" line517=\"     * 気温が指定値より低い場合\" line518=\"     *\" line519=\"     * @param dat Threshold value / しきい値（C）\" line520=\"     * @param body Action to perform / 実行する処理\" line521=\"     */\" line522=\"    //% block=&quot;Temperature / 気温 &gt; %dat&quot; dat.defl=30\" line523=\"    export function TemperatureHigherThan(dat: number, body: () =&gt; void): void {\" line524=\"        control.inBackground(function () {\" line525=\"            while (true) {\" line526=\"                get()\" line527=\"                if (T &gt; dat) {\" line528=\"                    body()\" line529=\"                }\" line530=\"                basic.pause(1000)\" line531=\"            }\" line532=\"        })\" line533=\"    }\" line534=\"\" line535=\"    /**\" line536=\"     * Triggered when humidity is Lower than a specified value. \" line537=\"     * 湿度が指定値より低い場合\" line538=\"     * @param dat Threshold value / しきい値（C）\" line539=\"     * @param body Action to perform / 実行する処理\" line540=\"     */\" line541=\"    //% block=&quot;Humidity / 湿度 &lt; %dat&quot; dat.defl=10\" line542=\"    export function HumidityBelowThan(dat: number, body: () =&gt; void): void {\" line543=\"        control.inBackground(function () {\" line544=\"            while (true) {\" line545=\"                get()\" line546=\"                if (H &lt; dat) {\" line547=\"                    body()\" line548=\"                }\" line549=\"                basic.pause(1000)\" line550=\"            }\" line551=\"        })\" line552=\"    }\" line553=\"\" line554=\"    /**\" line555=\"     * Triggered when humidity is Higher than a specified value. \" line556=\"     * 湿度が指定値より高い場合\" line557=\"     * @param dat Threshold value / しきい値（C）\" line558=\"     * @param body Action to perform / 実行する処理\" line559=\"     */\" line560=\"    //% block=&quot;Humidity / 湿度 &gt; %dat&quot; dat.defl=10\" line561=\"    export function HumidityHigherThan(dat: number, body: () =&gt; void): void {\" line562=\"        control.inBackground(function () {\" line563=\"            while (true) {\" line564=\"                get()\" line565=\"                if (H &gt; dat) {\" line566=\"                    body()\" line567=\"                }\" line568=\"                basic.pause(1000)\" line569=\"            }\" line570=\"        })\" line571=\"    }\" line572=\"\" line573=\"    /**\" line574=\"     * Set the I2C address of the BME280 sensor. / BME280 の I2C アドレスを設定\" line575=\"     * \" line576=\"     *  @param addr I2C address to set / 設定する I2C アドレス\" line577=\"     */\" line578=\"    //% blockId=&quot;BME280_SET_ADDRESS&quot;\" line579=\"    //% block=&quot;I2C Address/I2Cアドレス %addr&quot;\" line580=\"    //% weight=20 blockGap=8\" line581=\"    export function Address(addr: BME280_I2C_ADDRESS) {\" line582=\"        BME280_I2C_ADDR = addr\" line583=\"    }\" line584=\"}\" numlines=\"585\"></mutation></block></statement></block><"],[0,"/xml>"]],"start1":71,"start2":71,"length1":13,"length2":25443}]}]},{"timestamp":1746007603870,"editorVersion":"7.0.61","changes":[{"type":"edited","filename":"pxt.json","patch":[{"diffs":[[0," ],\n"],[-1,"    \"testFiles\": [\n        \"test.ts\"\n    ],\n"],[0,"    "]],"start1":225,"start2":225,"length1":52,"length2":8}]},{"type":"added","filename":"test.ts","value":"// テストはここに来ます。このパッケージが拡張機能として使用されるときにはコンパイルされません。\n"}]}],"snapshots":[{"timestamp":1745389379396,"editorVersion":"7.0.61","text":{"main.blocks":"<xml xmlns=\"http://www.w3.org/1999/xhtml\">\n  <block type=\"pxt-on-start\"></block>\n  <block type=\"device_forever\"></block>\n</xml>","main.ts":"\n","README.md":"","pxt.json":"{\n    \"name\": \"コードCHECK\",\n    \"description\": \"\",\n    \"dependencies\": {\n        \"core\": \"*\",\n        \"radio\": \"*\",\n        \"microphone\": \"*\"\n    },\n    \"files\": [\n        \"main.blocks\",\n        \"main.ts\",\n        \"README.md\"\n    ],\n    \"additionalFilePaths\": []\n}\n"}},{"timestamp":1745537536460,"editorVersion":"7.0.61","text":{"main.blocks":"<xml xmlns=\"https://developers.google.com/blockly/xml\"><variables></variables><block type=\"pxt-on-start\" x=\"0\" y=\"0\"><statement name=\"HANDLER\"><block type=\"typescript_statement\"><mutation xmlns=\"http://www.w3.org/1999/xhtml\" line0=\"namespace BME280 {\" line1=\"    //Enum Definitions / 列挙型の定義\" line2=\"    //I2C address/I2Cアドレス\" line3=\"    export enum BME280_I2C_ADDRESS {\" line4=\"        //% block=&quot;0x76&quot;\" line5=\"        ADDR_0x76 = 0x76,\" line6=\"        //% block=&quot;0x77&quot;\" line7=\"        ADDR_0x77 = 0x77\" line8=\"    }\" line9=\"\" line10=\"    //Temperature Unit / 気温の単位\" line11=\"    // Temperature units: C (Celsius) or F (Fahrenheit) / 温度単位：C（摂氏）または F（華氏）\" line12=\"    export enum BME280_T {\" line13=\"        //% block=&quot;C&quot;\" line14=\"        T_C = 0,\" line15=\"        //% block=&quot;F&quot;\" line16=\"        T_F = 1\" line17=\"    }\" line18=\"\" line19=\"    // Pressure Unit / 気圧の単位\" line20=\"    // Pressure units: Pa or hPa / 単位：Pa（パスカル）または hPa（ヘクトパスカル）\" line21=\"    export enum BME280_P {\" line22=\"        //% block=&quot;Pa&quot;\" line23=\"        Pa = 1,\" line24=\"        //% block=&quot;hPa&quot;\" line25=\"        hPa = 100\" line26=\"    }\" line27=\"    // Numerical precision\" line28=\"    // 数値の精度\" line29=\"    // Integer / 1　decimal place / 2 decimal place\" line30=\"    // 整数 / 小数第1位 / 小数第2位\" line31=\"    export enum RPoint {\" line32=\"        //% block=&quot;Integer/整数&quot;\" line33=\"            Rint=1,\" line34=\"        //% block=&quot;1 demicl place / 小数第1位&quot;\" line35=\"            RPt=10,\" line36=\"        //% block=&quot;2 demicl place / 小数第2位&quot;\" line37=\"            RPt2=100\" line38=\"    }\" line39=\"        \" line40=\"    /**\" line41=\"     * Global variables to store the final compensated\" line42=\"     * temperature, pressure and humidity \" line43=\"     * temperature&#9;: unit  °C\" line44=\"     * pressuere&#9;: unit Pa\" line45=\"     * humidity&#9;&#9;: unit %\" line46=\"     * \" line47=\"     * グローバル変数：補正後の気温・気圧・湿度\" line48=\"     * 単位　気温：℃　気圧：Pa　湿度：％\" line49=\"     */\" line50=\"    let T = 0;\" line51=\"    let P = 0;\" line52=\"    let H = 0;\" line53=\"\" line54=\"    // Default I2C address: 0x77 / デフォルトの I2C アドレス：0x77\" line55=\"    let BME280_I2C_ADDR = BME280_I2C_ADDRESS.ADDR_0x76\" line56=\"\" line57=\"    // Defining Functions / 関数の定義\" line58=\"    /** \" line59=\"     * Functions &quot;Access to BME280 Registers&quot;\" line60=\"     * BME280のレジスタへのアクセスを行う関数群\" line61=\"     * A set of functions for reading from and writing to BME280\" line62=\"     * registers via I2C communication.\" line63=\"     * I2C 通信を用いて、各種レジスタへの読み書きを行う\" line64=\"     */\" line65=\"\" line66=\"    /**\" line67=\"     * Function &quot;Writes 1 byte from a register of the BME280&quot;.\" line68=\"     * BME280のレジスタに1バイトのデータを書き込む関数\" line69=\"     *\" line70=\"     * @param reg Register address (integer) / レジストリアドレス（整数値）\" line71=\"     * @returns dat write (integer) / 書き込んだ値（整数値）\" line72=\"     * @returns None/戻り値はない\" line73=\"     *\" line74=\"     * Creates a 2-byte buffer: the first byte is the register address (buf[0]),\" line75=\"     * the second byte is the data to write (buf[1]), and sends it via I2C.\" line76=\"     * レジスタアドレス（buf[0]）と書き込むデータ（buf[1]）を格納した2バイトのバッファを作成し、\" line77=\"     * I2C を使ってデバイスに送信する。\" line78=\"     */\" line79=\"    function setreg(reg: number, dat: number): void {\" line80=\"        let buf = pins.createBuffer(2);\" line81=\"        buf[0] = reg;\" line82=\"        buf[1] = dat;\" line83=\"        pins.i2cWriteBuffer(BME280_I2C_ADDR, buf);\" line84=\"    }\" line85=\"\" line86=\"    /**\" line87=\"     * Function &quot;Reads 1 byte from a register of the BME280&quot;.\" line88=\"     * BME280の任意のレジスタから 1 バイトの値を読み取る関数。\" line89=\"     *\" line90=\"     * @param reg Register address (integer) / レジストリアドレス（整数値）\" line91=\"     * @returns Value read (integer) / 読み取った値（整数値）\" line92=\"     *\" line93=\"     * Sends the register address via I2C using UInt8BE format,\" line94=\"     * then reads 1 byte from the device.\" line95=\"     * レジストリアドレスを UInt8BE 形式で送信し、1 バイトを読み取って返します。\" line96=\"     */\" line97=\"    function getreg(reg: number): number {\" line98=\"        pins.i2cWriteNumber(BME280_I2C_ADDR, reg, NumberFormat.UInt8BE);\" line99=\"        return pins.i2cReadNumber(BME280_I2C_ADDR, NumberFormat.UInt8BE);\" line100=\"    }\" line101=\"\" line102=\"    /**\" line103=\"     * Function &quot;Reads a 16-bit unsigned integer&quot;.\" line104=\"     * 8 ビットの符号付き整数を読み取る関数。\" line105=\"     *\" line106=\"     * Used for calibration parameters such as dig_H6..\" line107=\"     * 補正パラメータ dig_H6 に使用。\" line108=\"     *\" line109=\"     * @param reg Register address / レジストリアドレス\" line110=\"     * @returns Unsigned 8-bit integer / 符号付き8ビット整数\" line111=\"       */\" line112=\"    function getInt8LE(reg: number): number {\" line113=\"        pins.i2cWriteNumber(BME280_I2C_ADDR, reg, NumberFormat.UInt8BE);\" line114=\"        return pins.i2cReadNumber(BME280_I2C_ADDR, NumberFormat.Int8LE);\" line115=\"    }\" line116=\"\" line117=\"    /**\" line118=\"     * Function &quot;Reads a 16-bit unsigned integer&quot;.\" line119=\"     * 16 ビットの符号なし整数を読み取る関数。\" line120=\"     *\" line121=\"     * Used for calibration parameters such as dig_T1, dig_P1, etc.\" line122=\"     * dig_T1、dig_P1 などの補正パラメータ用に使用します。\" line123=\"     *\" line124=\"     * @param reg Register address / レジストリアドレス\" line125=\"     * @returns Unsigned 16-bit integer / 符号なし 16 ビット整数\" line126=\"       */\" line127=\"    function getUInt16LE(reg: number): number {\" line128=\"        pins.i2cWriteNumber(BME280_I2C_ADDR, reg, NumberFormat.UInt8BE);\" line129=\"        return pins.i2cReadNumber(BME280_I2C_ADDR, NumberFormat.UInt16LE);\" line130=\"    }\" line131=\"\" line132=\"    /**\" line133=\"       * Function &quot;Reads a 16-bit signed integer&quot;.\" line134=\"       * 16 ビットの符号付き整数を読み取る関数。\" line135=\"       * \" line136=\"       * Used for calibration parameters such as dig_T2, dig_T3, dig_P2.\" line137=\"       * dig_T2、dig_T3、dig_P2 などの補正パラメータ用に使用します。\" line138=\"     *\" line139=\"       * @param reg Register address / レジストリアドレス\" line140=\"       * @returns Signed 16-bit integer / 符号付き 16 ビット整数\" line141=\"       */\" line142=\"    function getInt16LE(reg: number): number {\" line143=\"        pins.i2cWriteNumber(BME280_I2C_ADDR, reg, NumberFormat.UInt8BE);\" line144=\"        return pins.i2cReadNumber(BME280_I2C_ADDR, NumberFormat.Int16LE);\" line145=\"    }\" line146=\"\" line147=\"    // Rounding numbers/数値の四捨五入\" line148=\"    // Integer/demicl 1 place /demicl 2 place\" line149=\"    // 整数 / 小数第1位 / 小数第２位\" line150=\"    export function Rnber(dt:number,Rdp:number): number {\" line151=\"        return Math.round(dt*Rdp)/Rdp\" line152=\"    }\" line153=\"\" line154=\"    // Function &quot;Get Tempratuer , Pressuer and humidity&quot;.\" line155=\"    // 気温・気圧・湿度取得の関数\" line156=\"    /**\" line157=\"         * BME280 calibration parameters for temperature, pressure and humidity.\" line158=\"         * BME280 の温度・気圧・湿度補正用キャリブレーションパラメータ。\" line159=\"     * \" line160=\"         * Address range: 0x88 to 0xE7 (factory-programmed values)\" line161=\"         * アドレス範囲：0x88 ～ 0xE7（工場出荷時に書き込まれた補正値）\" line162=\"         * \" line163=\"         * Common to BMP280 &amp; BME280 sensors\" line164=\"     * (excluding humidity-related registers 0xA1 to 0xE7)\" line165=\"         * BMP280・BME280 センサーで共通\" line166=\"     *（湿度関連のレジスタ 0xA1 ～ 0xE7は除く）\" line167=\"         */\" line168=\"    /**\" line169=\"         * Set &quot;BME280 calibration parameter registers&quot;\" line170=\"     * BME280温度・気圧・湿度補正用キャリブレーションパラメータのレジストリ　\" line171=\"           * dig_T1 to dig_T3: temperature/気温補正\" line172=\"     * dig_P1 to dig_P9: pressuere/気圧補正\" line173=\"     * dig_H1 to dig_H6: humidity/湿度補正\" line174=\"     */\" line175=\"    // Temperature calibration parameters / 気温補正用パラメータ\" line176=\"    let dig_T1 = getUInt16LE(0x88)\" line177=\"    let dig_T2 = getInt16LE(0x8A)\" line178=\"    let dig_T3 = getInt16LE(0x8C)\" line179=\"\" line180=\"    // Pressure calibration parameters / 気圧補正用パラメータ\" line181=\"    let dig_P1 = getUInt16LE(0x8E)\" line182=\"    let dig_P2 = getInt16LE(0x90)\" line183=\"    let dig_P3 = getInt16LE(0x92)\" line184=\"    let dig_P4 = getInt16LE(0x94)\" line185=\"    let dig_P5 = getInt16LE(0x96)\" line186=\"    let dig_P6 = getInt16LE(0x98)\" line187=\"    let dig_P7 = getInt16LE(0x9A)\" line188=\"    let dig_P8 = getInt16LE(0x9C)\" line189=\"    let dig_P9 = getInt16LE(0x9E)\" line190=\"\" line191=\"    // Humidity calibration parameters / 湿度補正用パラメータ   &#9;&#9;\" line192=\"    let dig_H1 = getreg(0xA1)\" line193=\"    let dig_H2 = getInt16LE(0xE1)\" line194=\"    let dig_H3 = getreg(0xE3)\" line195=\"    let a = getreg(0xE5)\" line196=\"    let dig_H4 = (getreg(0xE4) &lt;&lt; 4) + (a % 16)\" line197=\"    let dig_H5 = (getreg(0xE6) &lt;&lt; 4) + (a &gt;&gt; 4)\" line198=\"    let dig_H6 = getInt8LE(0xE7)\" line199=\"\" line200=\"    /**\" line201=\"         * Sensor configuration:\" line202=\"         * - Set humidity oversampling to x4 (ctrl_hum, 0xF2)\" line203=\"         * - Set temperature oversampling to x16, pressure oversampling to x1, normal mode (ctrl_meas, 0xF4)\" line204=\"         * - Set standby time to 250ms and filter coefficient to x4 (config, 0xF5)\" line205=\"         *\" line206=\"         * センサーの設定：\" line207=\"         * - 湿度のオーバーサンプリングを4倍に設定（ctrl_hum、0xF2）\" line208=\"         * - 温度のオーバーサンプリングを16倍、気圧を1倍、動作モードをノーマルに設定（ctrl_meas、0xF4）\" line209=\"         * - スタンバイ時間を250ms、フィルター係数を4倍に設定（config、0xF5）\" line210=\"         */\" line211=\"    setreg(0xF2, 0x04)\" line212=\"    setreg(0xF4, 0x2F)\" line213=\"    setreg(0xF5, 0x0C)\" line214=\"\" line215=\"    /**\" line216=\"     * Calculate Temperatuer , Pressure and Humidity\" line217=\"         * 気温・気圧・湿度の算出\" line218=\"         * Reads raw data from the sensor and calculates\" line219=\"     * corrected temperature , pressure and humidity.\" line220=\"         * センサーから生データを読み取り、\" line221=\"     * 補正済みの気温・気圧・湿度を算出。\" line222=\"         */\" line223=\"    function get(): void {\" line224=\"        // Calculate Temperatuer/気温の計算\" line225=\"        // Read raw temperature data (20 bits)\" line226=\"        // 温度の生データ（20ビット）読み取り\" line227=\"        let adc_T = (getreg(0xFA) &lt;&lt; 12) + (getreg(0xFB) &lt;&lt; 4) + (getreg(0xFC) &gt;&gt; 4)\" line228=\"        let var1 = (((adc_T &gt;&gt; 3) - (dig_T1 &lt;&lt; 1)) * dig_T2) &gt;&gt; 11\" line229=\"        let var2 = (((((adc_T &gt;&gt; 4) - dig_T1) * ((adc_T &gt;&gt; 4) - dig_T1)) &gt;&gt; 12) * dig_T3) &gt;&gt; 14\" line230=\"        let t_fine = var1 + var2;\" line231=\"        let temp = t_fine;\" line232=\"        // Calculate corrected temperature(no rounding)\" line233=\"        // 補正後の気温を計算（数値の丸めなし）\" line234=\"        T = ((temp * 5 + 128) / 256.0) / 100.0 ;\" line235=\"\" line236=\"        // Calculate Pressure/気圧の計算\" line237=\"        // Read raw pressure data (20 bits)\" line238=\"        // 気圧の生データ（20ビット）読み取り\" line239=\"        let adc_P = (getreg(0xF7) &lt;&lt; 12) + (getreg(0xF8) &lt;&lt; 4) + (getreg(0xF9) &gt;&gt; 4);\" line240=\"\" line241=\"        // Pressure compensation calculation\" line242=\"        // 気圧補正の計算\" line243=\"        var1 = (t_fine &gt;&gt; 1) - 64000;\" line244=\"        var2 = (((var1 &gt;&gt; 2) * (var1 &gt;&gt; 2)) &gt;&gt; 11) * dig_P6;\" line245=\"        var2 = var2 + ((var1 * dig_P5) &lt;&lt; 1);\" line246=\"        var2 = (var2 &gt;&gt; 2) + (dig_P4 &lt;&lt; 16);\" line247=\"        var1 = (((dig_P3 * ((var1 &gt;&gt; 2) * (var1 &gt;&gt; 2)) &gt;&gt; 13) &gt;&gt; 3) + ((dig_P2 * var1) &gt;&gt; 1)) &gt;&gt; 18;\" line248=\"        var1 = ((32768 + var1) * dig_P1) &gt;&gt; 15;\" line249=\"        if (var1 == 0) {\" line250=\"            return; // Prevent division by zero / 0除算防止\" line251=\"        }\" line252=\"        let _p = ((1048576 - adc_P) - (var2 &gt;&gt; 12)) * 3125;\" line253=\"\" line254=\"        // Calculate Pressure (no rounding)/気圧を算出（数値の丸めなし）\" line255=\"        _p = (_p / var1) * 2 ;\" line256=\"        var1 = (dig_P9 * (((_p &gt;&gt; 3) * (_p &gt;&gt; 3)) &gt;&gt; 13)) &gt;&gt; 12;\" line257=\"        var2 = (((_p &gt;&gt; 2)) * dig_P8) &gt;&gt; 13;\" line258=\"        P = _p + ((var1 + var2 + dig_P7) &gt;&gt; 4);\" line259=\"\" line260=\"        // Calculate Humidity/&#9;湿度の計算\" line261=\"        // Read raw pressure data (16 bits)\" line262=\"        // 湿度の生データ（16ビット）読み取り\" line263=\"        let adc_H = (getreg(0xFD) &lt;&lt; 8) + getreg(0xFE)\" line264=\"        var1 = t_fine - 76800\" line265=\"        var2 = (((adc_H &lt;&lt; 14) - (dig_H4 &lt;&lt; 20) - (dig_H5 * var1)) + 16384) &gt;&gt; 15\" line266=\"        var1 = var2 * (((((((var1 * dig_H6) &gt;&gt; 10) * (((var1 * dig_H3) &gt;&gt; 11) + 32768)) &gt;&gt; 10) + 2097152) * dig_H2 + 8192) &gt;&gt; 14)\" line267=\"        var2 = var1 - (((((var1 &gt;&gt; 15) * (var1 &gt;&gt; 15)) &gt;&gt; 7) * dig_H1) &gt;&gt; 4)\" line268=\"        if (var2 &lt; 0) var2 = 0\" line269=\"        if (var2 &gt; 419430400) var2 = 419430400\" line270=\"        // Calculate Humidity (no rounding)/湿度を算出（数値の丸めなし）\" line271=\"        H = var2 / 4194304.0\" line272=\"    }\" line273=\"    //\" line274=\"    /**\" line275=\"     *  Get pressure value from BME280 sensor/BME280 センサーから気圧を取得\" line276=\"         *   \" line277=\"         *  @param u Pressure unit (Pa or hPa) / 気圧の単位（Pa または hPa）\" line278=\"         *  @returns Pressure value / 気圧の値（単位に応じた小数第1位）\" line279=\"         */\" line280=\"    //% blockId=&quot;BME280_GET_PRESSURE&quot;\" line281=\"    //% block=&quot;Pressuer / 気圧 %Pu　Accuracy / 精度 %Prd&quot;\" line282=\"    //% weight=80 blockGap=8\" line283=\"    export function pressure(Pu: BME280_P,Prd: RPoint): number {\" line284=\"        get();\" line285=\"        return Rnber(P/Pu,Prd)\" line286=\"    }\" line287=\"\" line288=\"    /**\" line289=\"     * Get temperature value from BME280 sensor/ BME280 センサーから気温を取得します\" line290=\"         *\" line291=\"         * @param u Temperature unit (C or F) / 温度の単位（C または F）\" line292=\"         * @returns Temperature value / 気温の値（単位に応じた小数第1位）\" line293=\"         */\" line294=\"    //% blockId=&quot;BME280_GET_TEMPERATURE&quot;\" line295=\"    //% block=&quot;Tempratuere /気温 %Tu Accuracy / 精度 %Trd&quot;\" line296=\"    //% weight=80 blockGap=8\" line297=\"    export function temperature(Tu: BME280_T, Trd: RPoint): number {\" line298=\"        get();\" line299=\"        let tmp=T\" line300=\"        if (Tu == BME280_T.T_F) { \" line301=\"            //Fahrenheit degree/華氏&#9;\" line302=\"            tmp = T * 9 / 5 + 32;\" line303=\"        }\" line304=\"        return Rnber(tmp , Trd)\" line305=\"    }\" line306=\"\" line307=\"    /**\" line308=\"     * Get humidity value from BME280 sensor / BME280 センサーから湿度を取得します\" line309=\"         *\" line310=\"         * @param u Humidity unit % / 湿度の単位 %\" line311=\"         * @returns Temperature value / 湿度の値（小数第1位）\" line312=\"         */\" line313=\"    //% blockId=&quot;BME280_GET_HUMIDITY&quot;\" line314=\"    //% block=&quot;Humidity / 湿度 精度 %Hrd&quot;\" line315=\"    //% weight=80 blockGap=8\" line316=\"    export function humidity(Hrd:RPoint): number {\" line317=\"        get();\" line318=\"        return Rnber(H,Hrd);\" line319=\"    }\" line320=\"    //Sensor power control (Power ON and OFF)\" line321=\"    //センサーの電源管理（起動と停止）\" line322=\"    /**\" line323=\"     * power on / センサー起動\" line324=\"       */\" line325=\"    //% blockId=&quot;BME280_POWER_ON&quot; block=&quot;\" line326=\"    //% block=&quot;Power On Sensor /センサー起動&quot;&quot;\" line327=\"    //% weight=22 blockGap=8\" line328=\"    export function PowerOn() {\" line329=\"        setreg(0xF4, 0x2F)\" line330=\"    }\" line331=\"\" line332=\"    /**\" line333=\"     * power oFF　センサー停止\" line334=\"       */\" line335=\"    //% blockId=&quot;BME280_POWER_OFF&quot;\" line336=\"    //% block=&quot;Power OFF Sensor/センサー停止&quot;\" line337=\"    //% weight=21 blockGap=8\" line338=\"    export function PowerOff() {\" line339=\"        setreg(0xF4, 0)\" line340=\"    }\" line341=\"\" line342=\"    /**\" line343=\"     * Calculate Dewpoint　露点計算\" line344=\"     */\" line345=\"    //% block=&quot;Dewpoint / 露点&quot;\" line346=\"    //% weight=60 blockGap=8\" line347=\"    export function Dewpoint(Drd:RPoint): number {\" line348=\"        get();\" line349=\"        return T - Math.idiv(100 - H, 5)\" line350=\"    }\" line351=\"\" line352=\"    /**\" line353=\"     * Event Block\" line354=\"     * イベントブロック\" line355=\"     */\" line356=\"    /**\" line357=\"        * Triggered when pressure is Lower than a specified value. / 気圧が指定値より低い場合\" line358=\"        *\" line359=\"        * @param dat Threshold value / しきい値（Pa）\" line360=\"        * @param body Action to perform / 実行する処理\" line361=\"        */\" line362=\"    //% block=&quot;Pressuer / 気圧 &lt;  %dat&quot; dat.defl=100000\" line363=\"    export function PressureBelowThan(dat: number, body: () =&gt; void): void {\" line364=\"        control.inBackground(function () {\" line365=\"            while (true) {\" line366=\"                get()\" line367=\"                if (P &lt; dat) {\" line368=\"                    body()\" line369=\"                }\" line370=\"                basic.pause(1000)\" line371=\"            }\" line372=\"        })\" line373=\"    }\" line374=\"\" line375=\"    /**\" line376=\"         * Triggered when pressure is Higher than a specified value. / 気圧が指定値より高い場合\" line377=\"         *\" line378=\"         * @param dat Threshold value / しきい値（Pa）\" line379=\"         * @param body Action to perform / 実行する処理\" line380=\"         */\" line381=\"    //% block=&quot;Pressuer / 気圧 &gt; %dat&quot; dat.defl=100000\" line382=\"    export function PressureHigherThan(dat: number, body: () =&gt; void): void {\" line383=\"        control.inBackground(function () {\" line384=\"            while (true) {\" line385=\"                get()\" line386=\"                if (P &gt; dat) {\" line387=\"                    body()\" line388=\"                }\" line389=\"                basic.pause(1000)\" line390=\"            }\" line391=\"        })\" line392=\"    }\" line393=\"\" line394=\"    /**\" line395=\"        * Triggered when temprature is Lower than a specified value. / 気温が指定値より低い場合\" line396=\"        *\" line397=\"        * @param dat Threshold value / しきい値（C）\" line398=\"        * @param body Action to perform / 実行する処理\" line399=\"        */\" line400=\"    //% block=&quot;Temperature / 気温 &lt; %dat&quot; dat.defl=10\" line401=\"    export function TemperatureBelowThan(dat: number, body: () =&gt; void): void {\" line402=\"        control.inBackground(function () {\" line403=\"            while (true) {\" line404=\"                get()\" line405=\"                if (T &lt; dat) {\" line406=\"                    body()\" line407=\"                }\" line408=\"                basic.pause(1000)\" line409=\"            }\" line410=\"        })\" line411=\"    }\" line412=\"\" line413=\"    /**\" line414=\"      * Triggered when tempratuere is Lower than a specified value. / 気温が指定値より低い場合\" line415=\"        *\" line416=\"        * @param dat Threshold value / しきい値（C）\" line417=\"        * @param body Action to perform / 実行する処理\" line418=\"        */\" line419=\"    //% block=&quot;Temperature / 気温 &gt; %dat&quot; dat.defl=30\" line420=\"    export function TemperatureHigherThan(dat: number, body: () =&gt; void): void {\" line421=\"        control.inBackground(function () {\" line422=\"            while (true) {\" line423=\"                get()\" line424=\"                if (T &gt; dat) {\" line425=\"                    body()\" line426=\"                }\" line427=\"                basic.pause(1000)\" line428=\"            }\" line429=\"        })\" line430=\"    }\" line431=\"\" line432=\"    /**\" line433=\"      * Triggered when humidity is Lower than a specified value. /  湿度が指定値より低い場合\" line434=\"        *\" line435=\"        * @param dat Threshold value / しきい値（C）\" line436=\"        * @param body Action to perform / 実行する処理\" line437=\"        */\" line438=\"    //% block=&quot;Humidity / 湿度 &lt; %dat&quot; dat.defl=10\" line439=\"    export function HumidityBelowThan(dat: number, body: () =&gt; void): void {\" line440=\"        control.inBackground(function () {\" line441=\"            while (true) {\" line442=\"                get()\" line443=\"                if (H &lt; dat) {\" line444=\"                    body()\" line445=\"                }\" line446=\"                basic.pause(1000)\" line447=\"            }\" line448=\"        })\" line449=\"    }\" line450=\"\" line451=\"    /**\" line452=\"  * Triggered when humidity is Higher than a specified value. / 湿度が指定値より高い場合\" line453=\"      *\" line454=\"      * @param dat Threshold value / しきい値（C）\" line455=\"      * @param body Action to perform / 実行する処理\" line456=\"      */\" line457=\"    //% block=&quot;Humidity / 湿度 &gt; %dat&quot; dat.defl=10\" line458=\"    export function HumidityHigherThan(dat: number, body: () =&gt; void): void {\" line459=\"        control.inBackground(function () {\" line460=\"            while (true) {\" line461=\"                get()\" line462=\"                if (H &gt; dat) {\" line463=\"                    body()\" line464=\"                }\" line465=\"                basic.pause(1000)\" line466=\"            }\" line467=\"        })\" line468=\"    }\" line469=\"\" line470=\"    /**\" line471=\"         * Set the I2C address of the BME280 sensor. / BME280 の I2C アドレスを設定\" line472=\"         * \" line473=\"         *  @param addr I2C address to set / 設定する I2C アドレス\" line474=\"         */\" line475=\"    //% blockId=&quot;BME280_SET_ADDRESS&quot;\" line476=\"    //% block=&quot;I2C Address/I2Cアドレス %addr&quot;\" line477=\"    //% weight=20 blockGap=8\" line478=\"    export function Address(addr: BME280_I2C_ADDRESS) {\" line479=\"        BME280_I2C_ADDR = addr\" line480=\"    }\" line481=\"}\" numlines=\"482\"></mutation></block></statement></block></xml>","main.ts":"namespace BME280 {\n    //Enum Definitions / 列挙型の定義\n    //I2C address/I2Cアドレス\n    export enum BME280_I2C_ADDRESS {\n        //% block=\"0x76\"\n        ADDR_0x76 = 0x76,\n        //% block=\"0x77\"\n        ADDR_0x77 = 0x77\n    }\n\n    //Temperature Unit / 気温の単位\n    // Temperature units: C (Celsius) or F (Fahrenheit) / 温度単位：C（摂氏）または F（華氏）\n    export enum BME280_T {\n        //% block=\"C\"\n        T_C = 0,\n        //% block=\"F\"\n        T_F = 1\n    }\n\n    // Pressure Unit / 気圧の単位\n    // Pressure units: Pa or hPa / 単位：Pa（パスカル）または hPa（ヘクトパスカル）\n    export enum BME280_P {\n        //% block=\"Pa\"\n        Pa = 1,\n        //% block=\"hPa\"\n        hPa = 100\n    }\n\n    // Unit of Elevation difference / 標高差の単位（m/ft）\n    export enum altd {\n        //Units meter/単位 メートル\n        //% block=\"m\"\n            altd_m=\"1\",\n        //Units feet/単位 フィート\n        //% block=\"ft\"\n            altd_f=\"2\"\n    }\n   \n    // Numerical precision\n    // 数値の精度\n    // Integer / 1　decimal place / 2 decimal place\n    // 整数 / 小数第1位 / 小数第2位\n    export enum RPoint {\n        //% block=\"Integer/整数\"\n            Rint=1,\n        //% block=\"1 demicl place / 小数第1位\"\n            RPt=10,\n        //% block=\"2 demicl place / 小数第2位\"\n            RPt2=100\n    }\n        \n    /**\n     * Global variables to store the final compensated\n     * temperature, pressure and humidity \n     * temperature\t: unit  °C\n     * pressuere\t: unit Pa\n     * humidity\t\t: unit %\n     * \n     * グローバル変数：補正後の気温・気圧・湿度\n     * 単位　気温：℃　気圧：Pa　湿度：％\n     */\n    let T = 0;\n    let P = 0;\n    let H = 0;\n\n    // Default I2C address: 0x77 / デフォルトの I2C アドレス：0x77\n    let BME280_I2C_ADDR = BME280_I2C_ADDRESS.ADDR_0x76\n\n    // Defining Functions / 関数の定義\n    /** \n     * Functions \"Access to BME280 Registers\"\n     * BME280のレジスタへのアクセスを行う関数群\n     * A set of functions for reading from and writing to BME280\n     * registers via I2C communication.\n     * I2C 通信を用いて、各種レジスタへの読み書きを行う\n     */\n\n    /**\n     * Function \"Writes 1 byte from a register of the BME280\".\n     * BME280のレジスタに1バイトのデータを書き込む関数\n     *\n     * @param reg Register address (integer) / レジストリアドレス（整数値）\n     * @returns dat write (integer) / 書き込んだ値（整数値）\n     * @returns None/戻り値はない\n     *\n     * Creates a 2-byte buffer: the first byte is the register address (buf[0]),\n     * the second byte is the data to write (buf[1]), and sends it via I2C.\n     * レジスタアドレス（buf[0]）と書き込むデータ（buf[1]）を格納した2バイトのバッファを作成し、\n     * I2C を使ってデバイスに送信する。\n     */\n    function setreg(reg: number, dat: number): void {\n        let buf = pins.createBuffer(2);\n        buf[0] = reg;\n        buf[1] = dat;\n        pins.i2cWriteBuffer(BME280_I2C_ADDR, buf);\n    }\n\n    /**\n     * Function \"Reads 1 byte from a register of the BME280\".\n     * BME280の任意のレジスタから 1 バイトの値を読み取る関数。\n     *\n     * @param reg Register address (integer) / レジストリアドレス（整数値）\n     * @returns Value read (integer) / 読み取った値（整数値）\n     *\n     * Sends the register address via I2C using UInt8BE format,\n     * then reads 1 byte from the device.\n     * レジストリアドレスを UInt8BE 形式で送信し、1 バイトを読み取って返します。\n     */\n    function getreg(reg: number): number {\n        pins.i2cWriteNumber(BME280_I2C_ADDR, reg, NumberFormat.UInt8BE);\n        return pins.i2cReadNumber(BME280_I2C_ADDR, NumberFormat.UInt8BE);\n    }\n\n    /**\n     * Function \"Reads a 16-bit unsigned integer\".\n     * 8 ビットの符号付き整数を読み取る関数。\n     *\n     * Used for calibration parameters such as dig_H6..\n     * 補正パラメータ dig_H6 に使用。\n     *\n     * @param reg Register address / レジストリアドレス\n     * @returns Unsigned 8-bit integer / 符号付き8ビット整数\n       */\n    function getInt8LE(reg: number): number {\n        pins.i2cWriteNumber(BME280_I2C_ADDR, reg, NumberFormat.UInt8BE);\n        return pins.i2cReadNumber(BME280_I2C_ADDR, NumberFormat.Int8LE);\n    }\n\n    /**\n     * Function \"Reads a 16-bit unsigned integer\".\n     * 16 ビットの符号なし整数を読み取る関数。\n     *\n     * Used for calibration parameters such as dig_T1, dig_P1, etc.\n     * dig_T1、dig_P1 などの補正パラメータ用に使用します。\n     *\n     * @param reg Register address / レジストリアドレス\n     * @returns Unsigned 16-bit integer / 符号なし 16 ビット整数\n       */\n    function getUInt16LE(reg: number): number {\n        pins.i2cWriteNumber(BME280_I2C_ADDR, reg, NumberFormat.UInt8BE);\n        return pins.i2cReadNumber(BME280_I2C_ADDR, NumberFormat.UInt16LE);\n    }\n\n    /**\n       * Function \"Reads a 16-bit signed integer\".\n       * 16 ビットの符号付き整数を読み取る関数。\n       * \n       * Used for calibration parameters such as dig_T2, dig_T3, dig_P2.\n       * dig_T2、dig_T3、dig_P2 などの補正パラメータ用に使用します。\n     *\n       * @param reg Register address / レジストリアドレス\n       * @returns Signed 16-bit integer / 符号付き 16 ビット整数\n       */\n    function getInt16LE(reg: number): number {\n        pins.i2cWriteNumber(BME280_I2C_ADDR, reg, NumberFormat.UInt8BE);\n        return pins.i2cReadNumber(BME280_I2C_ADDR, NumberFormat.Int16LE);\n    }\n\n    // Rounding numbers/数値の四捨五入\n    // Integer/demicl 1 place /demicl 2 place\n    // 整数 / 小数第1位 / 小数第２位\n    export function Rnber(dt:number,Rdp:number): number {\n        return Math.round(dt*Rdp)/Rdp\n    }\n\n    // Function \"Get Tempratuer , Pressuer and humidity\".\n    // 気温・気圧・湿度取得の関数\n    /**\n         * BME280 calibration parameters for temperature, pressure and humidity.\n         * BME280 の温度・気圧・湿度補正用キャリブレーションパラメータ。\n     * \n         * Address range: 0x88 to 0xE7 (factory-programmed values)\n         * アドレス範囲：0x88 ～ 0xE7（工場出荷時に書き込まれた補正値）\n         * \n         * Common to BMP280 & BME280 sensors\n     * (excluding humidity-related registers 0xA1 to 0xE7)\n         * BMP280・BME280 センサーで共通\n     *（湿度関連のレジスタ 0xA1 ～ 0xE7は除く）\n         */\n    /**\n         * Set \"BME280 calibration parameter registers\"\n     * BME280温度・気圧・湿度補正用キャリブレーションパラメータのレジストリ　\n           * dig_T1 to dig_T3: temperature/気温補正\n     * dig_P1 to dig_P9: pressuere/気圧補正\n     * dig_H1 to dig_H6: humidity/湿度補正\n     */\n    // Temperature calibration parameters / 気温補正用パラメータ\n    let dig_T1 = getUInt16LE(0x88)\n    let dig_T2 = getInt16LE(0x8A)\n    let dig_T3 = getInt16LE(0x8C)\n\n    // Pressure calibration parameters / 気圧補正用パラメータ\n    let dig_P1 = getUInt16LE(0x8E)\n    let dig_P2 = getInt16LE(0x90)\n    let dig_P3 = getInt16LE(0x92)\n    let dig_P4 = getInt16LE(0x94)\n    let dig_P5 = getInt16LE(0x96)\n    let dig_P6 = getInt16LE(0x98)\n    let dig_P7 = getInt16LE(0x9A)\n    let dig_P8 = getInt16LE(0x9C)\n    let dig_P9 = getInt16LE(0x9E)\n\n    // Humidity calibration parameters / 湿度補正用パラメータ   \t\t\n    let dig_H1 = getreg(0xA1)\n    let dig_H2 = getInt16LE(0xE1)\n    let dig_H3 = getreg(0xE3)\n    let a = getreg(0xE5)\n    let dig_H4 = (getreg(0xE4) << 4) + (a % 16)\n    let dig_H5 = (getreg(0xE6) << 4) + (a >> 4)\n    let dig_H6 = getInt8LE(0xE7)\n\n    /**\n         * Sensor configuration:\n         * - Set humidity oversampling to x4 (ctrl_hum, 0xF2)\n         * - Set temperature oversampling to x16, pressure oversampling to x1, normal mode (ctrl_meas, 0xF4)\n         * - Set standby time to 250ms and filter coefficient to x4 (config, 0xF5)\n         *\n         * センサーの設定：\n         * - 湿度のオーバーサンプリングを4倍に設定（ctrl_hum、0xF2）\n         * - 温度のオーバーサンプリングを16倍、気圧を1倍、動作モードをノーマルに設定（ctrl_meas、0xF4）\n         * - スタンバイ時間を250ms、フィルター係数を4倍に設定（config、0xF5）\n         */\n    setreg(0xF2, 0x04)\n    setreg(0xF4, 0x2F)\n    setreg(0xF5, 0x0C)\n\n    /**\n     * Calculate Temperatuer , Pressure and Humidity\n         * 気温・気圧・湿度の算出\n         * Reads raw data from the sensor and calculates\n     * corrected temperature , pressure and humidity.\n         * センサーから生データを読み取り、\n     * 補正済みの気温・気圧・湿度を算出。\n         */\n    function get(): void {\n        // Calculate Temperatuer/気温の計算\n        // Read raw temperature data (20 bits)\n        // 温度の生データ（20ビット）読み取り\n        let adc_T = (getreg(0xFA) << 12) + (getreg(0xFB) << 4) + (getreg(0xFC) >> 4)\n        let var1 = (((adc_T >> 3) - (dig_T1 << 1)) * dig_T2) >> 11\n        let var2 = (((((adc_T >> 4) - dig_T1) * ((adc_T >> 4) - dig_T1)) >> 12) * dig_T3) >> 14\n        let t_fine = var1 + var2;\n        let temp = t_fine;\n        // Calculate corrected temperature(no rounding)\n        // 補正後の気温を計算（数値の丸めなし）\n        T = ((temp * 5 + 128) / 256.0) / 100.0 ;\n\n        // Calculate Pressure/気圧の計算\n        // Read raw pressure data (20 bits)\n        // 気圧の生データ（20ビット）読み取り\n        let adc_P = (getreg(0xF7) << 12) + (getreg(0xF8) << 4) + (getreg(0xF9) >> 4);\n\n        // Pressure compensation calculation\n        // 気圧補正の計算\n        var1 = (t_fine >> 1) - 64000;\n        var2 = (((var1 >> 2) * (var1 >> 2)) >> 11) * dig_P6;\n        var2 = var2 + ((var1 * dig_P5) << 1);\n        var2 = (var2 >> 2) + (dig_P4 << 16);\n        var1 = (((dig_P3 * ((var1 >> 2) * (var1 >> 2)) >> 13) >> 3) + ((dig_P2 * var1) >> 1)) >> 18;\n        var1 = ((32768 + var1) * dig_P1) >> 15;\n        if (var1 == 0) {\n            return; // Prevent division by zero / 0除算防止\n        }\n        let _p = ((1048576 - adc_P) - (var2 >> 12)) * 3125;\n\n        // Calculate Pressure (no rounding)/気圧を算出（数値の丸めなし）\n        _p = (_p / var1) * 2 ;\n        var1 = (dig_P9 * (((_p >> 3) * (_p >> 3)) >> 13)) >> 12;\n        var2 = (((_p >> 2)) * dig_P8) >> 13;\n        P = _p + ((var1 + var2 + dig_P7) >> 4);\n\n        // Calculate Humidity/\t湿度の計算\n        // Read raw pressure data (16 bits)\n        // 湿度の生データ（16ビット）読み取り\n        let adc_H = (getreg(0xFD) << 8) + getreg(0xFE)\n        var1 = t_fine - 76800\n        var2 = (((adc_H << 14) - (dig_H4 << 20) - (dig_H5 * var1)) + 16384) >> 15\n        var1 = var2 * (((((((var1 * dig_H6) >> 10) * (((var1 * dig_H3) >> 11) + 32768)) >> 10) + 2097152) * dig_H2 + 8192) >> 14)\n        var2 = var1 - (((((var1 >> 15) * (var1 >> 15)) >> 7) * dig_H1) >> 4)\n        if (var2 < 0) var2 = 0\n        if (var2 > 419430400) var2 = 419430400\n        // Calculate Humidity (no rounding)/湿度を算出（数値の丸めなし）\n        H = var2 / 4194304.0\n    }\n    //\n    /**\n     *  Get pressure value from BME280 sensor/BME280 センサーから気圧を取得\n         *   \n         *  @param u Pressure unit (Pa or hPa) / 気圧の単位（Pa または hPa）\n         *  @returns Pressure value / 気圧の値（単位に応じた小数第1位）\n         */\n    //% blockId=\"BME280_GET_PRESSURE\"\n    //% block=\"Pressuer / 気圧 %Pu　Accuracy / 精度 %Prd\"\n    //% weight=80 blockGap=8\n    export function pressure(Pu: BME280_P,Prd: RPoint): number {\n        get();\n        return Rnber(P/Pu,Prd)\n    }\n\n    /**\n     * Get temperature value from BME280 sensor/ BME280 センサーから気温を取得\n         *\n         * @param u Temperature unit (C or F) / 温度の単位（C または F）\n         * @returns Temperature value / 気温の値（単位に応じた小数第1位）\n         */\n    //% blockId=\"BME280_GET_TEMPERATURE\"\n    //% block=\"Tempratuere /気温 %Tu Accuracy / 精度 %Trd\"\n    //% weight=80 blockGap=8\n    export function temperature(Tu: BME280_T, Trd: RPoint): number {\n        get();\n        let tmp=T\n        if (Tu == BME280_T.T_F) { \n            //Fahrenheit degree/華氏\t\n            tmp = T * 9 / 5 + 32;\n        }\n        return Rnber(tmp , Trd)\n    }\n\n    /**\n     * Get humidity value from BME280 sensor / BME280 センサーから湿度を取得\n         *\n         * @param u Humidity unit % / 湿度の単位 %\n         * @returns Temperature value / 湿度の値（小数第1位）\n         */\n    //% blockId=\"BME280_GET_HUMIDITY\"\n    //% block=\"Humidity / 湿度 精度 %Hrd\"\n    //% weight=80 blockGap=8\n    export function humidity(Hrd:RPoint): number {\n        get();\n        return Rnber(H,Hrd);\n    }\n    //Sensor power control (Power ON and OFF)\n    //センサーの電源管理（起動と停止）\n    /**\n     * power on / センサー起動\n       */\n    //% blockId=\"BME280_POWER_ON\" block=\"\n    //% block=\"Power On Sensor /センサー起動\"\"\n    //% weight=22 blockGap=8\n    export function PowerOn() {\n        setreg(0xF4, 0x2F)\n    }\n\n    /**\n     * power oFF　センサー停止\n       */\n    //% blockId=\"BME280_POWER_OFF\"\n    //% block=\"Power OFF Sensor/センサー停止\"\n    //% weight=21 blockGap=8\n    export function PowerOff() {\n        setreg(0xF4, 0)\n    }\n\n    /**\n     * Calculate Elevation difference /標高差の計算\n     * Input the reference point pressure P0 into the block\n     * Get the current pressure and temperature from the sensor.\n     * 基準点の気圧P0をブロックに入力\n     * 現在の気圧・気温はセンサ-から取得\n     */\n    //% block=\"Elevation difference / 標高差 %eld \"\n\n    /**\n     * Calculate Dewpoint　露点計算\n     */\n    //% block=\"Dewpoint / 露点\"\n    //% weight=60 blockGap=8\n    export function Dewpoint(Drd:RPoint): number {\n        get();\n        return T - Math.idiv(100 - H, 5)\n    }\n\n    /**\n     * Event Block\n     * イベントブロック\n     */\n    /**\n        * Triggered when pressure is Lower than a specified value. / 気圧が指定値より低い場合\n        *\n        * @param dat Threshold value / しきい値（Pa）\n        * @param body Action to perform / 実行する処理\n        */\n    //% block=\"Pressuer / 気圧 <  %dat\" dat.defl=100000\n    export function PressureBelowThan(dat: number, body: () => void): void {\n        control.inBackground(function () {\n            while (true) {\n                get()\n                if (P < dat) {\n                    body()\n                }\n                basic.pause(1000)\n            }\n        })\n    }\n\n    /**\n         * Triggered when pressure is Higher than a specified value. / 気圧が指定値より高い場合\n         *\n         * @param dat Threshold value / しきい値（Pa）\n         * @param body Action to perform / 実行する処理\n         */\n    //% block=\"Pressuer / 気圧 > %dat\" dat.defl=100000\n    export function PressureHigherThan(dat: number, body: () => void): void {\n        control.inBackground(function () {\n            while (true) {\n                get()\n                if (P > dat) {\n                    body()\n                }\n                basic.pause(1000)\n            }\n        })\n    }\n\n    /**\n        * Triggered when temprature is Lower than a specified value. / 気温が指定値より低い場合\n        *\n        * @param dat Threshold value / しきい値（C）\n        * @param body Action to perform / 実行する処理\n        */\n    //% block=\"Temperature / 気温 < %dat\" dat.defl=10\n    export function TemperatureBelowThan(dat: number, body: () => void): void {\n        control.inBackground(function () {\n            while (true) {\n                get()\n                if (T < dat) {\n                    body()\n                }\n                basic.pause(1000)\n            }\n        })\n    }\n\n    /**\n      * Triggered when tempratuere is Lower than a specified value. / 気温が指定値より低い場合\n        *\n        * @param dat Threshold value / しきい値（C）\n        * @param body Action to perform / 実行する処理\n        */\n    //% block=\"Temperature / 気温 > %dat\" dat.defl=30\n    export function TemperatureHigherThan(dat: number, body: () => void): void {\n        control.inBackground(function () {\n            while (true) {\n                get()\n                if (T > dat) {\n                    body()\n                }\n                basic.pause(1000)\n            }\n        })\n    }\n\n    /**\n      * Triggered when humidity is Lower than a specified value. /  湿度が指定値より低い場合\n        *\n        * @param dat Threshold value / しきい値（C）\n        * @param body Action to perform / 実行する処理\n        */\n    //% block=\"Humidity / 湿度 < %dat\" dat.defl=10\n    export function HumidityBelowThan(dat: number, body: () => void): void {\n        control.inBackground(function () {\n            while (true) {\n                get()\n                if (H < dat) {\n                    body()\n                }\n                basic.pause(1000)\n            }\n        })\n    }\n\n    /**\n  * Triggered when humidity is Higher than a specified value. / 湿度が指定値より高い場合\n      *\n      * @param dat Threshold value / しきい値（C）\n      * @param body Action to perform / 実行する処理\n      */\n    //% block=\"Humidity / 湿度 > %dat\" dat.defl=10\n    export function HumidityHigherThan(dat: number, body: () => void): void {\n        control.inBackground(function () {\n            while (true) {\n                get()\n                if (H > dat) {\n                    body()\n                }\n                basic.pause(1000)\n            }\n        })\n    }\n\n    /**\n         * Set the I2C address of the BME280 sensor. / BME280 の I2C アドレスを設定\n         * \n         *  @param addr I2C address to set / 設定する I2C アドレス\n         */\n    //% blockId=\"BME280_SET_ADDRESS\"\n    //% block=\"I2C Address/I2Cアドレス %addr\"\n    //% weight=20 blockGap=8\n    export function Address(addr: BME280_I2C_ADDRESS) {\n        BME280_I2C_ADDR = addr\n    }\n}\n","README.md":"","pxt.json":"{\n    \"name\": \"拡張機能確認\",\n    \"description\": \"\",\n    \"dependencies\": {\n        \"core\": \"*\",\n        \"radio\": \"*\",\n        \"microphone\": \"*\"\n    },\n    \"files\": [\n        \"main.blocks\",\n        \"main.ts\",\n        \"README.md\"\n    ],\n    \"preferredEditor\": \"tsprj\"\n}\n"}},{"timestamp":1745572276952,"editorVersion":"7.0.61","text":{"main.blocks":"<xml xmlns=\"https://developers.google.com/blockly/xml\"><variables></variables><block type=\"pxt-on-start\" x=\"0\" y=\"0\"><statement name=\"HANDLER\"><block type=\"typescript_statement\"><mutation xmlns=\"http://www.w3.org/1999/xhtml\" line0=\"namespace BME280 {\" line1=\"    //Enum Definitions / 列挙型の定義\" line2=\"    //I2C address/I2Cアドレス\" line3=\"    export enum BME280_I2C_ADDRESS {\" line4=\"        //% block=&quot;0x76&quot;\" line5=\"        ADDR_0x76 = 0x76,\" line6=\"        //% block=&quot;0x77&quot;\" line7=\"        ADDR_0x77 = 0x77\" line8=\"    }\" line9=\"\" line10=\"    //Temperature Unit / 気温の単位\" line11=\"    // Temperature units: C (Celsius) or F (Fahrenheit) / 温度単位：C（摂氏）または F（華氏）\" line12=\"    export enum BME280_T {\" line13=\"        //% block=&quot;C&quot;\" line14=\"        T_C = 0,\" line15=\"        //% block=&quot;F&quot;\" line16=\"        T_F = 1\" line17=\"    }\" line18=\"\" line19=\"    // Pressure Unit / 気圧の単位\" line20=\"    // Pressure units: Pa or hPa / 単位：Pa（パスカル）または hPa（ヘクトパスカル）\" line21=\"    export enum BME280_P {\" line22=\"        //% block=&quot;Pa&quot;\" line23=\"        Pa = 1,\" line24=\"        //% block=&quot;hPa&quot;\" line25=\"        hPa = 100\" line26=\"    }\" line27=\"\" line28=\"    // Unit of Elevation difference / 標高差の単位（m/ft）\" line29=\"    export enum Eldf {\" line30=\"        //Units meter/単位 メートル\" line31=\"        //% block=&quot;m&quot;\" line32=\"            altd_m=1,\" line33=\"        //Units feet/単位 フィート\" line34=\"        //% block=&quot;ft&quot;\" line35=\"            altd_f = 1/0.3048\" line36=\"    }\" line37=\"   \" line38=\"    // Numerical precision\" line39=\"    // 数値の精度\" line40=\"    // Integer / 1　decimal place / 2 decimal place\" line41=\"    // 整数 / 小数第1位 / 小数第2位\" line42=\"    export enum RPoint {\" line43=\"        //% block=&quot;Integer/整数&quot;\" line44=\"            Rint=1,\" line45=\"        //% block=&quot;1 demicl place / 小数第1位&quot;\" line46=\"            RPt=10,\" line47=\"        //% block=&quot;2 demicl place / 小数第2位&quot;\" line48=\"            RPt2=100\" line49=\"    }\" line50=\"        \" line51=\"    /**\" line52=\"     * Global variables to store the final compensated\" line53=\"     * temperature, pressure and humidity \" line54=\"     * temperature&#9;: unit  °C\" line55=\"     * pressuere&#9;: unit Pa\" line56=\"     * humidity&#9;&#9;: unit %\" line57=\"     * \" line58=\"     * グローバル変数：補正後の気温・気圧・湿度\" line59=\"     * 単位　気温：℃　気圧：Pa　湿度：％\" line60=\"     */\" line61=\"    let T = 0;\" line62=\"    let P = 0;\" line63=\"    let H = 0;\" line64=\"\" line65=\"    // Default I2C address: 0x77 / デフォルトの I2C アドレス：0x77\" line66=\"    let BME280_I2C_ADDR = BME280_I2C_ADDRESS.ADDR_0x76\" line67=\"\" line68=\"    // Defining Functions / 関数の定義\" line69=\"    /** \" line70=\"     * Functions &quot;Access to BME280 Registers&quot;\" line71=\"     * BME280のレジスタへのアクセスを行う関数群\" line72=\"     * A set of functions for reading from and writing to BME280\" line73=\"     * registers via I2C communication.\" line74=\"     * I2C 通信を用いて、各種レジスタへの読み書きを行う\" line75=\"     */\" line76=\"\" line77=\"    /**\" line78=\"     * Function &quot;Writes 1 byte from a register of the BME280&quot;.\" line79=\"     * BME280のレジスタに1バイトのデータを書き込む関数\" line80=\"     *\" line81=\"     * @param reg Register address (integer) / レジストリアドレス（整数値）\" line82=\"     * @returns dat write (integer) / 書き込んだ値（整数値）\" line83=\"     * @returns None/戻り値はない\" line84=\"     *\" line85=\"     * Creates a 2-byte buffer: the first byte is the register address (buf[0]),\" line86=\"     * the second byte is the data to write (buf[1]), and sends it via I2C.\" line87=\"     * レジスタアドレス（buf[0]）と書き込むデータ（buf[1]）を格納した2バイトのバッファを作成し、\" line88=\"     * I2C を使ってデバイスに送信。\" line89=\"     */\" line90=\"    function setreg(reg: number, dat: number): void {\" line91=\"        let buf = pins.createBuffer(2);\" line92=\"        buf[0] = reg;\" line93=\"        buf[1] = dat;\" line94=\"        pins.i2cWriteBuffer(BME280_I2C_ADDR, buf);\" line95=\"    }\" line96=\"\" line97=\"    /**\" line98=\"     * Function &quot;Reads 1 byte from a register of the BME280&quot;.\" line99=\"     * BME280の任意のレジスタから 1 バイトの値を読み取る関数。\" line100=\"     *\" line101=\"     * @param reg Register address (integer) / レジストリアドレス（整数値）\" line102=\"     * @returns Value read (integer) / 読み取った値（整数値）\" line103=\"     *\" line104=\"     * Sends the register address via I2C using UInt8BE format,\" line105=\"     * then reads 1 byte from the device.\" line106=\"     * レジストリアドレスを UInt8BE 形式で送信し、1 バイトを読み取って返す。\" line107=\"     */\" line108=\"    function getreg(reg: number): number {\" line109=\"        pins.i2cWriteNumber(BME280_I2C_ADDR, reg, NumberFormat.UInt8BE);\" line110=\"        return pins.i2cReadNumber(BME280_I2C_ADDR, NumberFormat.UInt8BE);\" line111=\"    }\" line112=\"\" line113=\"    /**\" line114=\"     * Function &quot;Reads a 16-bit unsigned integer&quot;.\" line115=\"     * 8 ビットの符号付き整数を読み取る関数。\" line116=\"     *\" line117=\"     * Used for calibration parameters such as dig_H6..\" line118=\"     * 補正パラメータ dig_H6 に使用。\" line119=\"     *\" line120=\"     * @param reg Register address / レジストリアドレス\" line121=\"     * @returns Unsigned 8-bit integer / 符号付き8ビット整数\" line122=\"     */\" line123=\"    function getInt8LE(reg: number): number {\" line124=\"        pins.i2cWriteNumber(BME280_I2C_ADDR, reg, NumberFormat.UInt8BE);\" line125=\"        return pins.i2cReadNumber(BME280_I2C_ADDR, NumberFormat.Int8LE);\" line126=\"    }\" line127=\"\" line128=\"    /**\" line129=\"     * Function &quot;Reads a 16-bit unsigned integer&quot;.\" line130=\"     * 16 ビットの符号なし整数を読み取る関数。\" line131=\"     *\" line132=\"     * Used for calibration parameters such as dig_T1, dig_P1, etc.\" line133=\"     * dig_T1、dig_P1 などの補正パラメータ用に使用。\" line134=\"     *\" line135=\"     * @param reg Register address / レジストリアドレス\" line136=\"     * @returns Unsigned 16-bit integer / 符号なし 16 ビット整数\" line137=\"     */\" line138=\"    function getUInt16LE(reg: number): number {\" line139=\"        pins.i2cWriteNumber(BME280_I2C_ADDR, reg, NumberFormat.UInt8BE);\" line140=\"        return pins.i2cReadNumber(BME280_I2C_ADDR, NumberFormat.UInt16LE);\" line141=\"    }\" line142=\"\" line143=\"    /**\" line144=\"     * Function &quot;Reads a 16-bit signed integer&quot;.\" line145=\"     * 16 ビットの符号付き整数を読み取る関数。\" line146=\"     * \" line147=\"     * Used for calibration parameters such as dig_T2, dig_T3, dig_P2.\" line148=\"     * dig_T2、dig_T3、dig_P2 などの補正パラメータ用に使用します。\" line149=\"     *\" line150=\"     * @param reg Register address / レジストリアドレス\" line151=\"     * @returns Signed 16-bit integer / 符号付き 16 ビット整数\" line152=\"     */\" line153=\"    function getInt16LE(reg: number): number {\" line154=\"        pins.i2cWriteNumber(BME280_I2C_ADDR, reg, NumberFormat.UInt8BE);\" line155=\"        return pins.i2cReadNumber(BME280_I2C_ADDR, NumberFormat.Int16LE);\" line156=\"    }\" line157=\"\" line158=\"    // Rounding numbers/数値の四捨五入\" line159=\"    // Integer/demicl 1 place /demicl 2 place\" line160=\"    // 整数 / 小数第1位 / 小数第２位\" line161=\"    export function Rnber(dt:number,Rdp:number): number {\" line162=\"        return Math.round(dt*Rdp)/Rdp\" line163=\"    }\" line164=\"\" line165=\"    // Function &quot;Get Tempratuer , Pressuer and humidity&quot;.\" line166=\"    // 気温・気圧・湿度取得の関数\" line167=\"    /**\" line168=\"     * BME280 calibration parameters for temperature, pressure and humidity.\" line169=\"     * BME280 の温度・気圧・湿度補正用キャリブレーションパラメータ。\" line170=\"     * \" line171=\"     * Address range: 0x88 to 0xE7 (factory-programmed values)\" line172=\"     * アドレス範囲：0x88 ～ 0xE7（工場出荷時に書き込まれた補正値）\" line173=\"     * \" line174=\"     * Common to BMP280 &amp; BME280 sensors\" line175=\"     * (excluding humidity-related registers 0xA1 to 0xE7)\" line176=\"     * BMP280・BME280 センサーで共通\" line177=\"     *（湿度関連のレジスタ 0xA1 ～ 0xE7は除く）\" line178=\"     */\" line179=\"\" line180=\"    /**\" line181=\"     * Set &quot;BME280 calibration parameter registers&quot;\" line182=\"     * BME280温度・気圧・湿度補正用キャリブレーションパラメータのレジストリ　\" line183=\"     * dig_T1 to dig_T3: temperature/気温補正\" line184=\"     * dig_P1 to dig_P9: pressuere/気圧補正\" line185=\"     * dig_H1 to dig_H6: humidity/湿度補正\" line186=\"     */\" line187=\"    // Temperature calibration parameters / 気温補正用パラメータ\" line188=\"    let dig_T1 = getUInt16LE(0x88)\" line189=\"    let dig_T2 = getInt16LE(0x8A)\" line190=\"    let dig_T3 = getInt16LE(0x8C)\" line191=\"\" line192=\"    // Pressure calibration parameters / 気圧補正用パラメータ\" line193=\"    let dig_P1 = getUInt16LE(0x8E)\" line194=\"    let dig_P2 = getInt16LE(0x90)\" line195=\"    let dig_P3 = getInt16LE(0x92)\" line196=\"    let dig_P4 = getInt16LE(0x94)\" line197=\"    let dig_P5 = getInt16LE(0x96)\" line198=\"    let dig_P6 = getInt16LE(0x98)\" line199=\"    let dig_P7 = getInt16LE(0x9A)\" line200=\"    let dig_P8 = getInt16LE(0x9C)\" line201=\"    let dig_P9 = getInt16LE(0x9E)\" line202=\"\" line203=\"    // Humidity calibration parameters / 湿度補正用パラメータ   &#9;&#9;\" line204=\"    let dig_H1 = getreg(0xA1)\" line205=\"    let dig_H2 = getInt16LE(0xE1)\" line206=\"    let dig_H3 = getreg(0xE3)\" line207=\"    let a = getreg(0xE5)\" line208=\"    let dig_H4 = (getreg(0xE4) &lt;&lt; 4) + (a % 16)\" line209=\"    let dig_H5 = (getreg(0xE6) &lt;&lt; 4) + (a &gt;&gt; 4)\" line210=\"    let dig_H6 = getInt8LE(0xE7)\" line211=\"\" line212=\"    /**\" line213=\"     * Sensor configuration:\" line214=\"     * - Set humidity oversampling to x4 (ctrl_hum, 0xF2)\" line215=\"     * - Set temperature oversampling to x16, pressure oversampling to x1, normal mode (ctrl_meas, 0xF4)\" line216=\"     * - Set standby time to 250ms and filter coefficient to x4 (config, 0xF5)\" line217=\"     *\" line218=\"     * センサーの設定：\" line219=\"     * - 湿度のオーバーサンプリングを4倍に設定（ctrl_hum、0xF2）\" line220=\"     * - 温度のオーバーサンプリングを16倍、気圧を1倍、動作モードをノーマルに設定（ctrl_meas、0xF4）\" line221=\"     * - スタンバイ時間を250ms、フィルター係数を4倍に設定（config、0xF5）\" line222=\"     */\" line223=\"    setreg(0xF2, 0x04)\" line224=\"    setreg(0xF4, 0x2F)\" line225=\"    setreg(0xF5, 0x0C)\" line226=\"\" line227=\"    /**\" line228=\"     * Calculate Temperatuer , Pressure and Humidity\" line229=\"     * 気温・気圧・湿度の算出\" line230=\"     * Reads raw data from the sensor and calculates\" line231=\"     * corrected temperature , pressure and humidity.\" line232=\"     * センサーから生データを読み取り、\" line233=\"     * 補正済みの気温・気圧・湿度を算出。\" line234=\"     */\" line235=\"    function get(): void {\" line236=\"        // Calculate Temperatuer/気温の計算\" line237=\"        // Read raw temperature data (20 bits)\" line238=\"        // 温度の生データ（20ビット）読み取り\" line239=\"        let adc_T = (getreg(0xFA) &lt;&lt; 12) + (getreg(0xFB) &lt;&lt; 4) + (getreg(0xFC) &gt;&gt; 4)\" line240=\"        let var1 = (((adc_T &gt;&gt; 3) - (dig_T1 &lt;&lt; 1)) * dig_T2) &gt;&gt; 11\" line241=\"        let var2 = (((((adc_T &gt;&gt; 4) - dig_T1) * ((adc_T &gt;&gt; 4) - dig_T1)) &gt;&gt; 12) * dig_T3) &gt;&gt; 14\" line242=\"        let t_fine = var1 + var2;\" line243=\"        let temp = t_fine;\" line244=\"        // Calculate corrected temperature(no rounding)\" line245=\"        // 補正後の気温を計算（数値の丸めなし）\" line246=\"        T = ((temp * 5 + 128) / 256.0) / 100.0 ;\" line247=\"\" line248=\"        // Calculate Pressure/気圧の計算\" line249=\"        // Read raw pressure data (20 bits)\" line250=\"        // 気圧の生データ（20ビット）読み取り\" line251=\"        let adc_P = (getreg(0xF7) &lt;&lt; 12) + (getreg(0xF8) &lt;&lt; 4) + (getreg(0xF9) &gt;&gt; 4);\" line252=\"\" line253=\"        // Pressure compensation calculation\" line254=\"        // 気圧補正の計算\" line255=\"        var1 = (t_fine &gt;&gt; 1) - 64000;\" line256=\"        var2 = (((var1 &gt;&gt; 2) * (var1 &gt;&gt; 2)) &gt;&gt; 11) * dig_P6;\" line257=\"        var2 = var2 + ((var1 * dig_P5) &lt;&lt; 1);\" line258=\"        var2 = (var2 &gt;&gt; 2) + (dig_P4 &lt;&lt; 16);\" line259=\"        var1 = (((dig_P3 * ((var1 &gt;&gt; 2) * (var1 &gt;&gt; 2)) &gt;&gt; 13) &gt;&gt; 3) + ((dig_P2 * var1) &gt;&gt; 1)) &gt;&gt; 18;\" line260=\"        var1 = ((32768 + var1) * dig_P1) &gt;&gt; 15;\" line261=\"        if (var1 == 0) {\" line262=\"            return; // Prevent division by zero / 0除算防止\" line263=\"        }\" line264=\"        let _p = ((1048576 - adc_P) - (var2 &gt;&gt; 12)) * 3125;\" line265=\"\" line266=\"        // Calculate Pressure (no rounding)/気圧を算出（数値の丸めなし）\" line267=\"        _p = (_p / var1) * 2 ;\" line268=\"        var1 = (dig_P9 * (((_p &gt;&gt; 3) * (_p &gt;&gt; 3)) &gt;&gt; 13)) &gt;&gt; 12;\" line269=\"        var2 = (((_p &gt;&gt; 2)) * dig_P8) &gt;&gt; 13;\" line270=\"        P = _p + ((var1 + var2 + dig_P7) &gt;&gt; 4);\" line271=\"\" line272=\"        // Calculate Humidity/&#9;湿度の計算\" line273=\"        // Read raw pressure data (16 bits)\" line274=\"        // 湿度の生データ（16ビット）読み取り\" line275=\"        let adc_H = (getreg(0xFD) &lt;&lt; 8) + getreg(0xFE)\" line276=\"        var1 = t_fine - 76800\" line277=\"        var2 = (((adc_H &lt;&lt; 14) - (dig_H4 &lt;&lt; 20) - (dig_H5 * var1)) + 16384) &gt;&gt; 15\" line278=\"        var1 = var2 * (((((((var1 * dig_H6) &gt;&gt; 10) * (((var1 * dig_H3) &gt;&gt; 11) + 32768)) &gt;&gt; 10) + 2097152) * dig_H2 + 8192) &gt;&gt; 14)\" line279=\"        var2 = var1 - (((((var1 &gt;&gt; 15) * (var1 &gt;&gt; 15)) &gt;&gt; 7) * dig_H1) &gt;&gt; 4)\" line280=\"        if (var2 &lt; 0) var2 = 0\" line281=\"        if (var2 &gt; 419430400) var2 = 419430400\" line282=\"        // Calculate Humidity (no rounding)/湿度を算出（数値の丸めなし）\" line283=\"        H = var2 / 4194304.0\" line284=\"    }\" line285=\"    \" line286=\"    /**\" line287=\"     *  Get pressure value from BME280 sensor/BME280 センサーから気圧を取得\" line288=\"     *   \" line289=\"     *  @param u Pressure unit (Pa or hPa) / 気圧の単位（Pa または hPa）\" line290=\"     *  @returns Pressure value / 気圧の値（単位に応じた小数第1位）         \" line291=\"     */\" line292=\"    //% blockId=&quot;BME280_GET_PRESSURE&quot;\" line293=\"    //% block=&quot;Pressuer / 気圧 %Pu　Accuracy / 精度 %Prd&quot;\" line294=\"    //% weight=80 blockGap=8\" line295=\"    export function pressure(Pu: BME280_P,Prd: RPoint): number {\" line296=\"        get();\" line297=\"        return Rnber(P/Pu,Prd)\" line298=\"    }\" line299=\"\" line300=\"    /**\" line301=\"     * Get temperature value from BME280 sensor/ BME280 センサーから気温を取得\" line302=\"     *\" line303=\"     * @param u Temperature unit (C or F) / 温度の単位（C または F）\" line304=\"     * @returns Temperature value / 気温の値（単位に応じた小数第1位）\" line305=\"     */\" line306=\"    //% blockId=&quot;BME280_GET_TEMPERATURE&quot;\" line307=\"    //% block=&quot;Tempratuere /気温 %Tu Accuracy / 精度 %Trd&quot;\" line308=\"    //% weight=80 blockGap=8\" line309=\"    export function temperature(Tu: BME280_T, Trd: RPoint): number {\" line310=\"        get();\" line311=\"        let tmp=T\" line312=\"        if (Tu == BME280_T.T_F) { \" line313=\"            //Fahrenheit degree/華氏&#9;\" line314=\"            tmp = T * 9 / 5 + 32;\" line315=\"        }\" line316=\"        return Rnber(tmp , Trd)\" line317=\"    }\" line318=\"\" line319=\"    /**\" line320=\"     * Get humidity value from BME280 sensor / BME280 センサーから湿度を取得\" line321=\"     *\" line322=\"     * @param u Humidity unit % / 湿度の単位 %\" line323=\"     * @returns Temperature value / 湿度の値（小数第1位）\" line324=\"     */\" line325=\"    //% blockId=&quot;BME280_GET_HUMIDITY&quot;\" line326=\"    //% block=&quot;Humidity / 湿度 精度 %Hrd&quot;\" line327=\"    //% weight=80 blockGap=8\" line328=\"    export function humidity(Hrd:RPoint): number {\" line329=\"        get();\" line330=\"        return Rnber(H,Hrd);\" line331=\"    }\" line332=\"    //Sensor power control (Power ON and OFF)\" line333=\"    //センサーの電源管理（起動と停止）\" line334=\"    /**\" line335=\"     * power on / センサー起動\" line336=\"     */\" line337=\"    //% blockId=&quot;BME280_POWER_ON&quot; block=&quot;\" line338=\"    //% block=&quot;Power On Sensor /センサー起動&quot;&quot;\" line339=\"    //% weight=22 blockGap=8\" line340=\"    export function PowerOn() {\" line341=\"        setreg(0xF4, 0x2F)\" line342=\"    }\" line343=\"\" line344=\"    /**\" line345=\"     * power oFF　センサー停止\" line346=\"     */\" line347=\"    //% blockId=&quot;BME280_POWER_OFF&quot;\" line348=\"    //% block=&quot;Power OFF Sensor/センサー停止&quot;\" line349=\"    //% weight=21 blockGap=8\" line350=\"    export function PowerOff() {\" line351=\"        setreg(0xF4, 0)\" line352=\"    }\" line353=\"\" line354=\"    /**\" line355=\"     * Calculate Elevation difference /標高差の計算\" line356=\"     * Input the reference point pressure P0 into the block\" line357=\"     * Get the current pressure and temperature from the sensor.\" line358=\"     * 基準点の気圧P0をブロックに入力\" line359=\"     * 現在の気圧・気温はセンサ-から取得\" line360=\"     */\" line361=\"    //% block=&quot;Elevation difference(標高差) %ELU Pressure (reference point)(気圧(基準点)) %P0 %uP0&quot;\" line362=\"    //% blockId=&quot;Elevation_difference&quot;\" line363=\"    //% weight=80  blockGap=8\" line364=\"    export function getElevationdifference(Elu:Eldf,P0: number, uP0: BME280_P):number {\" line365=\"        get();\" line366=\"        // Eprs:Current Pressure / 現地点の気圧\" line367=\"        let Eprs = P    \" line368=\"         // Etemp:Current Temperatuer（kelvin） /　現地点の気温（絶対温度）\" line369=\"        let Etemp = T+273.15 //Celsius-&gt;kelvin　/ 摂氏－＞絶対温度\" line370=\"        // Unification of units /単位の統一\" line371=\"        // If the unit of the pressure P0 at the reference point is Pa, multiply P0 by 1. \" line372=\"        // If the unit is hPa, multiply P0 by 100.\" line373=\"        // 基準点の気圧P0の単位がPaならそのまま、hPaなら1/100\" line374=\"        // uP0:P-&gt;1 hPa-&gt;1/100\" line375=\"        Eprs = Eprs *1/uP0 \" line376=\"        // Calculate Elevation difference / 標高差計算\" line377=\"        // 0.0065-&gt; Tropospheric temperature lapse rate (0.65℃/100m) \" line378=\"        // 0.0065-&gt; 対流圏の気温減率（0.65℃/100ｍ）\" line379=\"        let rt=((P0/Eprs)**(1/5.257)-1)*Etemp\" line380=\"        //　Calculate Elevation difference / 標高差を算出 (Units/単位:m)\" line381=\"        let Diffelev=rt/0.0065\" line382=\"        // Convert values ​​according to altitude units /高度の単位に応じて数値を変換\" line383=\"\" line384=\"         return Rnber(Diffelev*Elu,10)\" line385=\"    }\" line386=\"\" line387=\"    /**\" line388=\"     * Calculate Dewpoint　露点計算\" line389=\"     */\" line390=\"    //% block=&quot;Dewpoint / 露点&quot;\" line391=\"    //% weight=60 blockGap=8\" line392=\"    export function Dewpoint(Drd:RPoint): number {\" line393=\"        get();\" line394=\"        return T - Math.idiv(100 - H, 5)\" line395=\"    }\" line396=\"\" line397=\"    /**\" line398=\"     * Event Block\" line399=\"     * イベントブロック\" line400=\"    */\" line401=\"    /**\" line402=\"     * Triggered when pressure is Lower than a specified value. / 気圧が指定値より低い場合\" line403=\"     *\" line404=\"     * @param dat Threshold value / しきい値（Pa）\" line405=\"     * @param body Action to perform / 実行する処理\" line406=\"     */\" line407=\"    //% block=&quot;Pressuer / 気圧 &lt;  %dat&quot; dat.defl=100000\" line408=\"    export function PressureBelowThan(dat: number, body: () =&gt; void): void {\" line409=\"        control.inBackground(function () {\" line410=\"            while (true) {\" line411=\"                get()\" line412=\"                if (P &lt; dat) {\" line413=\"                    body()\" line414=\"                }\" line415=\"                basic.pause(1000)\" line416=\"            }\" line417=\"        })\" line418=\"    }\" line419=\"\" line420=\"    /**\" line421=\"     * Triggered when pressure is Higher than a specified value.\" line422=\"     * 気圧が指定値より高い場合\" line423=\"     * @param dat Threshold value / しきい値（Pa）\" line424=\"     * @param body Action to perform / 実行する処理\" line425=\"     */\" line426=\"    //% block=&quot;Pressuer / 気圧 &gt; %dat&quot; dat.defl=100000\" line427=\"    export function PressureHigherThan(dat: number, body: () =&gt; void): void {\" line428=\"        control.inBackground(function () {\" line429=\"            while (true) {\" line430=\"                get()\" line431=\"                if (P &gt; dat) {\" line432=\"                    body()\" line433=\"                }\" line434=\"                basic.pause(1000)\" line435=\"            }\" line436=\"        })\" line437=\"    }\" line438=\"\" line439=\"    /**\" line440=\"     * Triggered when temprature is Lower than a specified value. \" line441=\"     *  気温が指定値より低い場合\" line442=\"     *\" line443=\"     * @param dat Threshold value / しきい値（C）\" line444=\"     * @param body Action to perform / 実行する処理\" line445=\"     */\" line446=\"    //% block=&quot;Temperature / 気温 &lt; %dat&quot; dat.defl=10\" line447=\"    export function TemperatureBelowThan(dat: number, body: () =&gt; void): void {\" line448=\"        control.inBackground(function () {\" line449=\"            while (true) {\" line450=\"                get()\" line451=\"                if (T &lt; dat) {\" line452=\"                    body()\" line453=\"                }\" line454=\"                basic.pause(1000)\" line455=\"            }\" line456=\"        })\" line457=\"    }\" line458=\"\" line459=\"    /**\" line460=\"     * Triggered when tempratuere is Lower than a specified value.\" line461=\"     * 気温が指定値より低い場合\" line462=\"     *\" line463=\"     * @param dat Threshold value / しきい値（C）\" line464=\"     * @param body Action to perform / 実行する処理\" line465=\"     */\" line466=\"    //% block=&quot;Temperature / 気温 &gt; %dat&quot; dat.defl=30\" line467=\"    export function TemperatureHigherThan(dat: number, body: () =&gt; void): void {\" line468=\"        control.inBackground(function () {\" line469=\"            while (true) {\" line470=\"                get()\" line471=\"                if (T &gt; dat) {\" line472=\"                    body()\" line473=\"                }\" line474=\"                basic.pause(1000)\" line475=\"            }\" line476=\"        })\" line477=\"    }\" line478=\"\" line479=\"    /**\" line480=\"     * Triggered when humidity is Lower than a specified value. \" line481=\"     * 湿度が指定値より低い場合\" line482=\"     * @param dat Threshold value / しきい値（C）\" line483=\"     * @param body Action to perform / 実行する処理\" line484=\"     */\" line485=\"    //% block=&quot;Humidity / 湿度 &lt; %dat&quot; dat.defl=10\" line486=\"    export function HumidityBelowThan(dat: number, body: () =&gt; void): void {\" line487=\"        control.inBackground(function () {\" line488=\"            while (true) {\" line489=\"                get()\" line490=\"                if (H &lt; dat) {\" line491=\"                    body()\" line492=\"                }\" line493=\"                basic.pause(1000)\" line494=\"            }\" line495=\"        })\" line496=\"    }\" line497=\"\" line498=\"    /**\" line499=\"     * Triggered when humidity is Higher than a specified value. \" line500=\"     * 湿度が指定値より高い場合\" line501=\"     * @param dat Threshold value / しきい値（C）\" line502=\"     * @param body Action to perform / 実行する処理\" line503=\"     */\" line504=\"    //% block=&quot;Humidity / 湿度 &gt; %dat&quot; dat.defl=10\" line505=\"    export function HumidityHigherThan(dat: number, body: () =&gt; void): void {\" line506=\"        control.inBackground(function () {\" line507=\"            while (true) {\" line508=\"                get()\" line509=\"                if (H &gt; dat) {\" line510=\"                    body()\" line511=\"                }\" line512=\"                basic.pause(1000)\" line513=\"            }\" line514=\"        })\" line515=\"    }\" line516=\"\" line517=\"    /**\" line518=\"     * Set the I2C address of the BME280 sensor. / BME280 の I2C アドレスを設定\" line519=\"     * \" line520=\"     *  @param addr I2C address to set / 設定する I2C アドレス\" line521=\"     */\" line522=\"    //% blockId=&quot;BME280_SET_ADDRESS&quot;\" line523=\"    //% block=&quot;I2C Address/I2Cアドレス %addr&quot;\" line524=\"    //% weight=20 blockGap=8\" line525=\"    export function Address(addr: BME280_I2C_ADDRESS) {\" line526=\"        BME280_I2C_ADDR = addr\" line527=\"    }\" line528=\"}\" numlines=\"529\"></mutation></block></statement></block></xml>","main.ts":"namespace BME280 {\n    //Enum Definitions / 列挙型の定義\n    //I2C address/I2Cアドレス\n    export enum BME280_I2C_ADDRESS {\n        //% block=\"0x76\"\n        ADDR_0x76 = 0x76,\n        //% block=\"0x77\"\n        ADDR_0x77 = 0x77\n    }\n\n    //Temperature Unit / 気温の単位\n    // Temperature units: C (Celsius) or F (Fahrenheit) / 温度単位：C（摂氏）または F（華氏）\n    export enum BME280_T {\n        //% block=\"C\"\n        T_C = 0,\n        //% block=\"F\"\n        T_F = 1\n    }\n\n    // Pressure Unit / 気圧の単位\n    // Pressure units: Pa or hPa / 単位：Pa（パスカル）または hPa（ヘクトパスカル）\n    export enum BME280_P {\n        //% block=\"Pa\"\n        Pa = 1,\n        //% block=\"hPa\"\n        hPa = 100\n    }\n\n    // Unit of Elevation difference / 標高差の単位（m/ft）\n    export enum Eldf {\n        //Units meter/単位 メートル\n        //% block=\"m\"\n            altd_m=1,\n        //Units feet/単位 フィート\n        //% block=\"ft\"\n            altd_f = 2\n    }\n   \n    // Numerical precision\n    // 数値の精度\n    // Integer / 1　decimal place / 2 decimal place\n    // 整数 / 小数第1位 / 小数第2位\n    export enum RPoint {\n        //% block=\"Integer/整数\"\n            Rint=1,\n        //% block=\"1 demicl place / 小数第1位\"\n            RPt=10,\n        //% block=\"2 demicl place / 小数第2位\"\n            RPt2=100\n    }\n        \n    /**\n     * Global variables to store the final compensated\n     * temperature, pressure and humidity \n     * temperature\t: unit  °C\n     * pressuere\t: unit Pa\n     * humidity\t\t: unit %\n     * \n     * グローバル変数：補正後の気温・気圧・湿度\n     * 単位　気温：℃　気圧：Pa　湿度：％\n     */\n    let T = 0;\n    let P = 0;\n    let H = 0;\n\n    // Default I2C address: 0x77 / デフォルトの I2C アドレス：0x77\n    let BME280_I2C_ADDR = BME280_I2C_ADDRESS.ADDR_0x76\n\n    // Defining Functions / 関数の定義\n    /** \n     * Functions \"Access to BME280 Registers\"\n     * BME280のレジスタへのアクセスを行う関数群\n     * A set of functions for reading from and writing to BME280\n     * registers via I2C communication.\n     * I2C 通信を用いて、各種レジスタへの読み書きを行う\n     */\n\n    /**\n     * Function \"Writes 1 byte from a register of the BME280\".\n     * BME280のレジスタに1バイトのデータを書き込む関数\n     *\n     * @param reg Register address (integer) / レジストリアドレス（整数値）\n     * @returns dat write (integer) / 書き込んだ値（整数値）\n     * @returns None/戻り値はない\n     *\n     * Creates a 2-byte buffer: the first byte is the register address (buf[0]),\n     * the second byte is the data to write (buf[1]), and sends it via I2C.\n     * レジスタアドレス（buf[0]）と書き込むデータ（buf[1]）を格納した2バイトのバッファを作成し、\n     * I2C を使ってデバイスに送信。\n     */\n    function setreg(reg: number, dat: number): void {\n        let buf = pins.createBuffer(2);\n        buf[0] = reg;\n        buf[1] = dat;\n        pins.i2cWriteBuffer(BME280_I2C_ADDR, buf);\n    }\n\n    /**\n     * Function \"Reads 1 byte from a register of the BME280\".\n     * BME280の任意のレジスタから 1 バイトの値を読み取る関数。\n     *\n     * @param reg Register address (integer) / レジストリアドレス（整数値）\n     * @returns Value read (integer) / 読み取った値（整数値）\n     *\n     * Sends the register address via I2C using UInt8BE format,\n     * then reads 1 byte from the device.\n     * レジストリアドレスを UInt8BE 形式で送信し、1 バイトを読み取って返す。\n     */\n    function getreg(reg: number): number {\n        pins.i2cWriteNumber(BME280_I2C_ADDR, reg, NumberFormat.UInt8BE);\n        return pins.i2cReadNumber(BME280_I2C_ADDR, NumberFormat.UInt8BE);\n    }\n\n    /**\n     * Function \"Reads a 16-bit unsigned integer\".\n     * 8 ビットの符号付き整数を読み取る関数。\n     *\n     * Used for calibration parameters such as dig_H6..\n     * 補正パラメータ dig_H6 に使用。\n     *\n     * @param reg Register address / レジストリアドレス\n     * @returns Unsigned 8-bit integer / 符号付き8ビット整数\n     */\n    function getInt8LE(reg: number): number {\n        pins.i2cWriteNumber(BME280_I2C_ADDR, reg, NumberFormat.UInt8BE);\n        return pins.i2cReadNumber(BME280_I2C_ADDR, NumberFormat.Int8LE);\n    }\n\n    /**\n     * Function \"Reads a 16-bit unsigned integer\".\n     * 16 ビットの符号なし整数を読み取る関数。\n     *\n     * Used for calibration parameters such as dig_T1, dig_P1, etc.\n     * dig_T1、dig_P1 などの補正パラメータ用に使用。\n     *\n     * @param reg Register address / レジストリアドレス\n     * @returns Unsigned 16-bit integer / 符号なし 16 ビット整数\n     */\n    function getUInt16LE(reg: number): number {\n        pins.i2cWriteNumber(BME280_I2C_ADDR, reg, NumberFormat.UInt8BE);\n        return pins.i2cReadNumber(BME280_I2C_ADDR, NumberFormat.UInt16LE);\n    }\n\n    /**\n     * Function \"Reads a 16-bit signed integer\".\n     * 16 ビットの符号付き整数を読み取る関数。\n     * \n     * Used for calibration parameters such as dig_T2, dig_T3, dig_P2.\n     * dig_T2、dig_T3、dig_P2 などの補正パラメータ用に使用します。\n     *\n     * @param reg Register address / レジストリアドレス\n     * @returns Signed 16-bit integer / 符号付き 16 ビット整数\n     */\n    function getInt16LE(reg: number): number {\n        pins.i2cWriteNumber(BME280_I2C_ADDR, reg, NumberFormat.UInt8BE);\n        return pins.i2cReadNumber(BME280_I2C_ADDR, NumberFormat.Int16LE);\n    }\n\n    // Rounding numbers/数値の四捨五入\n    // Integer/demicl 1 place /demicl 2 place\n    // 整数 / 小数第1位 / 小数第２位\n    export function Rnber(dt:number,Rdp:number): number {\n        return Math.round(dt*Rdp)/Rdp\n    }\n\n    // Function \"Get Tempratuer , Pressuer and humidity\".\n    // 気温・気圧・湿度取得の関数\n    /**\n     * BME280 calibration parameters for temperature, pressure and humidity.\n     * BME280 の温度・気圧・湿度補正用キャリブレーションパラメータ。\n     * \n     * Address range: 0x88 to 0xE7 (factory-programmed values)\n     * アドレス範囲：0x88 ～ 0xE7（工場出荷時に書き込まれた補正値）\n     * \n     * Common to BMP280 & BME280 sensors\n     * (excluding humidity-related registers 0xA1 to 0xE7)\n     * BMP280・BME280 センサーで共通\n     *（湿度関連のレジスタ 0xA1 ～ 0xE7は除く）\n     */\n\n    /**\n     * Set \"BME280 calibration parameter registers\"\n     * BME280温度・気圧・湿度補正用キャリブレーションパラメータのレジストリ　\n     * dig_T1 to dig_T3: temperature/気温補正\n     * dig_P1 to dig_P9: pressuere/気圧補正\n     * dig_H1 to dig_H6: humidity/湿度補正\n     */\n    // Temperature calibration parameters / 気温補正用パラメータ\n    let dig_T1 = getUInt16LE(0x88)\n    let dig_T2 = getInt16LE(0x8A)\n    let dig_T3 = getInt16LE(0x8C)\n\n    // Pressure calibration parameters / 気圧補正用パラメータ\n    let dig_P1 = getUInt16LE(0x8E)\n    let dig_P2 = getInt16LE(0x90)\n    let dig_P3 = getInt16LE(0x92)\n    let dig_P4 = getInt16LE(0x94)\n    let dig_P5 = getInt16LE(0x96)\n    let dig_P6 = getInt16LE(0x98)\n    let dig_P7 = getInt16LE(0x9A)\n    let dig_P8 = getInt16LE(0x9C)\n    let dig_P9 = getInt16LE(0x9E)\n\n    // Humidity calibration parameters / 湿度補正用パラメータ   \t\t\n    let dig_H1 = getreg(0xA1)\n    let dig_H2 = getInt16LE(0xE1)\n    let dig_H3 = getreg(0xE3)\n    let a = getreg(0xE5)\n    let dig_H4 = (getreg(0xE4) << 4) + (a % 16)\n    let dig_H5 = (getreg(0xE6) << 4) + (a >> 4)\n    let dig_H6 = getInt8LE(0xE7)\n\n    /**\n     * Sensor configuration:\n     * - Set humidity oversampling to x4 (ctrl_hum, 0xF2)\n     * - Set temperature oversampling to x16, pressure oversampling to x1, normal mode (ctrl_meas, 0xF4)\n     * - Set standby time to 250ms and filter coefficient to x4 (config, 0xF5)\n     *\n     * センサーの設定：\n     * - 湿度のオーバーサンプリングを4倍に設定（ctrl_hum、0xF2）\n     * - 温度のオーバーサンプリングを16倍、気圧を1倍、動作モードをノーマルに設定（ctrl_meas、0xF4）\n     * - スタンバイ時間を250ms、フィルター係数を4倍に設定（config、0xF5）\n     */\n    setreg(0xF2, 0x04)\n    setreg(0xF4, 0x2F)\n    setreg(0xF5, 0x0C)\n\n    /**\n     * Calculate Temperatuer , Pressure and Humidity\n     * 気温・気圧・湿度の算出\n     * Reads raw data from the sensor and calculates\n     * corrected temperature , pressure and humidity.\n     * センサーから生データを読み取り、\n     * 補正済みの気温・気圧・湿度を算出。\n     */\n    function get(): void {\n        // Calculate Temperatuer/気温の計算\n        // Read raw temperature data (20 bits)\n        // 温度の生データ（20ビット）読み取り\n        let adc_T = (getreg(0xFA) << 12) + (getreg(0xFB) << 4) + (getreg(0xFC) >> 4)\n        let var1 = (((adc_T >> 3) - (dig_T1 << 1)) * dig_T2) >> 11\n        let var2 = (((((adc_T >> 4) - dig_T1) * ((adc_T >> 4) - dig_T1)) >> 12) * dig_T3) >> 14\n        let t_fine = var1 + var2;\n        let temp = t_fine;\n        // Calculate corrected temperature(no rounding)\n        // 補正後の気温を計算（数値の丸めなし）\n        T = ((temp * 5 + 128) / 256.0) / 100.0 ;\n\n        // Calculate Pressure/気圧の計算\n        // Read raw pressure data (20 bits)\n        // 気圧の生データ（20ビット）読み取り\n        let adc_P = (getreg(0xF7) << 12) + (getreg(0xF8) << 4) + (getreg(0xF9) >> 4);\n\n        // Pressure compensation calculation\n        // 気圧補正の計算\n        var1 = (t_fine >> 1) - 64000;\n        var2 = (((var1 >> 2) * (var1 >> 2)) >> 11) * dig_P6;\n        var2 = var2 + ((var1 * dig_P5) << 1);\n        var2 = (var2 >> 2) + (dig_P4 << 16);\n        var1 = (((dig_P3 * ((var1 >> 2) * (var1 >> 2)) >> 13) >> 3) + ((dig_P2 * var1) >> 1)) >> 18;\n        var1 = ((32768 + var1) * dig_P1) >> 15;\n        if (var1 == 0) {\n            return; // Prevent division by zero / 0除算防止\n        }\n        let _p = ((1048576 - adc_P) - (var2 >> 12)) * 3125;\n\n        // Calculate Pressure (no rounding)/気圧を算出（数値の丸めなし）\n        _p = (_p / var1) * 2 ;\n        var1 = (dig_P9 * (((_p >> 3) * (_p >> 3)) >> 13)) >> 12;\n        var2 = (((_p >> 2)) * dig_P8) >> 13;\n        P = _p + ((var1 + var2 + dig_P7) >> 4);\n\n        // Calculate Humidity/\t湿度の計算\n        // Read raw pressure data (16 bits)\n        // 湿度の生データ（16ビット）読み取り\n        let adc_H = (getreg(0xFD) << 8) + getreg(0xFE)\n        var1 = t_fine - 76800\n        var2 = (((adc_H << 14) - (dig_H4 << 20) - (dig_H5 * var1)) + 16384) >> 15\n        var1 = var2 * (((((((var1 * dig_H6) >> 10) * (((var1 * dig_H3) >> 11) + 32768)) >> 10) + 2097152) * dig_H2 + 8192) >> 14)\n        var2 = var1 - (((((var1 >> 15) * (var1 >> 15)) >> 7) * dig_H1) >> 4)\n        if (var2 < 0) var2 = 0\n        if (var2 > 419430400) var2 = 419430400\n        // Calculate Humidity (no rounding)/湿度を算出（数値の丸めなし）\n        H = var2 / 4194304.0\n    }\n    \n    /**\n     *  Get pressure value from BME280 sensor/BME280 センサーから気圧を取得\n     *   \n     *  @param u Pressure unit (Pa or hPa) / 気圧の単位（Pa または hPa）\n     *  @returns Pressure value / 気圧の値（単位に応じた小数第1位）         \n     */\n    //% blockId=\"BME280_GET_PRESSURE\"\n    //% block=\"Pressuer / 気圧 %Pu　Accuracy / 精度 %Prd\"\n    //% weight=80 blockGap=8\n    export function pressure(Pu: BME280_P,Prd: RPoint): number {\n        get();\n        return Rnber(P/Pu,Prd)\n    }\n\n    /**\n     * Get temperature value from BME280 sensor/ BME280 センサーから気温を取得\n     *\n     * @param u Temperature unit (C or F) / 温度の単位（C または F）\n     * @returns Temperature value / 気温の値（単位に応じた小数第1位）\n     */\n    //% blockId=\"BME280_GET_TEMPERATURE\"\n    //% block=\"Tempratuere /気温 %Tu Accuracy / 精度 %Trd\"\n    //% weight=80 blockGap=8\n    export function temperature(Tu: BME280_T, Trd: RPoint): number {\n        get();\n        let tmp=T\n        if (Tu == BME280_T.T_F) { \n            //Fahrenheit degree/華氏\t\n            tmp = T * 9 / 5 + 32;\n        }\n        return Rnber(tmp , Trd)\n    }\n\n    /**\n     * Get humidity value from BME280 sensor / BME280 センサーから湿度を取得\n     *\n     * @param u Humidity unit % / 湿度の単位 %\n     * @returns Temperature value / 湿度の値（小数第1位）\n     */\n    //% blockId=\"BME280_GET_HUMIDITY\"\n    //% block=\"Humidity / 湿度 精度 %Hrd\"\n    //% weight=80 blockGap=8\n    export function humidity(Hrd:RPoint): number {\n        get();\n        return Rnber(H,Hrd);\n    }\n    //Sensor power control (Power ON and OFF)\n    //センサーの電源管理（起動と停止）\n    /**\n     * power on / センサー起動\n     */\n    //% blockId=\"BME280_POWER_ON\" block=\"\n    //% block=\"Power On Sensor /センサー起動\"\"\n    //% weight=22 blockGap=8\n    export function PowerOn() {\n        setreg(0xF4, 0x2F)\n    }\n\n    /**\n     * power oFF　センサー停止\n     */\n    //% blockId=\"BME280_POWER_OFF\"\n    //% block=\"Power OFF Sensor/センサー停止\"\n    //% weight=21 blockGap=8\n    export function PowerOff() {\n        setreg(0xF4, 0)\n    }\n\n    /**\n     * Calculate Elevation difference /標高差の計算\n     * Input the reference point pressure P0 into the block\n     * Get the current pressure and temperature from the sensor.\n     * 基準点の気圧P0をブロックに入力\n     * 現在の気圧・気温はセンサ-から取得\n     */\n    //% block=\"Elevation difference(標高差) %ELU Pressure (reference point)(気圧(基準点)) %P0 %uP0\"\n    //% blockId=\"Elevation_difference\"\n    //% weight=80  blockGap=8\n    export function getElevationdifference(Elu:Eldf,P0: number, uP0: BME280_P):number {\n        get();\n        // Eprs:Current Pressure / 現地点の気圧\n        let Eprs = P    \n         // Etemp:Current Temperatuer（kelvin） /　現地点の気温（絶対温度）\n        let Etemp = T+273.15 //Celsius->kelvin　/ 摂氏－＞絶対温度\n        // Unification of units /単位の統一\n        // If the unit of the pressure P0 at the reference point is Pa, multiply P0 by 1. \n        // If the unit is hPa, multiply P0 by 100.\n        // 基準点の気圧P0の単位がPaならそのまま、hPaなら1/100\n        // uP0:P->1 hPa->1/100\n        Eprs = Eprs *1/uP0 \n        // Calculate Elevation difference / 標高差計算\n        // 0.0065-> Tropospheric temperature lapse rate (0.65℃/100m) \n        // 0.0065-> 対流圏の気温減率（0.65℃/100ｍ）\n        let rt=((P0/Eprs)**(1/5.257)-1)*Etemp\n        //　Calculate Elevation difference / 標高差を算出 (Units/単位:m)\n        let Diffelev=rt/0.0065\n        // Convert values ​​according to altitude units /高度の単位に応じて数値を変換\n        if(Elu==2){\n            Diffelev=Diffelev*3.2808}\n         return Rnber(Diffelev,10)\n    }\n\n    /**\n     * Calculate Dewpoint　露点計算\n     */\n    //% block=\"Dewpoint / 露点\"\n    //% weight=60 blockGap=8\n    export function Dewpoint(Drd:RPoint): number {\n        get();\n        return T - Math.idiv(100 - H, 5)\n    }\n\n    /**\n     * Event Block\n     * イベントブロック\n    */\n    /**\n     * Triggered when pressure is Lower than a specified value. / 気圧が指定値より低い場合\n     *\n     * @param dat Threshold value / しきい値（Pa）\n     * @param body Action to perform / 実行する処理\n     */\n    //% block=\"Pressuer / 気圧 <  %dat\" dat.defl=100000\n    export function PressureBelowThan(dat: number, body: () => void): void {\n        control.inBackground(function () {\n            while (true) {\n                get()\n                if (P < dat) {\n                    body()\n                }\n                basic.pause(1000)\n            }\n        })\n    }\n\n    /**\n     * Triggered when pressure is Higher than a specified value.\n     * 気圧が指定値より高い場合\n     * @param dat Threshold value / しきい値（Pa）\n     * @param body Action to perform / 実行する処理\n     */\n    //% block=\"Pressuer / 気圧 > %dat\" dat.defl=100000\n    export function PressureHigherThan(dat: number, body: () => void): void {\n        control.inBackground(function () {\n            while (true) {\n                get()\n                if (P > dat) {\n                    body()\n                }\n                basic.pause(1000)\n            }\n        })\n    }\n\n    /**\n     * Triggered when temprature is Lower than a specified value. \n     *  気温が指定値より低い場合\n     *\n     * @param dat Threshold value / しきい値（C）\n     * @param body Action to perform / 実行する処理\n     */\n    //% block=\"Temperature / 気温 < %dat\" dat.defl=10\n    export function TemperatureBelowThan(dat: number, body: () => void): void {\n        control.inBackground(function () {\n            while (true) {\n                get()\n                if (T < dat) {\n                    body()\n                }\n                basic.pause(1000)\n            }\n        })\n    }\n\n    /**\n     * Triggered when tempratuere is Lower than a specified value.\n     * 気温が指定値より低い場合\n     *\n     * @param dat Threshold value / しきい値（C）\n     * @param body Action to perform / 実行する処理\n     */\n    //% block=\"Temperature / 気温 > %dat\" dat.defl=30\n    export function TemperatureHigherThan(dat: number, body: () => void): void {\n        control.inBackground(function () {\n            while (true) {\n                get()\n                if (T > dat) {\n                    body()\n                }\n                basic.pause(1000)\n            }\n        })\n    }\n\n    /**\n     * Triggered when humidity is Lower than a specified value. \n     * 湿度が指定値より低い場合\n     * @param dat Threshold value / しきい値（C）\n     * @param body Action to perform / 実行する処理\n     */\n    //% block=\"Humidity / 湿度 < %dat\" dat.defl=10\n    export function HumidityBelowThan(dat: number, body: () => void): void {\n        control.inBackground(function () {\n            while (true) {\n                get()\n                if (H < dat) {\n                    body()\n                }\n                basic.pause(1000)\n            }\n        })\n    }\n\n    /**\n     * Triggered when humidity is Higher than a specified value. \n     * 湿度が指定値より高い場合\n     * @param dat Threshold value / しきい値（C）\n     * @param body Action to perform / 実行する処理\n     */\n    //% block=\"Humidity / 湿度 > %dat\" dat.defl=10\n    export function HumidityHigherThan(dat: number, body: () => void): void {\n        control.inBackground(function () {\n            while (true) {\n                get()\n                if (H > dat) {\n                    body()\n                }\n                basic.pause(1000)\n            }\n        })\n    }\n\n    /**\n     * Set the I2C address of the BME280 sensor. / BME280 の I2C アドレスを設定\n     * \n     *  @param addr I2C address to set / 設定する I2C アドレス\n     */\n    //% blockId=\"BME280_SET_ADDRESS\"\n    //% block=\"I2C Address/I2Cアドレス %addr\"\n    //% weight=20 blockGap=8\n    export function Address(addr: BME280_I2C_ADDRESS) {\n        BME280_I2C_ADDR = addr\n    }\n}\n","README.md":"","pxt.json":"{\n    \"name\": \"拡張機能確認\",\n    \"description\": \"\",\n    \"dependencies\": {\n        \"core\": \"*\",\n        \"radio\": \"*\",\n        \"microphone\": \"*\"\n    },\n    \"files\": [\n        \"main.blocks\",\n        \"main.ts\",\n        \"README.md\"\n    ],\n    \"preferredEditor\": \"tsprj\"\n}\n"}},{"timestamp":1745965932204,"editorVersion":"7.0.61","text":{"main.blocks":"<xml xmlns=\"https://developers.google.com/blockly/xml\"><variables></variables><block type=\"pxt-on-start\" x=\"0\" y=\"0\"><statement name=\"HANDLER\"><block type=\"typescript_statement\"><mutation xmlns=\"http://www.w3.org/1999/xhtml\" line0=\"namespace BME280 {\" line1=\"    //Enum Definitions / 列挙型の定義\" line2=\"    //I2C address/I2Cアドレス\" line3=\"    export enum BME280_I2C_ADDRESS {\" line4=\"        //% block=&quot;0x76&quot;\" line5=\"        ADDR_0x76 = 0x76,\" line6=\"        //% block=&quot;0x77&quot;\" line7=\"        ADDR_0x77 = 0x77\" line8=\"    }\" line9=\"\" line10=\"    //Temperature Unit / 気温の単位\" line11=\"    // Temperature units: C (Celsius) or F (Fahrenheit) / 温度単位：C（摂氏）または F（華氏）\" line12=\"    export enum BME280_T {\" line13=\"        //% block=&quot;C&quot;\" line14=\"        T_C = 0,\" line15=\"        //% block=&quot;F&quot;\" line16=\"        T_F = 1\" line17=\"    }\" line18=\"\" line19=\"    // Pressure Unit / 気圧の単位\" line20=\"    // Pressure units: Pa or hPa / 単位：Pa（パスカル）または hPa（ヘクトパスカル）\" line21=\"    export enum BME280_P {\" line22=\"        //% block=&quot;Pa&quot;\" line23=\"        Pa = 1,\" line24=\"        //% block=&quot;hPa&quot;\" line25=\"        hPa = 100\" line26=\"    }\" line27=\"\" line28=\"    // Unit of Elevation difference / 標高差の単位（m/ft）\" line29=\"    export enum Eldf {\" line30=\"        //Units meter/単位 メートル\" line31=\"        //% block=&quot;m&quot;\" line32=\"            altd_m=1,\" line33=\"        //Units feet/単位 フィート\" line34=\"        //% block=&quot;ft&quot;\" line35=\"            altd_f = 1/0.3048\" line36=\"    }\" line37=\"   \" line38=\"    // Numerical precision\" line39=\"    // 数値の精度\" line40=\"    // Integer / 1　decimal place / 2 decimal place\" line41=\"    // 整数 / 小数第1位 / 小数第2位\" line42=\"    export enum RPoint {\" line43=\"        //% block=&quot;Integer/整数&quot;\" line44=\"            Rint=1,\" line45=\"        //% block=&quot;1 demicl place / 小数第1位&quot;\" line46=\"            RPt=10,\" line47=\"        //% block=&quot;2 demicl place / 小数第2位&quot;\" line48=\"            RPt2=100\" line49=\"    }\" line50=\"        \" line51=\"    /**\" line52=\"     * Global variables to store the final compensated\" line53=\"     * temperature, pressure and humidity \" line54=\"     * temperature&#9;: unit  °C\" line55=\"     * pressuere&#9;: unit Pa\" line56=\"     * humidity&#9;&#9;: unit %\" line57=\"     * \" line58=\"     * グローバル変数：補正後の気温・気圧・湿度\" line59=\"     * 単位　気温：℃　気圧：Pa　湿度：％\" line60=\"     */\" line61=\"    let T = 0;\" line62=\"    let P = 0;\" line63=\"    let H = 0;\" line64=\"\" line65=\"    // Default I2C address: 0x77 / デフォルトの I2C アドレス：0x77\" line66=\"    let BME280_I2C_ADDR = BME280_I2C_ADDRESS.ADDR_0x76\" line67=\"\" line68=\"    // Defining Functions / 関数の定義\" line69=\"    /** \" line70=\"     * Functions &quot;Access to BME280 Registers&quot;\" line71=\"     * BME280のレジスタへのアクセスを行う関数群\" line72=\"     * A set of functions for reading from and writing to BME280\" line73=\"     * registers via I2C communication.\" line74=\"     * I2C 通信を用いて、各種レジスタへの読み書きを行う\" line75=\"     */\" line76=\"\" line77=\"    /**\" line78=\"     * Function &quot;Writes 1 byte from a register of the BME280&quot;.\" line79=\"     * BME280のレジスタに1バイトのデータを書き込む関数\" line80=\"     *\" line81=\"     * @param reg Register address (integer) / レジストリアドレス（整数値）\" line82=\"     * @returns dat write (integer) / 書き込んだ値（整数値）\" line83=\"     * @returns None/戻り値はない\" line84=\"     *\" line85=\"     * Creates a 2-byte buffer: the first byte is the register address (buf[0]),\" line86=\"     * the second byte is the data to write (buf[1]), and sends it via I2C.\" line87=\"     * レジスタアドレス（buf[0]）と書き込むデータ（buf[1]）を格納した2バイトのバッファを作成し、\" line88=\"     * I2C を使ってデバイスに送信。\" line89=\"     */\" line90=\"    function setreg(reg: number, dat: number): void {\" line91=\"        let buf = pins.createBuffer(2);\" line92=\"        buf[0] = reg;\" line93=\"        buf[1] = dat;\" line94=\"        pins.i2cWriteBuffer(BME280_I2C_ADDR, buf);\" line95=\"    }\" line96=\"\" line97=\"    /**\" line98=\"     * Function &quot;Reads 1 byte from a register of the BME280&quot;.\" line99=\"     * BME280の任意のレジスタから 1 バイトの値を読み取る関数。\" line100=\"     *\" line101=\"     * @param reg Register address (integer) / レジストリアドレス（整数値）\" line102=\"     * @returns Value read (integer) / 読み取った値（整数値）\" line103=\"     *\" line104=\"     * Sends the register address via I2C using UInt8BE format,\" line105=\"     * then reads 1 byte from the device.\" line106=\"     * レジストリアドレスを UInt8BE 形式で送信し、1 バイトを読み取って返す。\" line107=\"     */\" line108=\"    function getreg(reg: number): number {\" line109=\"        pins.i2cWriteNumber(BME280_I2C_ADDR, reg, NumberFormat.UInt8BE);\" line110=\"        return pins.i2cReadNumber(BME280_I2C_ADDR, NumberFormat.UInt8BE);\" line111=\"    }\" line112=\"\" line113=\"    /**\" line114=\"     * Function &quot;Reads a 16-bit unsigned integer&quot;.\" line115=\"     * 8 ビットの符号付き整数を読み取る関数。\" line116=\"     *\" line117=\"     * Used for calibration parameters such as dig_H6..\" line118=\"     * 補正パラメータ dig_H6 に使用。\" line119=\"     *\" line120=\"     * @param reg Register address / レジストリアドレス\" line121=\"     * @returns Unsigned 8-bit integer / 符号付き8ビット整数\" line122=\"     */\" line123=\"    function getInt8LE(reg: number): number {\" line124=\"        pins.i2cWriteNumber(BME280_I2C_ADDR, reg, NumberFormat.UInt8BE);\" line125=\"        return pins.i2cReadNumber(BME280_I2C_ADDR, NumberFormat.Int8LE);\" line126=\"    }\" line127=\"\" line128=\"    /**\" line129=\"     * Function &quot;Reads a 16-bit unsigned integer&quot;.\" line130=\"     * 16 ビットの符号なし整数を読み取る関数。\" line131=\"     *\" line132=\"     * Used for calibration parameters such as dig_T1, dig_P1, etc.\" line133=\"     * dig_T1、dig_P1 などの補正パラメータ用に使用。\" line134=\"     *\" line135=\"     * @param reg Register address / レジストリアドレス\" line136=\"     * @returns Unsigned 16-bit integer / 符号なし 16 ビット整数\" line137=\"     */\" line138=\"    function getUInt16LE(reg: number): number {\" line139=\"        pins.i2cWriteNumber(BME280_I2C_ADDR, reg, NumberFormat.UInt8BE);\" line140=\"        return pins.i2cReadNumber(BME280_I2C_ADDR, NumberFormat.UInt16LE);\" line141=\"    }\" line142=\"\" line143=\"    /**\" line144=\"     * Function &quot;Reads a 16-bit signed integer&quot;.\" line145=\"     * 16 ビットの符号付き整数を読み取る関数。\" line146=\"     * \" line147=\"     * Used for calibration parameters such as dig_T2, dig_T3, dig_P2.\" line148=\"     * dig_T2、dig_T3、dig_P2 などの補正パラメータ用に使用します。\" line149=\"     *\" line150=\"     * @param reg Register address / レジストリアドレス\" line151=\"     * @returns Signed 16-bit integer / 符号付き 16 ビット整数\" line152=\"     */\" line153=\"    function getInt16LE(reg: number): number {\" line154=\"        pins.i2cWriteNumber(BME280_I2C_ADDR, reg, NumberFormat.UInt8BE);\" line155=\"        return pins.i2cReadNumber(BME280_I2C_ADDR, NumberFormat.Int16LE);\" line156=\"    }\" line157=\"\" line158=\"    // Rounding numbers/数値の四捨五入\" line159=\"    // Integer/demicl 1 place /demicl 2 place\" line160=\"    // 整数 / 小数第1位 / 小数第２位\" line161=\"    export function Rnber(dt:number,Rdp:number): number {\" line162=\"        return Math.round(dt*Rdp)/Rdp\" line163=\"    }\" line164=\"\" line165=\"    // Function &quot;Get Tempratuer , Pressuer and humidity&quot;.\" line166=\"    // 気温・気圧・湿度取得の関数\" line167=\"    /**\" line168=\"     * BME280 calibration parameters for temperature, pressure and humidity.\" line169=\"     * BME280 の温度・気圧・湿度補正用キャリブレーションパラメータ。\" line170=\"     * \" line171=\"     * Address range: 0x88 to 0xE7 (factory-programmed values)\" line172=\"     * アドレス範囲：0x88 ～ 0xE7（工場出荷時に書き込まれた補正値）\" line173=\"     * \" line174=\"     * Common to BMP280 &amp; BME280 sensors\" line175=\"     * (excluding humidity-related registers 0xA1 to 0xE7)\" line176=\"     * BMP280・BME280 センサーで共通\" line177=\"     *（湿度関連のレジスタ 0xA1 ～ 0xE7は除く）\" line178=\"     */\" line179=\"\" line180=\"    /**\" line181=\"     * Set &quot;BME280 calibration parameter registers&quot;\" line182=\"     * BME280温度・気圧・湿度補正用キャリブレーションパラメータのレジストリ　\" line183=\"     * dig_T1 to dig_T3: temperature/気温補正\" line184=\"     * dig_P1 to dig_P9: pressuere/気圧補正\" line185=\"     * dig_H1 to dig_H6: humidity/湿度補正\" line186=\"     */\" line187=\"    // Temperature calibration parameters / 気温補正用パラメータ\" line188=\"    let dig_T1 = getUInt16LE(0x88)\" line189=\"    let dig_T2 = getInt16LE(0x8A)\" line190=\"    let dig_T3 = getInt16LE(0x8C)\" line191=\"\" line192=\"    // Pressure calibration parameters / 気圧補正用パラメータ\" line193=\"    let dig_P1 = getUInt16LE(0x8E)\" line194=\"    let dig_P2 = getInt16LE(0x90)\" line195=\"    let dig_P3 = getInt16LE(0x92)\" line196=\"    let dig_P4 = getInt16LE(0x94)\" line197=\"    let dig_P5 = getInt16LE(0x96)\" line198=\"    let dig_P6 = getInt16LE(0x98)\" line199=\"    let dig_P7 = getInt16LE(0x9A)\" line200=\"    let dig_P8 = getInt16LE(0x9C)\" line201=\"    let dig_P9 = getInt16LE(0x9E)\" line202=\"\" line203=\"    // Humidity calibration parameters / 湿度補正用パラメータ   &#9;&#9;\" line204=\"    let dig_H1 = getreg(0xA1)\" line205=\"    let dig_H2 = getInt16LE(0xE1)\" line206=\"    let dig_H3 = getreg(0xE3)\" line207=\"    let a = getreg(0xE5)\" line208=\"    let dig_H4 = (getreg(0xE4) &lt;&lt; 4) + (a % 16)\" line209=\"    let dig_H5 = (getreg(0xE6) &lt;&lt; 4) + (a &gt;&gt; 4)\" line210=\"    let dig_H6 = getInt8LE(0xE7)\" line211=\"\" line212=\"    /**\" line213=\"     * Sensor configuration:\" line214=\"     * - Set humidity oversampling to x4 (ctrl_hum, 0xF2)\" line215=\"     * - Set temperature oversampling to x16, pressure oversampling to x1, normal mode (ctrl_meas, 0xF4)\" line216=\"     * - Set standby time to 250ms and filter coefficient to x4 (config, 0xF5)\" line217=\"     *\" line218=\"     * センサーの設定：\" line219=\"     * - 湿度のオーバーサンプリングを4倍に設定（ctrl_hum、0xF2）\" line220=\"     * - 温度のオーバーサンプリングを16倍、気圧を1倍、動作モードをノーマルに設定（ctrl_meas、0xF4）\" line221=\"     * - スタンバイ時間を250ms、フィルター係数を4倍に設定（config、0xF5）\" line222=\"     */\" line223=\"    setreg(0xF2, 0x04)\" line224=\"    setreg(0xF4, 0x2F)\" line225=\"    setreg(0xF5, 0x0C)\" line226=\"\" line227=\"    /**\" line228=\"     * Calculate Temperatuer , Pressure and Humidity\" line229=\"     * 気温・気圧・湿度の算出\" line230=\"     * Reads raw data from the sensor and calculates\" line231=\"     * corrected temperature , pressure and humidity.\" line232=\"     * センサーから生データを読み取り、\" line233=\"     * 補正済みの気温・気圧・湿度を算出。\" line234=\"     */\" line235=\"    function get(): void {\" line236=\"        // Calculate Temperatuer/気温の計算\" line237=\"        // Read raw temperature data (20 bits)\" line238=\"        // 温度の生データ（20ビット）読み取り\" line239=\"        let adc_T = (getreg(0xFA) &lt;&lt; 12) + (getreg(0xFB) &lt;&lt; 4) + (getreg(0xFC) &gt;&gt; 4)\" line240=\"        let var1 = (((adc_T &gt;&gt; 3) - (dig_T1 &lt;&lt; 1)) * dig_T2) &gt;&gt; 11\" line241=\"        let var2 = (((((adc_T &gt;&gt; 4) - dig_T1) * ((adc_T &gt;&gt; 4) - dig_T1)) &gt;&gt; 12) * dig_T3) &gt;&gt; 14\" line242=\"        let t_fine = var1 + var2;\" line243=\"        let temp = t_fine;\" line244=\"        // Calculate corrected temperature(no rounding)\" line245=\"        // 補正後の気温を計算（数値の丸めなし）\" line246=\"        T = ((temp * 5 + 128) / 256.0) / 100.0 ;\" line247=\"\" line248=\"        // Calculate Pressure/気圧の計算\" line249=\"        // Read raw pressure data (20 bits)\" line250=\"        // 気圧の生データ（20ビット）読み取り\" line251=\"        let adc_P = (getreg(0xF7) &lt;&lt; 12) + (getreg(0xF8) &lt;&lt; 4) + (getreg(0xF9) &gt;&gt; 4);\" line252=\"\" line253=\"        // Pressure compensation calculation\" line254=\"        // 気圧補正の計算\" line255=\"        var1 = (t_fine &gt;&gt; 1) - 64000;\" line256=\"        var2 = (((var1 &gt;&gt; 2) * (var1 &gt;&gt; 2)) &gt;&gt; 11) * dig_P6;\" line257=\"        var2 = var2 + ((var1 * dig_P5) &lt;&lt; 1);\" line258=\"        var2 = (var2 &gt;&gt; 2) + (dig_P4 &lt;&lt; 16);\" line259=\"        var1 = (((dig_P3 * ((var1 &gt;&gt; 2) * (var1 &gt;&gt; 2)) &gt;&gt; 13) &gt;&gt; 3) + ((dig_P2 * var1) &gt;&gt; 1)) &gt;&gt; 18;\" line260=\"        var1 = ((32768 + var1) * dig_P1) &gt;&gt; 15;\" line261=\"        if (var1 == 0) {\" line262=\"            return; // Prevent division by zero / 0除算防止\" line263=\"        }\" line264=\"        let _p = ((1048576 - adc_P) - (var2 &gt;&gt; 12)) * 3125;\" line265=\"\" line266=\"        // Calculate Pressure (no rounding)/気圧を算出（数値の丸めなし）\" line267=\"        _p = (_p / var1) * 2 ;\" line268=\"        var1 = (dig_P9 * (((_p &gt;&gt; 3) * (_p &gt;&gt; 3)) &gt;&gt; 13)) &gt;&gt; 12;\" line269=\"        var2 = (((_p &gt;&gt; 2)) * dig_P8) &gt;&gt; 13;\" line270=\"        P = _p + ((var1 + var2 + dig_P7) &gt;&gt; 4);\" line271=\"\" line272=\"        // Calculate Humidity/&#9;湿度の計算\" line273=\"        // Read raw pressure data (16 bits)\" line274=\"        // 湿度の生データ（16ビット）読み取り\" line275=\"        let adc_H = (getreg(0xFD) &lt;&lt; 8) + getreg(0xFE)\" line276=\"        var1 = t_fine - 76800\" line277=\"        var2 = (((adc_H &lt;&lt; 14) - (dig_H4 &lt;&lt; 20) - (dig_H5 * var1)) + 16384) &gt;&gt; 15\" line278=\"        var1 = var2 * (((((((var1 * dig_H6) &gt;&gt; 10) * (((var1 * dig_H3) &gt;&gt; 11) + 32768)) &gt;&gt; 10) + 2097152) * dig_H2 + 8192) &gt;&gt; 14)\" line279=\"        var2 = var1 - (((((var1 &gt;&gt; 15) * (var1 &gt;&gt; 15)) &gt;&gt; 7) * dig_H1) &gt;&gt; 4)\" line280=\"        if (var2 &lt; 0) var2 = 0\" line281=\"        if (var2 &gt; 419430400) var2 = 419430400\" line282=\"        // Calculate Humidity (no rounding)/湿度を算出（数値の丸めなし）\" line283=\"        H = var2 / 4194304.0\" line284=\"    }\" line285=\"    \" line286=\"    /**\" line287=\"     *  Get pressure value from BME280 sensor/BME280 センサーから気圧を取得\" line288=\"     *   \" line289=\"     *  @param u Pressure unit (Pa or hPa) / 気圧の単位（Pa または hPa）\" line290=\"     *  @returns Pressure value / 気圧の値（単位に応じた小数第1位）         \" line291=\"     */\" line292=\"    //% blockId=&quot;BME280_GET_PRESSURE&quot;\" line293=\"    //% block=&quot;Pressuer / 気圧 %Pu　Accuracy / 精度 %Prd&quot;\" line294=\"    //% weight=80 blockGap=8\" line295=\"    export function pressure(Pu: BME280_P,Prd: RPoint): number {\" line296=\"        get();\" line297=\"        return Rnber(P/Pu,Prd)\" line298=\"    }\" line299=\"\" line300=\"    /**\" line301=\"     * Get temperature value from BME280 sensor/ BME280 センサーから気温を取得\" line302=\"     *\" line303=\"     * @param u Temperature unit (C or F) / 温度の単位（C または F）\" line304=\"     * @returns Temperature value / 気温の値（単位に応じた小数第1位）\" line305=\"     */\" line306=\"    //% blockId=&quot;BME280_GET_TEMPERATURE&quot;\" line307=\"    //% block=&quot;Tempratuere /気温 %Tu Accuracy / 精度 %Trd&quot;\" line308=\"    //% weight=80 blockGap=8\" line309=\"    export function temperature(Tu: BME280_T, Trd: RPoint): number {\" line310=\"        get();\" line311=\"        let tmp=T\" line312=\"        if (Tu == BME280_T.T_F) { \" line313=\"            //Fahrenheit degree/華氏&#9;\" line314=\"            tmp = T * 9 / 5 + 32;\" line315=\"        }\" line316=\"        return Rnber(tmp , Trd)\" line317=\"    }\" line318=\"\" line319=\"    /**\" line320=\"     * Get humidity value from BME280 sensor / BME280 センサーから湿度を取得\" line321=\"     *\" line322=\"     * @param u Humidity unit % / 湿度の単位 %\" line323=\"     * @returns Temperature value / 湿度の値（小数第1位）\" line324=\"     */\" line325=\"    //% blockId=&quot;BME280_GET_HUMIDITY&quot;\" line326=\"    //% block=&quot;Humidity / 湿度 精度 %Hrd&quot;\" line327=\"    //% weight=80 blockGap=8\" line328=\"    export function humidity(Hrd:RPoint): number {\" line329=\"        get();\" line330=\"        return Rnber(H,Hrd);\" line331=\"    }\" line332=\"    //Sensor power control (Power ON and OFF)\" line333=\"    //センサーの電源管理（起動と停止）\" line334=\"    /**\" line335=\"     * power on / センサー起動\" line336=\"     */\" line337=\"    //% blockId=&quot;BME280_POWER_ON&quot; block=&quot;\" line338=\"    //% block=&quot;Power On Sensor /センサー起動&quot;&quot;\" line339=\"    //% weight=22 blockGap=8\" line340=\"    export function PowerOn() {\" line341=\"        setreg(0xF4, 0x2F)\" line342=\"    }\" line343=\"\" line344=\"    /**\" line345=\"     * power oFF　センサー停止\" line346=\"     */\" line347=\"    //% blockId=&quot;BME280_POWER_OFF&quot;\" line348=\"    //% block=&quot;Power OFF Sensor/センサー停止&quot;\" line349=\"    //% weight=21 blockGap=8\" line350=\"    export function PowerOff() {\" line351=\"        setreg(0xF4, 0)\" line352=\"    }\" line353=\"\" line354=\"    /**\" line355=\"     * Calculate Elevation difference /標高差の計算\" line356=\"     * Input the reference point pressure P0 into the block\" line357=\"     * Get the current pressure and temperature from the sensor.\" line358=\"     * 基準点の気圧P0をブロックに入力\" line359=\"     * 現在の気圧・気温はセンサ-から取得\" line360=\"     */\" line361=\"    //% block=&quot;Elevation difference(標高差) %ELU Pressure (reference point)(気圧(基準点)) %P0 %uP0&quot;\" line362=\"    //% blockId=&quot;Elevation_difference&quot;\" line363=\"    //% weight=80  blockGap=8\" line364=\"    export function getElevationdifference(Elu:Eldf,P0: number, uP0: BME280_P):number {\" line365=\"        get();\" line366=\"        // Eprs:Current Pressure / 現地点の気圧\" line367=\"        let Eprs = P    \" line368=\"         // Etemp:Current Temperatuer（kelvin） /　現地点の気温（絶対温度）\" line369=\"        let Etemp = T+273.15 //Celsius-&gt;kelvin　/ 摂氏－＞絶対温度\" line370=\"        // Unification of units /単位の統一\" line371=\"        // If the unit of the pressure P0 at the reference point is Pa, multiply P0 by 1. \" line372=\"        // If the unit is hPa, multiply P0 by 100.\" line373=\"        // 基準点の気圧P0の単位がPaならそのまま、hPaなら1/100\" line374=\"        // uP0:P-&gt;1 hPa-&gt;1/100\" line375=\"        Eprs = Eprs *1/uP0 \" line376=\"        // Calculate Elevation difference / 標高差計算\" line377=\"        // 0.0065-&gt; Tropospheric temperature lapse rate (0.65℃/100m) \" line378=\"        // 0.0065-&gt; 対流圏の気温減率（0.65℃/100ｍ）\" line379=\"        let rt=((P0/Eprs)**(1/5.257)-1)*Etemp\" line380=\"        //　Calculate Elevation difference / 標高差を算出 (Units/単位:m)\" line381=\"        let Diffelev=rt/0.0065\" line382=\"        // Convert values ​​according to altitude units /高度の単位に応じて数値を変換\" line383=\"\" line384=\"         return Rnber(Diffelev*Elu,10)\" line385=\"    }\" line386=\"\" line387=\"    /**\" line388=\"     * Calculate Dewpoint　露点計算\" line389=\"     */\" line390=\"    //% block=&quot;Dewpoint / 露点&quot;\" line391=\"    //% weight=60 blockGap=8\" line392=\"    export function Dewpoint(Drd:RPoint): number {\" line393=\"        get();\" line394=\"        return T - Math.idiv(100 - H, 5)\" line395=\"    }\" line396=\"\" line397=\"    /**\" line398=\"     * Event Block\" line399=\"     * イベントブロック\" line400=\"    */\" line401=\"    /**\" line402=\"     * Triggered when pressure is Lower than a specified value. / 気圧が指定値より低い場合\" line403=\"     *\" line404=\"     * @param dat Threshold value / しきい値（Pa）\" line405=\"     * @param body Action to perform / 実行する処理\" line406=\"     */\" line407=\"    //% block=&quot;Pressuer / 気圧 &lt;  %dat&quot; dat.defl=100000\" line408=\"    export function PressureBelowThan(dat: number, body: () =&gt; void): void {\" line409=\"        control.inBackground(function () {\" line410=\"            while (true) {\" line411=\"                get()\" line412=\"                if (P &lt; dat) {\" line413=\"                    body()\" line414=\"                }\" line415=\"                basic.pause(1000)\" line416=\"            }\" line417=\"        })\" line418=\"    }\" line419=\"\" line420=\"    /**\" line421=\"     * Triggered when pressure is Higher than a specified value.\" line422=\"     * 気圧が指定値より高い場合\" line423=\"     * @param dat Threshold value / しきい値（Pa）\" line424=\"     * @param body Action to perform / 実行する処理\" line425=\"     */\" line426=\"    //% block=&quot;Pressuer / 気圧 &gt; %dat&quot; dat.defl=100000\" line427=\"    export function PressureHigherThan(dat: number, body: () =&gt; void): void {\" line428=\"        control.inBackground(function () {\" line429=\"            while (true) {\" line430=\"                get()\" line431=\"                if (P &gt; dat) {\" line432=\"                    body()\" line433=\"                }\" line434=\"                basic.pause(1000)\" line435=\"            }\" line436=\"        })\" line437=\"    }\" line438=\"\" line439=\"    /**\" line440=\"     * Triggered when temprature is Lower than a specified value. \" line441=\"     *  気温が指定値より低い場合\" line442=\"     *\" line443=\"     * @param dat Threshold value / しきい値（C）\" line444=\"     * @param body Action to perform / 実行する処理\" line445=\"     */\" line446=\"    //% block=&quot;Temperature / 気温 &lt; %dat&quot; dat.defl=10\" line447=\"    export function TemperatureBelowThan(dat: number, body: () =&gt; void): void {\" line448=\"        control.inBackground(function () {\" line449=\"            while (true) {\" line450=\"                get()\" line451=\"                if (T &lt; dat) {\" line452=\"                    body()\" line453=\"                }\" line454=\"                basic.pause(1000)\" line455=\"            }\" line456=\"        })\" line457=\"    }\" line458=\"\" line459=\"    /**\" line460=\"     * Triggered when tempratuere is Lower than a specified value.\" line461=\"     * 気温が指定値より低い場合\" line462=\"     *\" line463=\"     * @param dat Threshold value / しきい値（C）\" line464=\"     * @param body Action to perform / 実行する処理\" line465=\"     */\" line466=\"    //% block=&quot;Temperature / 気温 &gt; %dat&quot; dat.defl=30\" line467=\"    export function TemperatureHigherThan(dat: number, body: () =&gt; void): void {\" line468=\"        control.inBackground(function () {\" line469=\"            while (true) {\" line470=\"                get()\" line471=\"                if (T &gt; dat) {\" line472=\"                    body()\" line473=\"                }\" line474=\"                basic.pause(1000)\" line475=\"            }\" line476=\"        })\" line477=\"    }\" line478=\"\" line479=\"    /**\" line480=\"     * Triggered when humidity is Lower than a specified value. \" line481=\"     * 湿度が指定値より低い場合\" line482=\"     * @param dat Threshold value / しきい値（C）\" line483=\"     * @param body Action to perform / 実行する処理\" line484=\"     */\" line485=\"    //% block=&quot;Humidity / 湿度 &lt; %dat&quot; dat.defl=10\" line486=\"    export function HumidityBelowThan(dat: number, body: () =&gt; void): void {\" line487=\"        control.inBackground(function () {\" line488=\"            while (true) {\" line489=\"                get()\" line490=\"                if (H &lt; dat) {\" line491=\"                    body()\" line492=\"                }\" line493=\"                basic.pause(1000)\" line494=\"            }\" line495=\"        })\" line496=\"    }\" line497=\"\" line498=\"    /**\" line499=\"     * Triggered when humidity is Higher than a specified value. \" line500=\"     * 湿度が指定値より高い場合\" line501=\"     * @param dat Threshold value / しきい値（C）\" line502=\"     * @param body Action to perform / 実行する処理\" line503=\"     */\" line504=\"    //% block=&quot;Humidity / 湿度 &gt; %dat&quot; dat.defl=10\" line505=\"    export function HumidityHigherThan(dat: number, body: () =&gt; void): void {\" line506=\"        control.inBackground(function () {\" line507=\"            while (true) {\" line508=\"                get()\" line509=\"                if (H &gt; dat) {\" line510=\"                    body()\" line511=\"                }\" line512=\"                basic.pause(1000)\" line513=\"            }\" line514=\"        })\" line515=\"    }\" line516=\"\" line517=\"    /**\" line518=\"     * Set the I2C address of the BME280 sensor. / BME280 の I2C アドレスを設定\" line519=\"     * \" line520=\"     *  @param addr I2C address to set / 設定する I2C アドレス\" line521=\"     */\" line522=\"    //% blockId=&quot;BME280_SET_ADDRESS&quot;\" line523=\"    //% block=&quot;I2C Address/I2Cアドレス %addr&quot;\" line524=\"    //% weight=20 blockGap=8\" line525=\"    export function Address(addr: BME280_I2C_ADDRESS) {\" line526=\"        BME280_I2C_ADDR = addr\" line527=\"    }\" line528=\"}\" numlines=\"529\"></mutation></block></statement></block></xml>","main.ts":"namespace BME280 {\n    //Enum Definitions / 列挙型の定義\n    //I2C address/I2Cアドレス\n    export enum BME280_I2C_ADDRESS {\n        //% block=\"0x76\"\n        ADDR_0x76 = 0x76,\n        //% block=\"0x77\"\n        ADDR_0x77 = 0x77\n    }\n\n    //Temperature Unit / 気温の単位\n    // Temperature units: C (Celsius) or F (Fahrenheit) / 温度単位：C（摂氏）または F（華氏）\n    export enum BME280_T {\n        //% block=\"C\"\n        T_C = 0,\n        //% block=\"F\"\n        T_F = 1\n    }\n\n    // Pressure Unit / 気圧の単位\n    // Pressure units: Pa or hPa / 単位：Pa（パスカル）または hPa（ヘクトパスカル）\n    export enum BME280_P {\n        //% block=\"Pa\"\n        Pa = 1,\n        //% block=\"hPa\"\n        hPa = 100\n    }\n\n    // Unit of Elevation difference / 標高差の単位（m/ft）\n    export enum Eldf {\n        //Units meter/単位 メートル\n        //% block=\"m\"\n            altd_m=1,\n        //Units feet/単位 フィート\n        //% block=\"ft\"\n            altd_f = 2\n    }\n   \n    // Numerical precision\n    // 数値の精度\n    // Integer / 1　decimal place / 2 decimal place\n    // 整数 / 小数第1位 / 小数第2位\n    export enum RPoint {\n        //% block=\"Integer/整数\"\n            Rint=1,\n        //% block=\"1 demicl place / 小数第1位\"\n            RPt=10,\n        //% block=\"2 demicl place / 小数第2位\"\n            RPt2=100\n    }\n        \n    /**\n     * Global variables to store the final compensated\n     * temperature, pressure and humidity \n     * temperature\t: unit  °C\n     * pressuere\t: unit Pa\n     * humidity\t\t: unit %\n     * \n     * グローバル変数：補正後の気温・気圧・湿度\n     * 単位　気温：℃　気圧：Pa　湿度：％\n     */\n    let T = 0;\n    let P = 0;\n    let H = 0;\n\n    // Default I2C address: 0x77 / デフォルトの I2C アドレス：0x77\n    let BME280_I2C_ADDR = BME280_I2C_ADDRESS.ADDR_0x76\n\n    // Defining Functions / 関数の定義\n    /** \n     * Functions \"Access to BME280 Registers\"\n     * BME280のレジスタへのアクセスを行う関数群\n     * A set of functions for reading from and writing to BME280\n     * registers via I2C communication.\n     * I2C 通信を用いて、各種レジスタへの読み書きを行う\n     */\n\n    /**\n     * Function \"Writes 1 byte from a register of the BME280\".\n     * BME280のレジスタに1バイトのデータを書き込む関数\n     *\n     * @param reg Register address (integer) / レジストリアドレス（整数値）\n     * @returns dat write (integer) / 書き込んだ値（整数値）\n     * @returns None/戻り値はない\n     *\n     * Creates a 2-byte buffer: the first byte is the register address (buf[0]),\n     * the second byte is the data to write (buf[1]), and sends it via I2C.\n     * レジスタアドレス（buf[0]）と書き込むデータ（buf[1]）を格納した2バイトのバッファを作成し、\n     * I2C を使ってデバイスに送信。\n     */\n    function setreg(reg: number, dat: number): void {\n        let buf = pins.createBuffer(2);\n        buf[0] = reg;\n        buf[1] = dat;\n        pins.i2cWriteBuffer(BME280_I2C_ADDR, buf);\n    }\n\n    /**\n     * Function \"Reads 1 byte from a register of the BME280\".\n     * BME280の任意のレジスタから 1 バイトの値を読み取る関数。\n     *\n     * @param reg Register address (integer) / レジストリアドレス（整数値）\n     * @returns Value read (integer) / 読み取った値（整数値）\n     *\n     * Sends the register address via I2C using UInt8BE format,\n     * then reads 1 byte from the device.\n     * レジストリアドレスを UInt8BE 形式で送信し、1 バイトを読み取って返す。\n     */\n    function getreg(reg: number): number {\n        pins.i2cWriteNumber(BME280_I2C_ADDR, reg, NumberFormat.UInt8BE);\n        return pins.i2cReadNumber(BME280_I2C_ADDR, NumberFormat.UInt8BE);\n    }\n\n    /**\n     * Function \"Reads a 16-bit unsigned integer\".\n     * 8 ビットの符号付き整数を読み取る関数。\n     *\n     * Used for calibration parameters such as dig_H6..\n     * 補正パラメータ dig_H6 に使用。\n     *\n     * @param reg Register address / レジストリアドレス\n     * @returns Unsigned 8-bit integer / 符号付き8ビット整数\n     */\n    function getInt8LE(reg: number): number {\n        pins.i2cWriteNumber(BME280_I2C_ADDR, reg, NumberFormat.UInt8BE);\n        return pins.i2cReadNumber(BME280_I2C_ADDR, NumberFormat.Int8LE);\n    }\n\n    /**\n     * Function \"Reads a 16-bit unsigned integer\".\n     * 16 ビットの符号なし整数を読み取る関数。\n     *\n     * Used for calibration parameters such as dig_T1, dig_P1, etc.\n     * dig_T1、dig_P1 などの補正パラメータ用に使用。\n     *\n     * @param reg Register address / レジストリアドレス\n     * @returns Unsigned 16-bit integer / 符号なし 16 ビット整数\n     */\n    function getUInt16LE(reg: number): number {\n        pins.i2cWriteNumber(BME280_I2C_ADDR, reg, NumberFormat.UInt8BE);\n        return pins.i2cReadNumber(BME280_I2C_ADDR, NumberFormat.UInt16LE);\n    }\n\n    /**\n     * Function \"Reads a 16-bit signed integer\".\n     * 16 ビットの符号付き整数を読み取る関数。\n     * \n     * Used for calibration parameters such as dig_T2, dig_T3, dig_P2.\n     * dig_T2、dig_T3、dig_P2 などの補正パラメータ用に使用します。\n     *\n     * @param reg Register address / レジストリアドレス\n     * @returns Signed 16-bit integer / 符号付き 16 ビット整数\n     */\n    function getInt16LE(reg: number): number {\n        pins.i2cWriteNumber(BME280_I2C_ADDR, reg, NumberFormat.UInt8BE);\n        return pins.i2cReadNumber(BME280_I2C_ADDR, NumberFormat.Int16LE);\n    }\n\n    // Rounding numbers/数値の四捨五入\n    // Integer/demicl 1 place /demicl 2 place\n    // 整数 / 小数第1位 / 小数第２位\n    export function Rnber(dt:number,Rdp:number): number {\n        return Math.round(dt*Rdp)/Rdp\n    }\n\n    // Function \"Get Tempratuer , Pressuer and humidity\".\n    // 気温・気圧・湿度取得の関数\n    /**\n     * BME280 calibration parameters for temperature, pressure and humidity.\n     * BME280 の温度・気圧・湿度補正用キャリブレーションパラメータ。\n     * \n     * Address range: 0x88 to 0xE7 (factory-programmed values)\n     * アドレス範囲：0x88 ～ 0xE7（工場出荷時に書き込まれた補正値）\n     * \n     * Common to BMP280 & BME280 sensors\n     * (excluding humidity-related registers 0xA1 to 0xE7)\n     * BMP280・BME280 センサーで共通\n     *（湿度関連のレジスタ 0xA1 ～ 0xE7は除く）\n     */\n\n    /**\n     * Set \"BME280 calibration parameter registers\"\n     * BME280温度・気圧・湿度補正用キャリブレーションパラメータのレジストリ　\n     * dig_T1 to dig_T3: temperature/気温補正\n     * dig_P1 to dig_P9: pressuere/気圧補正\n     * dig_H1 to dig_H6: humidity/湿度補正\n     */\n    // Temperature calibration parameters / 気温補正用パラメータ\n    let dig_T1 = getUInt16LE(0x88)\n    let dig_T2 = getInt16LE(0x8A)\n    let dig_T3 = getInt16LE(0x8C)\n\n    // Pressure calibration parameters / 気圧補正用パラメータ\n    let dig_P1 = getUInt16LE(0x8E)\n    let dig_P2 = getInt16LE(0x90)\n    let dig_P3 = getInt16LE(0x92)\n    let dig_P4 = getInt16LE(0x94)\n    let dig_P5 = getInt16LE(0x96)\n    let dig_P6 = getInt16LE(0x98)\n    let dig_P7 = getInt16LE(0x9A)\n    let dig_P8 = getInt16LE(0x9C)\n    let dig_P9 = getInt16LE(0x9E)\n\n    // Humidity calibration parameters / 湿度補正用パラメータ   \t\t\n    let dig_H1 = getreg(0xA1)\n    let dig_H2 = getInt16LE(0xE1)\n    let dig_H3 = getreg(0xE3)\n    let a = getreg(0xE5)\n    let dig_H4 = (getreg(0xE4) << 4) + (a % 16)\n    let dig_H5 = (getreg(0xE6) << 4) + (a >> 4)\n    let dig_H6 = getInt8LE(0xE7)\n\n    /**\n     * Sensor configuration:\n     * - Set humidity oversampling to x4 (ctrl_hum, 0xF2)\n     * - Set temperature oversampling to x16, pressure oversampling to x1, normal mode (ctrl_meas, 0xF4)\n     * - Set standby time to 250ms and filter coefficient to x4 (config, 0xF5)\n     *\n     * センサーの設定：\n     * - 湿度のオーバーサンプリングを4倍に設定（ctrl_hum、0xF2）\n     * - 温度のオーバーサンプリングを16倍、気圧を1倍、動作モードをノーマルに設定（ctrl_meas、0xF4）\n     * - スタンバイ時間を250ms、フィルター係数を4倍に設定（config、0xF5）\n     */\n    setreg(0xF2, 0x04)\n    setreg(0xF4, 0x2F)\n    setreg(0xF5, 0x0C)\n\n    /**\n     * Calculate Temperatuer , Pressure and Humidity\n     * 気温・気圧・湿度の算出\n     * Reads raw data from the sensor and calculates\n     * corrected temperature , pressure and humidity.\n     * センサーから生データを読み取り、\n     * 補正済みの気温・気圧・湿度を算出。\n     */\n    function get(): void {\n        // Calculate Temperatuer/気温の計算\n        // Read raw temperature data (20 bits)\n        // 温度の生データ（20ビット）読み取り\n        let adc_T = (getreg(0xFA) << 12) + (getreg(0xFB) << 4) + (getreg(0xFC) >> 4)\n        let var1 = (((adc_T >> 3) - (dig_T1 << 1)) * dig_T2) >> 11\n        let var2 = (((((adc_T >> 4) - dig_T1) * ((adc_T >> 4) - dig_T1)) >> 12) * dig_T3) >> 14\n        let t_fine = var1 + var2;\n        let temp = t_fine;\n        // Calculate corrected temperature(no rounding)\n        // 補正後の気温を計算（数値の丸めなし）\n        T = ((temp * 5 + 128) / 256.0) / 100.0 ;\n\n        // Calculate Pressure/気圧の計算\n        // Read raw pressure data (20 bits)\n        // 気圧の生データ（20ビット）読み取り\n        let adc_P = (getreg(0xF7) << 12) + (getreg(0xF8) << 4) + (getreg(0xF9) >> 4);\n\n        // Pressure compensation calculation\n        // 気圧補正の計算\n        var1 = (t_fine >> 1) - 64000;\n        var2 = (((var1 >> 2) * (var1 >> 2)) >> 11) * dig_P6;\n        var2 = var2 + ((var1 * dig_P5) << 1);\n        var2 = (var2 >> 2) + (dig_P4 << 16);\n        var1 = (((dig_P3 * ((var1 >> 2) * (var1 >> 2)) >> 13) >> 3) + ((dig_P2 * var1) >> 1)) >> 18;\n        var1 = ((32768 + var1) * dig_P1) >> 15;\n        if (var1 == 0) {\n            return; // Prevent division by zero / 0除算防止\n        }\n        let _p = ((1048576 - adc_P) - (var2 >> 12)) * 3125;\n\n        // Calculate Pressure (no rounding)/気圧を算出（数値の丸めなし）\n        _p = (_p / var1) * 2 ;\n        var1 = (dig_P9 * (((_p >> 3) * (_p >> 3)) >> 13)) >> 12;\n        var2 = (((_p >> 2)) * dig_P8) >> 13;\n        P = _p + ((var1 + var2 + dig_P7) >> 4);\n\n        // Calculate Humidity/\t湿度の計算\n        // Read raw pressure data (16 bits)\n        // 湿度の生データ（16ビット）読み取り\n        let adc_H = (getreg(0xFD) << 8) + getreg(0xFE)\n        var1 = t_fine - 76800\n        var2 = (((adc_H << 14) - (dig_H4 << 20) - (dig_H5 * var1)) + 16384) >> 15\n        var1 = var2 * (((((((var1 * dig_H6) >> 10) * (((var1 * dig_H3) >> 11) + 32768)) >> 10) + 2097152) * dig_H2 + 8192) >> 14)\n        var2 = var1 - (((((var1 >> 15) * (var1 >> 15)) >> 7) * dig_H1) >> 4)\n        if (var2 < 0) var2 = 0\n        if (var2 > 419430400) var2 = 419430400\n        // Calculate Humidity (no rounding)/湿度を算出（数値の丸めなし）\n        H = var2 / 4194304.0;\n    }\n    \n    /**\n     *  Get pressure value from BME280 sensor/BME280 センサーから気圧を取得\n     *   \n     *  @param u Pressure unit (Pa or hPa) / 気圧の単位（Pa または hPa）\n     *  @returns Pressure value / 気圧の値（単位に応じた小数第1位）         \n     */\n    //% blockId=\"BME280_GET_PRESSURE\"\n    //% block=\"Pressuer / 気圧 %Pu　Accuracy / 精度 %Prd\"\n    //% weight=80 blockGap=8\n    export function pressure(Pu: BME280_P,Prd: RPoint): number {\n        get();\n        return Rnber(P/Pu,Prd);\n    }\n\n    /**\n     * Get temperature value from BME280 sensor/ BME280 センサーから気温を取得\n     *\n     * @param u Temperature unit (C or F) / 温度の単位（C または F）\n     * @returns Temperature value / 気温の値（単位に応じた小数第1位）\n     */\n    //% blockId=\"BME280_GET_TEMPERATURE\"\n    //% block=\"Tempratuere /気温 %Tu Accuracy / 精度 %Trd\"\n    //% weight=80 blockGap=8\n    export function temperature(Tu: BME280_T, Trd: RPoint): number {\n        get();\n        let tmp=T\n        if (Tu == BME280_T.T_F) { \n            //Fahrenheit degree/華氏\t\n            tmp = T * 9 / 5 + 32;\n        }\n        return Rnber(tmp , Trd);\n    }\n\n    /**\n     * Get humidity value from BME280 sensor / BME280 センサーから湿度を取得\n     *\n     * @param u Humidity unit % / 湿度の単位 %\n     * @returns Temperature value / 湿度の値（小数第1位）\n     */\n    //% blockId=\"BME280_GET_HUMIDITY\"\n    //% block=\"Humidity / 湿度 精度 %Hrd\"\n    //% weight=80 blockGap=8\n    export function humidity(Hrd:RPoint): number {\n        get();\n        return Rnber(H,Hrd);\n    }\n    //Sensor power control (Power ON and OFF)\n    //センサーの電源管理（起動と停止）\n    /**\n     * power on / センサー起動\n     */\n    //% blockId=\"BME280_POWER_ON\" block=\"\n    //% block=\"Power On Sensor /センサー起動\"\"\n    //% weight=22 blockGap=8\n    export function PowerOn() {\n        setreg(0xF4, 0x2F)\n    }\n\n    /**\n     * power oFF　センサー停止\n     */\n    //% blockId=\"BME280_POWER_OFF\"\n    //% block=\"Power OFF Sensor/センサー停止\"\n    //% weight=21 blockGap=8\n    export function PowerOff() {\n        setreg(0xF4, 0)\n    }\n\n    /**\n     * Calculate Elevation difference /標高差の計算\n     * Input the reference point pressure P0 into the block\n     * Get the current pressure and temperature from the sensor.\n     * 基準点の気圧P0をブロックに入力\n     * 現在の気圧・気温はセンサ-から取得\n     */\n    //% block=\"Elevation difference(標高差) %ELU Pressure (reference point)(気圧(基準点)) %P0 %uP0\"\n    //% blockId=\"Elevation_difference\"\n    //% weight=80  blockGap=8\n    export function getElevationdifference(Elu:Eldf,P0: number, uP0: BME280_P):number {\n        get();\n        // Eprs:Current Pressure / 現地点の気圧\n        let Eprs = P    \n         // Etemp:Current Temperatuer（kelvin） /　現地点の気温（絶対温度）\n        let Etemp = T+273.15 //Celsius->kelvin　/ 摂氏－＞絶対温度\n        // Unification of units /単位の統一\n        // If the unit of the pressure P0 at the reference point is Pa, multiply P0 by 1. \n        // If the unit is hPa, multiply P0 by 100.\n        // 基準点の気圧P0の単位がPaならそのまま、hPaなら1/100\n        // uP0:P->1 hPa->1/100\n        Eprs = Eprs *1/uP0 \n        // Calculate Elevation difference / 標高差計算\n        // 0.0065-> Tropospheric temperature lapse rate (0.65℃/100m) \n        // 0.0065-> 対流圏の気温減率（0.65℃/100ｍ）\n        let rt=((P0/Eprs)**(1/5.257)-1)*Etemp\n        //　Calculate Elevation difference / 標高差を算出 (Units/単位:m)\n        let Diffelev=rt/0.0065\n        // Convert values ​​according to altitude units /高度の単位に応じて数値を変換\n        if(Elu==2){\n            Diffelev=Diffelev*3.2808;}\n         return Rnber(Diffelev,10);\n    }\n\n    /**\n     * Calculate Dewpoint　露点計算\n     */\n    //% block=\"Dewpoint / 露点\"\n    //% weight=60 blockGap=8\n    export function Dewpoint(Drd:RPoint): number {\n        get();\n        return T - Math.idiv(100 - H, 5)\n    }\n\n    /**\n     * Event Block\n     * イベントブロック\n    */\n    /**\n     * Triggered when pressure is Lower than a specified value. / 気圧が指定値より低い場合\n     *\n     * @param dat Threshold value / しきい値（Pa）\n     * @param body Action to perform / 実行する処理\n     */\n    //% block=\"Pressuer / 気圧 <  %dat\" dat.defl=100000\n    export function PressureBelowThan(dat: number, body: () => void): void {\n        control.inBackground(function () {\n            while (true) {\n                get()\n                if (P < dat) {\n                    body()\n                }\n                basic.pause(1000)\n            }\n        })\n    }\n\n    /**\n     * Triggered when pressure is Higher than a specified value.\n     * 気圧が指定値より高い場合\n     * @param dat Threshold value / しきい値（Pa）\n     * @param body Action to perform / 実行する処理\n     */\n    //% block=\"Pressuer / 気圧 > %dat\" dat.defl=100000\n    export function PressureHigherThan(dat: number, body: () => void): void {\n        control.inBackground(function () {\n            while (true) {\n                get()\n                if (P > dat) {\n                    body()\n                }\n                basic.pause(1000)\n            }\n        })\n    }\n\n    /**\n     * Triggered when temprature is Lower than a specified value. \n     *  気温が指定値より低い場合\n     *\n     * @param dat Threshold value / しきい値（C）\n     * @param body Action to perform / 実行する処理\n     */\n    //% block=\"Temperature / 気温 < %dat\" dat.defl=10\n    export function TemperatureBelowThan(dat: number, body: () => void): void {\n        control.inBackground(function () {\n            while (true) {\n                get()\n                if (T < dat) {\n                    body()\n                }\n                basic.pause(1000)\n            }\n        })\n    }\n\n    /**\n     * Triggered when tempratuere is Lower than a specified value.\n     * 気温が指定値より低い場合\n     *\n     * @param dat Threshold value / しきい値（C）\n     * @param body Action to perform / 実行する処理\n     */\n    //% block=\"Temperature / 気温 > %dat\" dat.defl=30\n    export function TemperatureHigherThan(dat: number, body: () => void): void {\n        control.inBackground(function () {\n            while (true) {\n                get()\n                if (T > dat) {\n                    body()\n                }\n                basic.pause(1000)\n            }\n        })\n    }\n\n    /**\n     * Triggered when humidity is Lower than a specified value. \n     * 湿度が指定値より低い場合\n     * @param dat Threshold value / しきい値（C）\n     * @param body Action to perform / 実行する処理\n     */\n    //% block=\"Humidity / 湿度 < %dat\" dat.defl=10\n    export function HumidityBelowThan(dat: number, body: () => void): void {\n        control.inBackground(function () {\n            while (true) {\n                get()\n                if (H < dat) {\n                    body()\n                }\n                basic.pause(1000)\n            }\n        })\n    }\n\n    /**\n     * Triggered when humidity is Higher than a specified value. \n     * 湿度が指定値より高い場合\n     * @param dat Threshold value / しきい値（C）\n     * @param body Action to perform / 実行する処理\n     */\n    //% block=\"Humidity / 湿度 > %dat\" dat.defl=10\n    export function HumidityHigherThan(dat: number, body: () => void): void {\n        control.inBackground(function () {\n            while (true) {\n                get()\n                if (H > dat) {\n                    body()\n                }\n                basic.pause(1000)\n            }\n        })\n    }\n\n    /**\n     * Set the I2C address of the BME280 sensor. / BME280 の I2C アドレスを設定\n     * \n     *  @param addr I2C address to set / 設定する I2C アドレス\n     */\n    //% blockId=\"BME280_SET_ADDRESS\"\n    //% block=\"I2C Address/I2Cアドレス %addr\"\n    //% weight=20 blockGap=8\n    export function Address(addr: BME280_I2C_ADDRESS) {\n        BME280_I2C_ADDR = addr\n    }\n}\n","README.md":"","pxt.json":"{\n    \"name\": \"拡張機能確認\",\n    \"description\": \"\",\n    \"dependencies\": {\n        \"core\": \"*\",\n        \"radio\": \"*\",\n        \"microphone\": \"*\"\n    },\n    \"files\": [\n        \"main.blocks\",\n        \"main.ts\",\n        \"README.md\"\n    ],\n    \"preferredEditor\": \"tsprj\"\n}\n"}},{"timestamp":1745967994857,"editorVersion":"7.0.61","text":{"main.blocks":"<xml xmlns=\"https://developers.google.com/blockly/xml\"><variables></variables><block type=\"pxt-on-start\" x=\"0\" y=\"0\"><statement name=\"HANDLER\"><block type=\"typescript_statement\"><mutation xmlns=\"http://www.w3.org/1999/xhtml\" line0=\"namespace BME280 {\" line1=\"    //Enum Definitions / 列挙型の定義\" line2=\"    //I2C address/I2Cアドレス\" line3=\"    export enum BME280_I2C_ADDRESS {\" line4=\"        //% block=&quot;0x76&quot;\" line5=\"        ADDR_0x76 = 0x76,\" line6=\"        //% block=&quot;0x77&quot;\" line7=\"        ADDR_0x77 = 0x77\" line8=\"    }\" line9=\"\" line10=\"    //Temperature Unit / 気温の単位\" line11=\"    // Temperature units: C (Celsius) or F (Fahrenheit) / 温度単位：C（摂氏）または F（華氏）\" line12=\"    export enum BME280_T {\" line13=\"        //% block=&quot;C&quot;\" line14=\"        T_C = 0,\" line15=\"        //% block=&quot;F&quot;\" line16=\"        T_F = 1\" line17=\"    }\" line18=\"\" line19=\"    // Pressure Unit / 気圧の単位\" line20=\"    // Pressure units: Pa or hPa / 単位：Pa（パスカル）または hPa（ヘクトパスカル）\" line21=\"    export enum BME280_P {\" line22=\"        //% block=&quot;Pa&quot;\" line23=\"        Pa = 1,\" line24=\"        //% block=&quot;hPa&quot;\" line25=\"        hPa = 100\" line26=\"    }\" line27=\"\" line28=\"    // Unit of Elevation difference / 標高差の単位（m/ft）\" line29=\"    export enum Eldf {\" line30=\"        //Units meter/単位 メートル\" line31=\"        //% block=&quot;m&quot;\" line32=\"            altd_m=1,\" line33=\"        //Units feet/単位 フィート\" line34=\"        //% block=&quot;ft&quot;\" line35=\"            altd_f = 1/0.3048\" line36=\"    }\" line37=\"   \" line38=\"    // Numerical precision\" line39=\"    // 数値の精度\" line40=\"    // Integer / 1　decimal place / 2 decimal place\" line41=\"    // 整数 / 小数第1位 / 小数第2位\" line42=\"    export enum RPoint {\" line43=\"        //% block=&quot;Integer/整数&quot;\" line44=\"            Rint=1,\" line45=\"        //% block=&quot;1 demicl place / 小数第1位&quot;\" line46=\"            RPt=10,\" line47=\"        //% block=&quot;2 demicl place / 小数第2位&quot;\" line48=\"            RPt2=100\" line49=\"    }\" line50=\"        \" line51=\"    /**\" line52=\"     * Global variables to store the final compensated\" line53=\"     * temperature, pressure and humidity \" line54=\"     * temperature&#9;: unit  °C\" line55=\"     * pressuere&#9;: unit Pa\" line56=\"     * humidity&#9;&#9;: unit %\" line57=\"     * \" line58=\"     * グローバル変数：補正後の気温・気圧・湿度\" line59=\"     * 単位　気温：℃　気圧：Pa　湿度：％\" line60=\"     */\" line61=\"    let T = 0;\" line62=\"    let P = 0;\" line63=\"    let H = 0;\" line64=\"\" line65=\"    // Default I2C address: 0x77 / デフォルトの I2C アドレス：0x77\" line66=\"    let BME280_I2C_ADDR = BME280_I2C_ADDRESS.ADDR_0x76\" line67=\"\" line68=\"    // Defining Functions / 関数の定義\" line69=\"    /** \" line70=\"     * Functions &quot;Access to BME280 Registers&quot;\" line71=\"     * BME280のレジスタへのアクセスを行う関数群\" line72=\"     * A set of functions for reading from and writing to BME280\" line73=\"     * registers via I2C communication.\" line74=\"     * I2C 通信を用いて、各種レジスタへの読み書きを行う\" line75=\"     */\" line76=\"\" line77=\"    /**\" line78=\"     * Function &quot;Writes 1 byte from a register of the BME280&quot;.\" line79=\"     * BME280のレジスタに1バイトのデータを書き込む関数\" line80=\"     *\" line81=\"     * @param reg Register address (integer) / レジストリアドレス（整数値）\" line82=\"     * @returns dat write (integer) / 書き込んだ値（整数値）\" line83=\"     * @returns None/戻り値はない\" line84=\"     *\" line85=\"     * Creates a 2-byte buffer: the first byte is the register address (buf[0]),\" line86=\"     * the second byte is the data to write (buf[1]), and sends it via I2C.\" line87=\"     * レジスタアドレス（buf[0]）と書き込むデータ（buf[1]）を格納した2バイトのバッファを作成し、\" line88=\"     * I2C を使ってデバイスに送信。\" line89=\"     */\" line90=\"    function setreg(reg: number, dat: number): void {\" line91=\"        let buf = pins.createBuffer(2);\" line92=\"        buf[0] = reg;\" line93=\"        buf[1] = dat;\" line94=\"        pins.i2cWriteBuffer(BME280_I2C_ADDR, buf);\" line95=\"    }\" line96=\"\" line97=\"    /**\" line98=\"     * Function &quot;Reads 1 byte from a register of the BME280&quot;.\" line99=\"     * BME280の任意のレジスタから 1 バイトの値を読み取る関数。\" line100=\"     *\" line101=\"     * @param reg Register address (integer) / レジストリアドレス（整数値）\" line102=\"     * @returns Value read (integer) / 読み取った値（整数値）\" line103=\"     *\" line104=\"     * Sends the register address via I2C using UInt8BE format,\" line105=\"     * then reads 1 byte from the device.\" line106=\"     * レジストリアドレスを UInt8BE 形式で送信し、1 バイトを読み取って返す。\" line107=\"     */\" line108=\"    function getreg(reg: number): number {\" line109=\"        pins.i2cWriteNumber(BME280_I2C_ADDR, reg, NumberFormat.UInt8BE);\" line110=\"        return pins.i2cReadNumber(BME280_I2C_ADDR, NumberFormat.UInt8BE);\" line111=\"    }\" line112=\"\" line113=\"    /**\" line114=\"     * Function &quot;Reads a 16-bit unsigned integer&quot;.\" line115=\"     * 8 ビットの符号付き整数を読み取る関数。\" line116=\"     *\" line117=\"     * Used for calibration parameters such as dig_H6..\" line118=\"     * 補正パラメータ dig_H6 に使用。\" line119=\"     *\" line120=\"     * @param reg Register address / レジストリアドレス\" line121=\"     * @returns Unsigned 8-bit integer / 符号付き8ビット整数\" line122=\"     */\" line123=\"    function getInt8LE(reg: number): number {\" line124=\"        pins.i2cWriteNumber(BME280_I2C_ADDR, reg, NumberFormat.UInt8BE);\" line125=\"        return pins.i2cReadNumber(BME280_I2C_ADDR, NumberFormat.Int8LE);\" line126=\"    }\" line127=\"\" line128=\"    /**\" line129=\"     * Function &quot;Reads a 16-bit unsigned integer&quot;.\" line130=\"     * 16 ビットの符号なし整数を読み取る関数。\" line131=\"     *\" line132=\"     * Used for calibration parameters such as dig_T1, dig_P1, etc.\" line133=\"     * dig_T1、dig_P1 などの補正パラメータ用に使用。\" line134=\"     *\" line135=\"     * @param reg Register address / レジストリアドレス\" line136=\"     * @returns Unsigned 16-bit integer / 符号なし 16 ビット整数\" line137=\"     */\" line138=\"    function getUInt16LE(reg: number): number {\" line139=\"        pins.i2cWriteNumber(BME280_I2C_ADDR, reg, NumberFormat.UInt8BE);\" line140=\"        return pins.i2cReadNumber(BME280_I2C_ADDR, NumberFormat.UInt16LE);\" line141=\"    }\" line142=\"\" line143=\"    /**\" line144=\"     * Function &quot;Reads a 16-bit signed integer&quot;.\" line145=\"     * 16 ビットの符号付き整数を読み取る関数。\" line146=\"     * \" line147=\"     * Used for calibration parameters such as dig_T2, dig_T3, dig_P2.\" line148=\"     * dig_T2、dig_T3、dig_P2 などの補正パラメータ用に使用します。\" line149=\"     *\" line150=\"     * @param reg Register address / レジストリアドレス\" line151=\"     * @returns Signed 16-bit integer / 符号付き 16 ビット整数\" line152=\"     */\" line153=\"    function getInt16LE(reg: number): number {\" line154=\"        pins.i2cWriteNumber(BME280_I2C_ADDR, reg, NumberFormat.UInt8BE);\" line155=\"        return pins.i2cReadNumber(BME280_I2C_ADDR, NumberFormat.Int16LE);\" line156=\"    }\" line157=\"\" line158=\"    // Rounding numbers/数値の四捨五入\" line159=\"    // Integer/demicl 1 place /demicl 2 place\" line160=\"    // 整数 / 小数第1位 / 小数第２位\" line161=\"    export function Rnber(dt:number,Rdp:number): number {\" line162=\"        return Math.round(dt*Rdp)/Rdp\" line163=\"    }\" line164=\"\" line165=\"    // Function &quot;Get Tempratuer , Pressuer and humidity&quot;.\" line166=\"    // 気温・気圧・湿度取得の関数\" line167=\"    /**\" line168=\"     * BME280 calibration parameters for temperature, pressure and humidity.\" line169=\"     * BME280 の温度・気圧・湿度補正用キャリブレーションパラメータ。\" line170=\"     * \" line171=\"     * Address range: 0x88 to 0xE7 (factory-programmed values)\" line172=\"     * アドレス範囲：0x88 ～ 0xE7（工場出荷時に書き込まれた補正値）\" line173=\"     * \" line174=\"     * Common to BMP280 &amp; BME280 sensors\" line175=\"     * (excluding humidity-related registers 0xA1 to 0xE7)\" line176=\"     * BMP280・BME280 センサーで共通\" line177=\"     *（湿度関連のレジスタ 0xA1 ～ 0xE7は除く）\" line178=\"     */\" line179=\"\" line180=\"    /**\" line181=\"     * Set &quot;BME280 calibration parameter registers&quot;\" line182=\"     * BME280温度・気圧・湿度補正用キャリブレーションパラメータのレジストリ　\" line183=\"     * dig_T1 to dig_T3: temperature/気温補正\" line184=\"     * dig_P1 to dig_P9: pressuere/気圧補正\" line185=\"     * dig_H1 to dig_H6: humidity/湿度補正\" line186=\"     */\" line187=\"    // Temperature calibration parameters / 気温補正用パラメータ\" line188=\"    let dig_T1 = getUInt16LE(0x88)\" line189=\"    let dig_T2 = getInt16LE(0x8A)\" line190=\"    let dig_T3 = getInt16LE(0x8C)\" line191=\"\" line192=\"    // Pressure calibration parameters / 気圧補正用パラメータ\" line193=\"    let dig_P1 = getUInt16LE(0x8E)\" line194=\"    let dig_P2 = getInt16LE(0x90)\" line195=\"    let dig_P3 = getInt16LE(0x92)\" line196=\"    let dig_P4 = getInt16LE(0x94)\" line197=\"    let dig_P5 = getInt16LE(0x96)\" line198=\"    let dig_P6 = getInt16LE(0x98)\" line199=\"    let dig_P7 = getInt16LE(0x9A)\" line200=\"    let dig_P8 = getInt16LE(0x9C)\" line201=\"    let dig_P9 = getInt16LE(0x9E)\" line202=\"\" line203=\"    // Humidity calibration parameters / 湿度補正用パラメータ   &#9;&#9;\" line204=\"    let dig_H1 = getreg(0xA1)\" line205=\"    let dig_H2 = getInt16LE(0xE1)\" line206=\"    let dig_H3 = getreg(0xE3)\" line207=\"    let a = getreg(0xE5)\" line208=\"    let dig_H4 = (getreg(0xE4) &lt;&lt; 4) + (a % 16)\" line209=\"    let dig_H5 = (getreg(0xE6) &lt;&lt; 4) + (a &gt;&gt; 4)\" line210=\"    let dig_H6 = getInt8LE(0xE7)\" line211=\"\" line212=\"    /**\" line213=\"     * Sensor configuration:\" line214=\"     * - Set humidity oversampling to x4 (ctrl_hum, 0xF2)\" line215=\"     * - Set temperature oversampling to x16, pressure oversampling to x1, normal mode (ctrl_meas, 0xF4)\" line216=\"     * - Set standby time to 250ms and filter coefficient to x4 (config, 0xF5)\" line217=\"     *\" line218=\"     * センサーの設定：\" line219=\"     * - 湿度のオーバーサンプリングを4倍に設定（ctrl_hum、0xF2）\" line220=\"     * - 温度のオーバーサンプリングを16倍、気圧を1倍、動作モードをノーマルに設定（ctrl_meas、0xF4）\" line221=\"     * - スタンバイ時間を250ms、フィルター係数を4倍に設定（config、0xF5）\" line222=\"     */\" line223=\"    setreg(0xF2, 0x04)\" line224=\"    setreg(0xF4, 0x2F)\" line225=\"    setreg(0xF5, 0x0C)\" line226=\"\" line227=\"    /**\" line228=\"     * Calculate Temperatuer , Pressure and Humidity\" line229=\"     * 気温・気圧・湿度の算出\" line230=\"     * Reads raw data from the sensor and calculates\" line231=\"     * corrected temperature , pressure and humidity.\" line232=\"     * センサーから生データを読み取り、\" line233=\"     * 補正済みの気温・気圧・湿度を算出。\" line234=\"     */\" line235=\"    function get(): void {\" line236=\"        // Calculate Temperatuer/気温の計算\" line237=\"        // Read raw temperature data (20 bits)\" line238=\"        // 温度の生データ（20ビット）読み取り\" line239=\"        let adc_T = (getreg(0xFA) &lt;&lt; 12) + (getreg(0xFB) &lt;&lt; 4) + (getreg(0xFC) &gt;&gt; 4)\" line240=\"        let var1 = (((adc_T &gt;&gt; 3) - (dig_T1 &lt;&lt; 1)) * dig_T2) &gt;&gt; 11\" line241=\"        let var2 = (((((adc_T &gt;&gt; 4) - dig_T1) * ((adc_T &gt;&gt; 4) - dig_T1)) &gt;&gt; 12) * dig_T3) &gt;&gt; 14\" line242=\"        let t_fine = var1 + var2;\" line243=\"        let temp = t_fine;\" line244=\"        // Calculate corrected temperature(no rounding)\" line245=\"        // 補正後の気温を計算（数値の丸めなし）\" line246=\"        T = ((temp * 5 + 128) / 256.0) / 100.0 ;\" line247=\"\" line248=\"        // Calculate Pressure/気圧の計算\" line249=\"        // Read raw pressure data (20 bits)\" line250=\"        // 気圧の生データ（20ビット）読み取り\" line251=\"        let adc_P = (getreg(0xF7) &lt;&lt; 12) + (getreg(0xF8) &lt;&lt; 4) + (getreg(0xF9) &gt;&gt; 4);\" line252=\"\" line253=\"        // Pressure compensation calculation\" line254=\"        // 気圧補正の計算\" line255=\"        var1 = (t_fine &gt;&gt; 1) - 64000;\" line256=\"        var2 = (((var1 &gt;&gt; 2) * (var1 &gt;&gt; 2)) &gt;&gt; 11) * dig_P6;\" line257=\"        var2 = var2 + ((var1 * dig_P5) &lt;&lt; 1);\" line258=\"        var2 = (var2 &gt;&gt; 2) + (dig_P4 &lt;&lt; 16);\" line259=\"        var1 = (((dig_P3 * ((var1 &gt;&gt; 2) * (var1 &gt;&gt; 2)) &gt;&gt; 13) &gt;&gt; 3) + ((dig_P2 * var1) &gt;&gt; 1)) &gt;&gt; 18;\" line260=\"        var1 = ((32768 + var1) * dig_P1) &gt;&gt; 15;\" line261=\"        if (var1 == 0) {\" line262=\"            return; // Prevent division by zero / 0除算防止\" line263=\"        }\" line264=\"        let _p = ((1048576 - adc_P) - (var2 &gt;&gt; 12)) * 3125;\" line265=\"\" line266=\"        // Calculate Pressure (no rounding)/気圧を算出（数値の丸めなし）\" line267=\"        _p = (_p / var1) * 2 ;\" line268=\"        var1 = (dig_P9 * (((_p &gt;&gt; 3) * (_p &gt;&gt; 3)) &gt;&gt; 13)) &gt;&gt; 12;\" line269=\"        var2 = (((_p &gt;&gt; 2)) * dig_P8) &gt;&gt; 13;\" line270=\"        P = _p + ((var1 + var2 + dig_P7) &gt;&gt; 4);\" line271=\"\" line272=\"        // Calculate Humidity/&#9;湿度の計算\" line273=\"        // Read raw pressure data (16 bits)\" line274=\"        // 湿度の生データ（16ビット）読み取り\" line275=\"        let adc_H = (getreg(0xFD) &lt;&lt; 8) + getreg(0xFE)\" line276=\"        var1 = t_fine - 76800\" line277=\"        var2 = (((adc_H &lt;&lt; 14) - (dig_H4 &lt;&lt; 20) - (dig_H5 * var1)) + 16384) &gt;&gt; 15\" line278=\"        var1 = var2 * (((((((var1 * dig_H6) &gt;&gt; 10) * (((var1 * dig_H3) &gt;&gt; 11) + 32768)) &gt;&gt; 10) + 2097152) * dig_H2 + 8192) &gt;&gt; 14)\" line279=\"        var2 = var1 - (((((var1 &gt;&gt; 15) * (var1 &gt;&gt; 15)) &gt;&gt; 7) * dig_H1) &gt;&gt; 4)\" line280=\"        if (var2 &lt; 0) var2 = 0\" line281=\"        if (var2 &gt; 419430400) var2 = 419430400\" line282=\"        // Calculate Humidity (no rounding)/湿度を算出（数値の丸めなし）\" line283=\"        H = var2 / 4194304.0\" line284=\"    }\" line285=\"    \" line286=\"    /**\" line287=\"     *  Get pressure value from BME280 sensor/BME280 センサーから気圧を取得\" line288=\"     *   \" line289=\"     *  @param u Pressure unit (Pa or hPa) / 気圧の単位（Pa または hPa）\" line290=\"     *  @returns Pressure value / 気圧の値（単位に応じた小数第1位）         \" line291=\"     */\" line292=\"    //% blockId=&quot;BME280_GET_PRESSURE&quot;\" line293=\"    //% block=&quot;Pressuer / 気圧 %Pu　Accuracy / 精度 %Prd&quot;\" line294=\"    //% weight=80 blockGap=8\" line295=\"    export function pressure(Pu: BME280_P,Prd: RPoint): number {\" line296=\"        get();\" line297=\"        return Rnber(P/Pu,Prd)\" line298=\"    }\" line299=\"\" line300=\"    /**\" line301=\"     * Get temperature value from BME280 sensor/ BME280 センサーから気温を取得\" line302=\"     *\" line303=\"     * @param u Temperature unit (C or F) / 温度の単位（C または F）\" line304=\"     * @returns Temperature value / 気温の値（単位に応じた小数第1位）\" line305=\"     */\" line306=\"    //% blockId=&quot;BME280_GET_TEMPERATURE&quot;\" line307=\"    //% block=&quot;Tempratuere /気温 %Tu Accuracy / 精度 %Trd&quot;\" line308=\"    //% weight=80 blockGap=8\" line309=\"    export function temperature(Tu: BME280_T, Trd: RPoint): number {\" line310=\"        get();\" line311=\"        let tmp=T\" line312=\"        if (Tu == BME280_T.T_F) { \" line313=\"            //Fahrenheit degree/華氏&#9;\" line314=\"            tmp = T * 9 / 5 + 32;\" line315=\"        }\" line316=\"        return Rnber(tmp , Trd)\" line317=\"    }\" line318=\"\" line319=\"    /**\" line320=\"     * Get humidity value from BME280 sensor / BME280 センサーから湿度を取得\" line321=\"     *\" line322=\"     * @param u Humidity unit % / 湿度の単位 %\" line323=\"     * @returns Temperature value / 湿度の値（小数第1位）\" line324=\"     */\" line325=\"    //% blockId=&quot;BME280_GET_HUMIDITY&quot;\" line326=\"    //% block=&quot;Humidity / 湿度 精度 %Hrd&quot;\" line327=\"    //% weight=80 blockGap=8\" line328=\"    export function humidity(Hrd:RPoint): number {\" line329=\"        get();\" line330=\"        return Rnber(H,Hrd);\" line331=\"    }\" line332=\"    //Sensor power control (Power ON and OFF)\" line333=\"    //センサーの電源管理（起動と停止）\" line334=\"    /**\" line335=\"     * power on / センサー起動\" line336=\"     */\" line337=\"    //% blockId=&quot;BME280_POWER_ON&quot; block=&quot;\" line338=\"    //% block=&quot;Power On Sensor /センサー起動&quot;&quot;\" line339=\"    //% weight=22 blockGap=8\" line340=\"    export function PowerOn() {\" line341=\"        setreg(0xF4, 0x2F)\" line342=\"    }\" line343=\"\" line344=\"    /**\" line345=\"     * power oFF　センサー停止\" line346=\"     */\" line347=\"    //% blockId=&quot;BME280_POWER_OFF&quot;\" line348=\"    //% block=&quot;Power OFF Sensor/センサー停止&quot;\" line349=\"    //% weight=21 blockGap=8\" line350=\"    export function PowerOff() {\" line351=\"        setreg(0xF4, 0)\" line352=\"    }\" line353=\"\" line354=\"    /**\" line355=\"     * Calculate Elevation difference /標高差の計算\" line356=\"     * Input the reference point pressure P0 into the block\" line357=\"     * Get the current pressure and temperature from the sensor.\" line358=\"     * 基準点の気圧P0をブロックに入力\" line359=\"     * 現在の気圧・気温はセンサ-から取得\" line360=\"     */\" line361=\"    //% block=&quot;Elevation difference(標高差) %ELU Pressure (reference point)(気圧(基準点)) %P0 %uP0&quot;\" line362=\"    //% blockId=&quot;Elevation_difference&quot;\" line363=\"    //% weight=80  blockGap=8\" line364=\"    export function getElevationdifference(Elu:Eldf,P0: number, uP0: BME280_P):number {\" line365=\"        get();\" line366=\"        // Eprs:Current Pressure / 現地点の気圧\" line367=\"        let Eprs = P    \" line368=\"         // Etemp:Current Temperatuer（kelvin） /　現地点の気温（絶対温度）\" line369=\"        let Etemp = T+273.15 //Celsius-&gt;kelvin　/ 摂氏－＞絶対温度\" line370=\"        // Unification of units /単位の統一\" line371=\"        // If the unit of the pressure P0 at the reference point is Pa, multiply P0 by 1. \" line372=\"        // If the unit is hPa, multiply P0 by 100.\" line373=\"        // 基準点の気圧P0の単位がPaならそのまま、hPaなら1/100\" line374=\"        // uP0:P-&gt;1 hPa-&gt;1/100\" line375=\"        Eprs = Eprs *1/uP0 \" line376=\"        // Calculate Elevation difference / 標高差計算\" line377=\"        // 0.0065-&gt; Tropospheric temperature lapse rate (0.65℃/100m) \" line378=\"        // 0.0065-&gt; 対流圏の気温減率（0.65℃/100ｍ）\" line379=\"        let rt=((P0/Eprs)**(1/5.257)-1)*Etemp\" line380=\"        //　Calculate Elevation difference / 標高差を算出 (Units/単位:m)\" line381=\"        let Diffelev=rt/0.0065\" line382=\"        // Convert values ​​according to altitude units /高度の単位に応じて数値を変換\" line383=\"\" line384=\"         return Rnber(Diffelev*Elu,10)\" line385=\"    }\" line386=\"\" line387=\"    /**\" line388=\"     * Calculate Dewpoint　露点計算\" line389=\"     */\" line390=\"    //% block=&quot;Dewpoint / 露点&quot;\" line391=\"    //% weight=60 blockGap=8\" line392=\"    export function Dewpoint(Drd:RPoint): number {\" line393=\"        get();\" line394=\"        return T - Math.idiv(100 - H, 5)\" line395=\"    }\" line396=\"\" line397=\"    /**\" line398=\"     * Event Block\" line399=\"     * イベントブロック\" line400=\"    */\" line401=\"    /**\" line402=\"     * Triggered when pressure is Lower than a specified value. / 気圧が指定値より低い場合\" line403=\"     *\" line404=\"     * @param dat Threshold value / しきい値（Pa）\" line405=\"     * @param body Action to perform / 実行する処理\" line406=\"     */\" line407=\"    //% block=&quot;Pressuer / 気圧 &lt;  %dat&quot; dat.defl=100000\" line408=\"    export function PressureBelowThan(dat: number, body: () =&gt; void): void {\" line409=\"        control.inBackground(function () {\" line410=\"            while (true) {\" line411=\"                get()\" line412=\"                if (P &lt; dat) {\" line413=\"                    body()\" line414=\"                }\" line415=\"                basic.pause(1000)\" line416=\"            }\" line417=\"        })\" line418=\"    }\" line419=\"\" line420=\"    /**\" line421=\"     * Triggered when pressure is Higher than a specified value.\" line422=\"     * 気圧が指定値より高い場合\" line423=\"     * @param dat Threshold value / しきい値（Pa）\" line424=\"     * @param body Action to perform / 実行する処理\" line425=\"     */\" line426=\"    //% block=&quot;Pressuer / 気圧 &gt; %dat&quot; dat.defl=100000\" line427=\"    export function PressureHigherThan(dat: number, body: () =&gt; void): void {\" line428=\"        control.inBackground(function () {\" line429=\"            while (true) {\" line430=\"                get()\" line431=\"                if (P &gt; dat) {\" line432=\"                    body()\" line433=\"                }\" line434=\"                basic.pause(1000)\" line435=\"            }\" line436=\"        })\" line437=\"    }\" line438=\"\" line439=\"    /**\" line440=\"     * Triggered when temprature is Lower than a specified value. \" line441=\"     *  気温が指定値より低い場合\" line442=\"     *\" line443=\"     * @param dat Threshold value / しきい値（C）\" line444=\"     * @param body Action to perform / 実行する処理\" line445=\"     */\" line446=\"    //% block=&quot;Temperature / 気温 &lt; %dat&quot; dat.defl=10\" line447=\"    export function TemperatureBelowThan(dat: number, body: () =&gt; void): void {\" line448=\"        control.inBackground(function () {\" line449=\"            while (true) {\" line450=\"                get()\" line451=\"                if (T &lt; dat) {\" line452=\"                    body()\" line453=\"                }\" line454=\"                basic.pause(1000)\" line455=\"            }\" line456=\"        })\" line457=\"    }\" line458=\"\" line459=\"    /**\" line460=\"     * Triggered when tempratuere is Lower than a specified value.\" line461=\"     * 気温が指定値より低い場合\" line462=\"     *\" line463=\"     * @param dat Threshold value / しきい値（C）\" line464=\"     * @param body Action to perform / 実行する処理\" line465=\"     */\" line466=\"    //% block=&quot;Temperature / 気温 &gt; %dat&quot; dat.defl=30\" line467=\"    export function TemperatureHigherThan(dat: number, body: () =&gt; void): void {\" line468=\"        control.inBackground(function () {\" line469=\"            while (true) {\" line470=\"                get()\" line471=\"                if (T &gt; dat) {\" line472=\"                    body()\" line473=\"                }\" line474=\"                basic.pause(1000)\" line475=\"            }\" line476=\"        })\" line477=\"    }\" line478=\"\" line479=\"    /**\" line480=\"     * Triggered when humidity is Lower than a specified value. \" line481=\"     * 湿度が指定値より低い場合\" line482=\"     * @param dat Threshold value / しきい値（C）\" line483=\"     * @param body Action to perform / 実行する処理\" line484=\"     */\" line485=\"    //% block=&quot;Humidity / 湿度 &lt; %dat&quot; dat.defl=10\" line486=\"    export function HumidityBelowThan(dat: number, body: () =&gt; void): void {\" line487=\"        control.inBackground(function () {\" line488=\"            while (true) {\" line489=\"                get()\" line490=\"                if (H &lt; dat) {\" line491=\"                    body()\" line492=\"                }\" line493=\"                basic.pause(1000)\" line494=\"            }\" line495=\"        })\" line496=\"    }\" line497=\"\" line498=\"    /**\" line499=\"     * Triggered when humidity is Higher than a specified value. \" line500=\"     * 湿度が指定値より高い場合\" line501=\"     * @param dat Threshold value / しきい値（C）\" line502=\"     * @param body Action to perform / 実行する処理\" line503=\"     */\" line504=\"    //% block=&quot;Humidity / 湿度 &gt; %dat&quot; dat.defl=10\" line505=\"    export function HumidityHigherThan(dat: number, body: () =&gt; void): void {\" line506=\"        control.inBackground(function () {\" line507=\"            while (true) {\" line508=\"                get()\" line509=\"                if (H &gt; dat) {\" line510=\"                    body()\" line511=\"                }\" line512=\"                basic.pause(1000)\" line513=\"            }\" line514=\"        })\" line515=\"    }\" line516=\"\" line517=\"    /**\" line518=\"     * Set the I2C address of the BME280 sensor. / BME280 の I2C アドレスを設定\" line519=\"     * \" line520=\"     *  @param addr I2C address to set / 設定する I2C アドレス\" line521=\"     */\" line522=\"    //% blockId=&quot;BME280_SET_ADDRESS&quot;\" line523=\"    //% block=&quot;I2C Address/I2Cアドレス %addr&quot;\" line524=\"    //% weight=20 blockGap=8\" line525=\"    export function Address(addr: BME280_I2C_ADDRESS) {\" line526=\"        BME280_I2C_ADDR = addr\" line527=\"    }\" line528=\"}\" numlines=\"529\"></mutation></block></statement></block></xml>","main.ts":"namespace BME280 {\n    //Enum Definitions / 列挙型の定義\n    //I2C address/I2Cアドレス\n    export enum BME280_I2C_ADDRESS {\n        //% block=\"0x76\"\n        ADDR_0x76 = 0x76,\n        //% block=\"0x77\"\n        ADDR_0x77 = 0x77\n    }\n\n    //Temperature Unit / 気温の単位\n    // Temperature units: C (Celsius) or F (Fahrenheit) / 温度単位：C（摂氏）または F（華氏）\n    export enum BME280_T {\n        //% block=\"C\"\n        T_C = 0,\n        //% block=\"F\"\n        T_F = 1\n    }\n\n    // Pressure Unit / 気圧の単位\n    // Pressure units: Pa or hPa / 単位：Pa（パスカル）または hPa（ヘクトパスカル）\n    export enum BME280_P {\n        //% block=\"Pa\"\n        Pa = 1,\n        //% block=\"hPa\"\n        hPa = 100\n    }\n\n    // Unit of Elevation difference / 標高差の単位（m/ft）\n    export enum Eldf {\n        //Units meter/単位 メートル\n        //% block=\"m\"\n            altd_m=1,\n        //Units feet/単位 フィート\n        //% block=\"ft\"\n            altd_f = 2\n    }\n\n    // Selection of Saturated Water Vapor Pressure,\n    // Saturated Water Vapor Amount\n    // and Dew Point\n    // 飽和水蒸気圧・飽和水蒸気量・露点の選択\n\n    export enum Spad {\n        //% block=\"Saturated Water Vapor Presure / 飽和水蒸気圧\"\n            swp=1,\n        //% block=\"Saturated Water Vapor Amount / 飽和水蒸気量\"\n            swa=2,\n        //% block=\"Dew Point / 露点\"\n            dwp=3\n    }\n   \n    // Numerical precision\n    // 数値の精度\n    // Integer / 1　decimal place\n    // 整数 / 小数第1位\n    export enum RPoint {\n        //% block=\"Integer/整数\"\n            Rint=1,\n        //% block=\"1 demicl place / 小数第1位\"\n            RPt=10,\n    }\n        \n    /**\n     * Global variables to store the final compensated\n     * temperature, pressure and humidity \n     * temperature\t: unit  °C\n     * pressuere\t: unit Pa\n     * humidity\t\t: unit %\n     * \n     * グローバル変数：補正後の気温・気圧・湿度\n     * 単位　気温：℃　気圧：Pa　湿度：％\n     */\n    let T = 0;\n    let P = 0;\n    let H = 0;\n\n    // Default I2C address: 0x77 / デフォルトの I2C アドレス：0x77\n    let BME280_I2C_ADDR = BME280_I2C_ADDRESS.ADDR_0x76\n\n    // Defining Functions / 関数の定義\n    /** \n     * Functions \"Access to BME280 Registers\"\n     * BME280のレジスタへのアクセスを行う関数群\n     * A set of functions for reading from and writing to BME280\n     * registers via I2C communication.\n     * I2C 通信を用いて、各種レジスタへの読み書きを行う\n     */\n\n    /**\n     * Function \"Writes 1 byte from a register of the BME280\".\n     * BME280のレジスタに1バイトのデータを書き込む関数\n     *\n     * @param reg Register address (integer) / レジストリアドレス（整数値）\n     * @returns dat write (integer) / 書き込んだ値（整数値）\n     * @returns None/戻り値はない\n     *\n     * Creates a 2-byte buffer: the first byte is the register address (buf[0]),\n     * the second byte is the data to write (buf[1]), and sends it via I2C.\n     * レジスタアドレス（buf[0]）と書き込むデータ（buf[1]）を格納した2バイトのバッファを作成し、\n     * I2C を使ってデバイスに送信。\n     */\n    function setreg(reg: number, dat: number): void {\n        let buf = pins.createBuffer(2);\n        buf[0] = reg;\n        buf[1] = dat;\n        pins.i2cWriteBuffer(BME280_I2C_ADDR, buf);\n    }\n\n    /**\n     * Function \"Reads 1 byte from a register of the BME280\".\n     * BME280の任意のレジスタから 1 バイトの値を読み取る関数。\n     *\n     * @param reg Register address (integer) / レジストリアドレス（整数値）\n     * @returns Value read (integer) / 読み取った値（整数値）\n     *\n     * Sends the register address via I2C using UInt8BE format,\n     * then reads 1 byte from the device.\n     * レジストリアドレスを UInt8BE 形式で送信し、1 バイトを読み取って返す。\n     */\n    function getreg(reg: number): number {\n        pins.i2cWriteNumber(BME280_I2C_ADDR, reg, NumberFormat.UInt8BE);\n        return pins.i2cReadNumber(BME280_I2C_ADDR, NumberFormat.UInt8BE);\n    }\n\n    /**\n     * Function \"Reads a 16-bit unsigned integer\".\n     * 8 ビットの符号付き整数を読み取る関数。\n     *\n     * Used for calibration parameters such as dig_H6..\n     * 補正パラメータ dig_H6 に使用。\n     *\n     * @param reg Register address / レジストリアドレス\n     * @returns Unsigned 8-bit integer / 符号付き8ビット整数\n     */\n    function getInt8LE(reg: number): number {\n        pins.i2cWriteNumber(BME280_I2C_ADDR, reg, NumberFormat.UInt8BE);\n        return pins.i2cReadNumber(BME280_I2C_ADDR, NumberFormat.Int8LE);\n    }\n\n    /**\n     * Function \"Reads a 16-bit unsigned integer\".\n     * 16 ビットの符号なし整数を読み取る関数。\n     *\n     * Used for calibration parameters such as dig_T1, dig_P1, etc.\n     * dig_T1、dig_P1 などの補正パラメータ用に使用。\n     *\n     * @param reg Register address / レジストリアドレス\n     * @returns Unsigned 16-bit integer / 符号なし 16 ビット整数\n     */\n    function getUInt16LE(reg: number): number {\n        pins.i2cWriteNumber(BME280_I2C_ADDR, reg, NumberFormat.UInt8BE);\n        return pins.i2cReadNumber(BME280_I2C_ADDR, NumberFormat.UInt16LE);\n    }\n\n    /**\n     * Function \"Reads a 16-bit signed integer\".\n     * 16 ビットの符号付き整数を読み取る関数。\n     * \n     * Used for calibration parameters such as dig_T2, dig_T3, dig_P2.\n     * dig_T2、dig_T3、dig_P2 などの補正パラメータ用に使用します。\n     *\n     * @param reg Register address / レジストリアドレス\n     * @returns Signed 16-bit integer / 符号付き 16 ビット整数\n     */\n    function getInt16LE(reg: number): number {\n        pins.i2cWriteNumber(BME280_I2C_ADDR, reg, NumberFormat.UInt8BE);\n        return pins.i2cReadNumber(BME280_I2C_ADDR, NumberFormat.Int16LE);\n    }\n\n    // Rounding numbers/数値の四捨五入\n    // Integer/demicl 1 place /demicl 2 place\n    // 整数 / 小数第1位 / 小数第２位\n    export function Rnber(dt:number,Rdp:number): number {\n        return Math.round(dt*Rdp)/Rdp\n    }\n\n    // Function \"Get Tempratuer , Pressuer and humidity\".\n    // 気温・気圧・湿度取得の関数\n    /**\n     * BME280 calibration parameters for temperature, pressure and humidity.\n     * BME280 の温度・気圧・湿度補正用キャリブレーションパラメータ。\n     * \n     * Address range: 0x88 to 0xE7 (factory-programmed values)\n     * アドレス範囲：0x88 ～ 0xE7（工場出荷時に書き込まれた補正値）\n     * \n     * Common to BMP280 & BME280 sensors\n     * (excluding humidity-related registers 0xA1 to 0xE7)\n     * BMP280・BME280 センサーで共通\n     *（湿度関連のレジスタ 0xA1 ～ 0xE7は除く）\n     */\n\n    /**\n     * Set \"BME280 calibration parameter registers\"\n     * BME280温度・気圧・湿度補正用キャリブレーションパラメータのレジストリ　\n     * dig_T1 to dig_T3: temperature/気温補正\n     * dig_P1 to dig_P9: pressuere/気圧補正\n     * dig_H1 to dig_H6: humidity/湿度補正\n     */\n    // Temperature calibration parameters / 気温補正用パラメータ\n    let dig_T1 = getUInt16LE(0x88)\n    let dig_T2 = getInt16LE(0x8A)\n    let dig_T3 = getInt16LE(0x8C)\n\n    // Pressure calibration parameters / 気圧補正用パラメータ\n    let dig_P1 = getUInt16LE(0x8E)\n    let dig_P2 = getInt16LE(0x90)\n    let dig_P3 = getInt16LE(0x92)\n    let dig_P4 = getInt16LE(0x94)\n    let dig_P5 = getInt16LE(0x96)\n    let dig_P6 = getInt16LE(0x98)\n    let dig_P7 = getInt16LE(0x9A)\n    let dig_P8 = getInt16LE(0x9C)\n    let dig_P9 = getInt16LE(0x9E)\n\n    // Humidity calibration parameters / 湿度補正用パラメータ   \t\t\n    let dig_H1 = getreg(0xA1)\n    let dig_H2 = getInt16LE(0xE1)\n    let dig_H3 = getreg(0xE3)\n    let a = getreg(0xE5)\n    let dig_H4 = (getreg(0xE4) << 4) + (a % 16)\n    let dig_H5 = (getreg(0xE6) << 4) + (a >> 4)\n    let dig_H6 = getInt8LE(0xE7)\n\n    /**\n     * Sensor configuration:\n     * - Set humidity oversampling to x4 (ctrl_hum, 0xF2)\n     * - Set temperature oversampling to x16, pressure oversampling to x1, normal mode (ctrl_meas, 0xF4)\n     * - Set standby time to 250ms and filter coefficient to x4 (config, 0xF5)\n     *\n     * センサーの設定：\n     * - 湿度のオーバーサンプリングを4倍に設定（ctrl_hum、0xF2）\n     * - 温度のオーバーサンプリングを16倍、気圧を1倍、動作モードをノーマルに設定（ctrl_meas、0xF4）\n     * - スタンバイ時間を250ms、フィルター係数を4倍に設定（config、0xF5）\n     */\n    setreg(0xF2, 0x04)\n    setreg(0xF4, 0x2F)\n    setreg(0xF5, 0x0C)\n\n    /**\n     * Calculate Temperatuer , Pressure and Humidity\n     * 気温・気圧・湿度の算出\n     * Reads raw data from the sensor and calculates\n     * corrected temperature , pressure and humidity.\n     * センサーから生データを読み取り、\n     * 補正済みの気温・気圧・湿度を算出。\n     */\n    function get(): void {\n        // Calculate Temperatuer/気温の計算\n        // Read raw temperature data (20 bits)\n        // 温度の生データ（20ビット）読み取り\n        let adc_T = (getreg(0xFA) << 12) + (getreg(0xFB) << 4) + (getreg(0xFC) >> 4)\n        let var1 = (((adc_T >> 3) - (dig_T1 << 1)) * dig_T2) >> 11\n        let var2 = (((((adc_T >> 4) - dig_T1) * ((adc_T >> 4) - dig_T1)) >> 12) * dig_T3) >> 14\n        let t_fine = var1 + var2;\n        let temp = t_fine;\n        // Calculate corrected temperature(no rounding)\n        // 補正後の気温を計算（数値の丸めなし）\n        T = ((temp * 5 + 128) / 256.0) / 100.0 ;\n\n        // Calculate Pressure/気圧の計算\n        // Read raw pressure data (20 bits)\n        // 気圧の生データ（20ビット）読み取り\n        let adc_P = (getreg(0xF7) << 12) + (getreg(0xF8) << 4) + (getreg(0xF9) >> 4);\n\n        // Pressure compensation calculation\n        // 気圧補正の計算\n        var1 = (t_fine >> 1) - 64000;\n        var2 = (((var1 >> 2) * (var1 >> 2)) >> 11) * dig_P6;\n        var2 = var2 + ((var1 * dig_P5) << 1);\n        var2 = (var2 >> 2) + (dig_P4 << 16);\n        var1 = (((dig_P3 * ((var1 >> 2) * (var1 >> 2)) >> 13) >> 3) + ((dig_P2 * var1) >> 1)) >> 18;\n        var1 = ((32768 + var1) * dig_P1) >> 15;\n        if (var1 == 0) {\n            return; // Prevent division by zero / 0除算防止\n        }\n        let _p = ((1048576 - adc_P) - (var2 >> 12)) * 3125;\n\n        // Calculate Pressure (no rounding)/気圧を算出（数値の丸めなし）\n        _p = (_p / var1) * 2 ;\n        var1 = (dig_P9 * (((_p >> 3) * (_p >> 3)) >> 13)) >> 12;\n        var2 = (((_p >> 2)) * dig_P8) >> 13;\n        P = _p + ((var1 + var2 + dig_P7) >> 4);\n\n        // Calculate Humidity/\t湿度の計算\n        // Read raw pressure data (16 bits)\n        // 湿度の生データ（16ビット）読み取り\n        let adc_H = (getreg(0xFD) << 8) + getreg(0xFE)\n        var1 = t_fine - 76800\n        var2 = (((adc_H << 14) - (dig_H4 << 20) - (dig_H5 * var1)) + 16384) >> 15\n        var1 = var2 * (((((((var1 * dig_H6) >> 10) * (((var1 * dig_H3) >> 11) + 32768)) >> 10) + 2097152) * dig_H2 + 8192) >> 14)\n        var2 = var1 - (((((var1 >> 15) * (var1 >> 15)) >> 7) * dig_H1) >> 4)\n        if (var2 < 0) var2 = 0\n        if (var2 > 419430400) var2 = 419430400\n        // Calculate Humidity (no rounding)/湿度を算出（数値の丸めなし）\n        H = var2 / 4194304.0;\n    }\n    \n    /**\n     * Function Calculate saturation vapor pressure from temperature.\n     * 気温から飽和水蒸気圧を計算する関数\n     * \n     * 精度　小数点第2位\n     */\n    \n    /**\n     *  Get pressure value from BME280 sensor/BME280 センサーから気圧を取得\n     *   \n     *  @param u Pressure unit (Pa or hPa) / 気圧の単位（Pa または hPa）\n     *  @returns Pressure value / 気圧の値（単位に応じた小数第1位）         \n     */\n    //% blockId=\"BME280_GET_PRESSURE\"\n    //% block=\"Pressuer / 気圧 %Pu　Accuracy / 精度 %Prd\"\n    //% weight=80 blockGap=8\n    export function pressure(Pu: BME280_P,Prd: RPoint): number {\n        get();\n        return Rnber(P/Pu,Prd);\n    }\n\n    /**\n     * Get temperature value from BME280 sensor/ BME280 センサーから気温を取得\n     *\n     * @param u Temperature unit (C or F) / 温度の単位（C または F）\n     * @returns Temperature value / 気温の値（単位に応じた小数第1位）\n     */\n    //% blockId=\"BME280_GET_TEMPERATURE\"\n    //% block=\"Tempratuere /気温 %Tu Accuracy / 精度 %Trd\"\n    //% weight=80 blockGap=8\n    export function temperature(Tu: BME280_T, Trd: RPoint): number {\n        get();\n        let tmp=T\n        if (Tu == BME280_T.T_F) { \n            //Fahrenheit degree/華氏\t\n            tmp = T * 9 / 5 + 32;\n        }\n        return Rnber(tmp , Trd);\n    }\n\n    /**\n     * Get humidity value from BME280 sensor / BME280 センサーから湿度を取得\n     *\n     * @param u Humidity unit % / 湿度の単位 %\n     * @returns Temperature value / 湿度の値（小数第1位）\n     */\n    //% blockId=\"BME280_GET_HUMIDITY\"\n    //% block=\"Humidity / 湿度 精度 %Hrd\"\n    //% weight=80 blockGap=8\n    export function humidity(Hrd:RPoint): number {\n        get();\n        return Rnber(H,Hrd);\n    }\n    //Sensor power control (Power ON and OFF)\n    //センサーの電源管理（起動と停止）\n    /**\n     * power on / センサー起動\n     */\n    //% blockId=\"BME280_POWER_ON\" block=\"\n    //% block=\"Power On Sensor /センサー起動\"\"\n    //% weight=22 blockGap=8\n    export function PowerOn() {\n        setreg(0xF4, 0x2F)\n    }\n\n    /**\n     * power oFF　センサー停止\n     */\n    //% blockId=\"BME280_POWER_OFF\"\n    //% block=\"Power OFF Sensor/センサー停止\"\n    //% weight=21 blockGap=8\n    export function PowerOff() {\n        setreg(0xF4, 0)\n    }\n\n    /**\n     * Calculate Elevation difference /標高差の計算\n     * Input the reference point pressure P0 into the block\n     * Get the current pressure and temperature from the sensor.\n     * 基準点の気圧P0をブロックに入力\n     * 現在の気圧・気温はセンサ-から取得\n     */\n    //% block=\"Elevation difference(標高差) %ELU Pressure (reference point)(気圧(基準点)) %P0 %uP0\"\n    //% blockId=\"Elevation_difference\"\n    //% weight=80  blockGap=8\n    export function getElevationdifference(Elu:Eldf,P0: number, uP0: BME280_P):number {\n        get();\n        // Eprs:Current Pressure / 現地点の気圧\n        let Eprs = P    \n         // Etemp:Current Temperatuer（kelvin） /　現地点の気温（絶対温度）\n        let Etemp = T+273.15 //Celsius->kelvin　/ 摂氏－＞絶対温度\n        // Unification of units /単位の統一\n        // If the unit of the pressure P0 at the reference point is Pa, multiply P0 by 1. \n        // If the unit is hPa, multiply P0 by 100.\n        // 基準点の気圧P0の単位がPaならそのまま、hPaなら1/100\n        // uP0:P->1 hPa->1/100\n        Eprs = Eprs *1/uP0 \n        // Calculate Elevation difference / 標高差計算\n        // 0.0065-> Tropospheric temperature lapse rate (0.65℃/100m) \n        // 0.0065-> 対流圏の気温減率（0.65℃/100ｍ）\n        let rt=((P0/Eprs)**(1/5.257)-1)*Etemp\n        //　Calculate Elevation difference / 標高差を算出 (Units/単位:m)\n        let Diffelev=rt/0.0065\n        // Convert values ​​according to altitude units /高度の単位に応じて数値を変換\n        if(Elu==2){\n            Diffelev=Diffelev*3.2808;}\n         return Rnber(Diffelev,10);\n    }\n\n    /**\n     * Calculate Dewpoint　露点計算\n     */\n    //% block=\"Dewpoint / 露点\"\n    //% weight=60 blockGap=8\n    export function Dewpoint(Drd:RPoint): number {\n        get();\n        return T - Math.idiv(100 - H, 5)\n    }\n\n    /**\n     * Event Block\n     * イベントブロック\n    */\n    /**\n     * Triggered when pressure is Lower than a specified value. / 気圧が指定値より低い場合\n     *\n     * @param dat Threshold value / しきい値（Pa）\n     * @param body Action to perform / 実行する処理\n     */\n    //% block=\"Pressuer / 気圧 <  %dat\" dat.defl=100000\n    export function PressureBelowThan(dat: number, body: () => void): void {\n        control.inBackground(function () {\n            while (true) {\n                get()\n                if (P < dat) {\n                    body()\n                }\n                basic.pause(1000)\n            }\n        })\n    }\n\n    /**\n     * Triggered when pressure is Higher than a specified value.\n     * 気圧が指定値より高い場合\n     * @param dat Threshold value / しきい値（Pa）\n     * @param body Action to perform / 実行する処理\n     */\n    //% block=\"Pressuer / 気圧 > %dat\" dat.defl=100000\n    export function PressureHigherThan(dat: number, body: () => void): void {\n        control.inBackground(function () {\n            while (true) {\n                get()\n                if (P > dat) {\n                    body()\n                }\n                basic.pause(1000)\n            }\n        })\n    }\n\n    /**\n     * Triggered when temprature is Lower than a specified value. \n     *  気温が指定値より低い場合\n     *\n     * @param dat Threshold value / しきい値（C）\n     * @param body Action to perform / 実行する処理\n     */\n    //% block=\"Temperature / 気温 < %dat\" dat.defl=10\n    export function TemperatureBelowThan(dat: number, body: () => void): void {\n        control.inBackground(function () {\n            while (true) {\n                get()\n                if (T < dat) {\n                    body()\n                }\n                basic.pause(1000)\n            }\n        })\n    }\n\n    /**\n     * Triggered when tempratuere is Lower than a specified value.\n     * 気温が指定値より低い場合\n     *\n     * @param dat Threshold value / しきい値（C）\n     * @param body Action to perform / 実行する処理\n     */\n    //% block=\"Temperature / 気温 > %dat\" dat.defl=30\n    export function TemperatureHigherThan(dat: number, body: () => void): void {\n        control.inBackground(function () {\n            while (true) {\n                get()\n                if (T > dat) {\n                    body()\n                }\n                basic.pause(1000)\n            }\n        })\n    }\n\n    /**\n     * Triggered when humidity is Lower than a specified value. \n     * 湿度が指定値より低い場合\n     * @param dat Threshold value / しきい値（C）\n     * @param body Action to perform / 実行する処理\n     */\n    //% block=\"Humidity / 湿度 < %dat\" dat.defl=10\n    export function HumidityBelowThan(dat: number, body: () => void): void {\n        control.inBackground(function () {\n            while (true) {\n                get()\n                if (H < dat) {\n                    body()\n                }\n                basic.pause(1000)\n            }\n        })\n    }\n\n    /**\n     * Triggered when humidity is Higher than a specified value. \n     * 湿度が指定値より高い場合\n     * @param dat Threshold value / しきい値（C）\n     * @param body Action to perform / 実行する処理\n     */\n    //% block=\"Humidity / 湿度 > %dat\" dat.defl=10\n    export function HumidityHigherThan(dat: number, body: () => void): void {\n        control.inBackground(function () {\n            while (true) {\n                get()\n                if (H > dat) {\n                    body()\n                }\n                basic.pause(1000)\n            }\n        })\n    }\n\n    /**\n     * Set the I2C address of the BME280 sensor. / BME280 の I2C アドレスを設定\n     * \n     *  @param addr I2C address to set / 設定する I2C アドレス\n     */\n    //% blockId=\"BME280_SET_ADDRESS\"\n    //% block=\"I2C Address/I2Cアドレス %addr\"\n    //% weight=20 blockGap=8\n    export function Address(addr: BME280_I2C_ADDRESS) {\n        BME280_I2C_ADDR = addr\n    }\n}\n","README.md":"","pxt.json":"{\n    \"name\": \"拡張機能確認\",\n    \"description\": \"\",\n    \"dependencies\": {\n        \"core\": \"*\",\n        \"radio\": \"*\",\n        \"microphone\": \"*\"\n    },\n    \"files\": [\n        \"main.blocks\",\n        \"main.ts\",\n        \"README.md\"\n    ],\n    \"preferredEditor\": \"tsprj\"\n}\n"}},{"timestamp":1745969829119,"editorVersion":"7.0.61","text":{"main.blocks":"<xml xmlns=\"https://developers.google.com/blockly/xml\"><variables></variables><block type=\"pxt-on-start\" x=\"0\" y=\"0\"><statement name=\"HANDLER\"><block type=\"typescript_statement\"><mutation xmlns=\"http://www.w3.org/1999/xhtml\" line0=\"namespace BME280 {\" line1=\"    //Enum Definitions / 列挙型の定義\" line2=\"    //I2C address/I2Cアドレス\" line3=\"    export enum BME280_I2C_ADDRESS {\" line4=\"        //% block=&quot;0x76&quot;\" line5=\"        ADDR_0x76 = 0x76,\" line6=\"        //% block=&quot;0x77&quot;\" line7=\"        ADDR_0x77 = 0x77\" line8=\"    }\" line9=\"\" line10=\"    //Temperature Unit / 気温の単位\" line11=\"    // Temperature units: C (Celsius) or F (Fahrenheit) / 温度単位：C（摂氏）または F（華氏）\" line12=\"    export enum BME280_T {\" line13=\"        //% block=&quot;C&quot;\" line14=\"        T_C = 0,\" line15=\"        //% block=&quot;F&quot;\" line16=\"        T_F = 1\" line17=\"    }\" line18=\"\" line19=\"    // Pressure Unit / 気圧の単位\" line20=\"    // Pressure units: Pa or hPa / 単位：Pa（パスカル）または hPa（ヘクトパスカル）\" line21=\"    export enum BME280_P {\" line22=\"        //% block=&quot;Pa&quot;\" line23=\"        Pa = 1,\" line24=\"        //% block=&quot;hPa&quot;\" line25=\"        hPa = 100\" line26=\"    }\" line27=\"\" line28=\"    // Unit of Elevation difference / 標高差の単位（m/ft）\" line29=\"    export enum Eldf {\" line30=\"        //Units meter/単位 メートル\" line31=\"        //% block=&quot;m&quot;\" line32=\"            altd_m=1,\" line33=\"        //Units feet/単位 フィート\" line34=\"        //% block=&quot;ft&quot;\" line35=\"            altd_f = 1/0.3048\" line36=\"    }\" line37=\"   \" line38=\"    // Numerical precision\" line39=\"    // 数値の精度\" line40=\"    // Integer / 1　decimal place / 2 decimal place\" line41=\"    // 整数 / 小数第1位 / 小数第2位\" line42=\"    export enum RPoint {\" line43=\"        //% block=&quot;Integer/整数&quot;\" line44=\"            Rint=1,\" line45=\"        //% block=&quot;1 demicl place / 小数第1位&quot;\" line46=\"            RPt=10,\" line47=\"        //% block=&quot;2 demicl place / 小数第2位&quot;\" line48=\"            RPt2=100\" line49=\"    }\" line50=\"        \" line51=\"    /**\" line52=\"     * Global variables to store the final compensated\" line53=\"     * temperature, pressure and humidity \" line54=\"     * temperature&#9;: unit  °C\" line55=\"     * pressuere&#9;: unit Pa\" line56=\"     * humidity&#9;&#9;: unit %\" line57=\"     * \" line58=\"     * グローバル変数：補正後の気温・気圧・湿度\" line59=\"     * 単位　気温：℃　気圧：Pa　湿度：％\" line60=\"     */\" line61=\"    let T = 0;\" line62=\"    let P = 0;\" line63=\"    let H = 0;\" line64=\"\" line65=\"    // Default I2C address: 0x77 / デフォルトの I2C アドレス：0x77\" line66=\"    let BME280_I2C_ADDR = BME280_I2C_ADDRESS.ADDR_0x76\" line67=\"\" line68=\"    // Defining Functions / 関数の定義\" line69=\"    /** \" line70=\"     * Functions &quot;Access to BME280 Registers&quot;\" line71=\"     * BME280のレジスタへのアクセスを行う関数群\" line72=\"     * A set of functions for reading from and writing to BME280\" line73=\"     * registers via I2C communication.\" line74=\"     * I2C 通信を用いて、各種レジスタへの読み書きを行う\" line75=\"     */\" line76=\"\" line77=\"    /**\" line78=\"     * Function &quot;Writes 1 byte from a register of the BME280&quot;.\" line79=\"     * BME280のレジスタに1バイトのデータを書き込む関数\" line80=\"     *\" line81=\"     * @param reg Register address (integer) / レジストリアドレス（整数値）\" line82=\"     * @returns dat write (integer) / 書き込んだ値（整数値）\" line83=\"     * @returns None/戻り値はない\" line84=\"     *\" line85=\"     * Creates a 2-byte buffer: the first byte is the register address (buf[0]),\" line86=\"     * the second byte is the data to write (buf[1]), and sends it via I2C.\" line87=\"     * レジスタアドレス（buf[0]）と書き込むデータ（buf[1]）を格納した2バイトのバッファを作成し、\" line88=\"     * I2C を使ってデバイスに送信。\" line89=\"     */\" line90=\"    function setreg(reg: number, dat: number): void {\" line91=\"        let buf = pins.createBuffer(2);\" line92=\"        buf[0] = reg;\" line93=\"        buf[1] = dat;\" line94=\"        pins.i2cWriteBuffer(BME280_I2C_ADDR, buf);\" line95=\"    }\" line96=\"\" line97=\"    /**\" line98=\"     * Function &quot;Reads 1 byte from a register of the BME280&quot;.\" line99=\"     * BME280の任意のレジスタから 1 バイトの値を読み取る関数。\" line100=\"     *\" line101=\"     * @param reg Register address (integer) / レジストリアドレス（整数値）\" line102=\"     * @returns Value read (integer) / 読み取った値（整数値）\" line103=\"     *\" line104=\"     * Sends the register address via I2C using UInt8BE format,\" line105=\"     * then reads 1 byte from the device.\" line106=\"     * レジストリアドレスを UInt8BE 形式で送信し、1 バイトを読み取って返す。\" line107=\"     */\" line108=\"    function getreg(reg: number): number {\" line109=\"        pins.i2cWriteNumber(BME280_I2C_ADDR, reg, NumberFormat.UInt8BE);\" line110=\"        return pins.i2cReadNumber(BME280_I2C_ADDR, NumberFormat.UInt8BE);\" line111=\"    }\" line112=\"\" line113=\"    /**\" line114=\"     * Function &quot;Reads a 16-bit unsigned integer&quot;.\" line115=\"     * 8 ビットの符号付き整数を読み取る関数。\" line116=\"     *\" line117=\"     * Used for calibration parameters such as dig_H6..\" line118=\"     * 補正パラメータ dig_H6 に使用。\" line119=\"     *\" line120=\"     * @param reg Register address / レジストリアドレス\" line121=\"     * @returns Unsigned 8-bit integer / 符号付き8ビット整数\" line122=\"     */\" line123=\"    function getInt8LE(reg: number): number {\" line124=\"        pins.i2cWriteNumber(BME280_I2C_ADDR, reg, NumberFormat.UInt8BE);\" line125=\"        return pins.i2cReadNumber(BME280_I2C_ADDR, NumberFormat.Int8LE);\" line126=\"    }\" line127=\"\" line128=\"    /**\" line129=\"     * Function &quot;Reads a 16-bit unsigned integer&quot;.\" line130=\"     * 16 ビットの符号なし整数を読み取る関数。\" line131=\"     *\" line132=\"     * Used for calibration parameters such as dig_T1, dig_P1, etc.\" line133=\"     * dig_T1、dig_P1 などの補正パラメータ用に使用。\" line134=\"     *\" line135=\"     * @param reg Register address / レジストリアドレス\" line136=\"     * @returns Unsigned 16-bit integer / 符号なし 16 ビット整数\" line137=\"     */\" line138=\"    function getUInt16LE(reg: number): number {\" line139=\"        pins.i2cWriteNumber(BME280_I2C_ADDR, reg, NumberFormat.UInt8BE);\" line140=\"        return pins.i2cReadNumber(BME280_I2C_ADDR, NumberFormat.UInt16LE);\" line141=\"    }\" line142=\"\" line143=\"    /**\" line144=\"     * Function &quot;Reads a 16-bit signed integer&quot;.\" line145=\"     * 16 ビットの符号付き整数を読み取る関数。\" line146=\"     * \" line147=\"     * Used for calibration parameters such as dig_T2, dig_T3, dig_P2.\" line148=\"     * dig_T2、dig_T3、dig_P2 などの補正パラメータ用に使用します。\" line149=\"     *\" line150=\"     * @param reg Register address / レジストリアドレス\" line151=\"     * @returns Signed 16-bit integer / 符号付き 16 ビット整数\" line152=\"     */\" line153=\"    function getInt16LE(reg: number): number {\" line154=\"        pins.i2cWriteNumber(BME280_I2C_ADDR, reg, NumberFormat.UInt8BE);\" line155=\"        return pins.i2cReadNumber(BME280_I2C_ADDR, NumberFormat.Int16LE);\" line156=\"    }\" line157=\"\" line158=\"    // Rounding numbers/数値の四捨五入\" line159=\"    // Integer/demicl 1 place /demicl 2 place\" line160=\"    // 整数 / 小数第1位 / 小数第２位\" line161=\"    export function Rnber(dt:number,Rdp:number): number {\" line162=\"        return Math.round(dt*Rdp)/Rdp\" line163=\"    }\" line164=\"\" line165=\"    // Function &quot;Get Tempratuer , Pressuer and humidity&quot;.\" line166=\"    // 気温・気圧・湿度取得の関数\" line167=\"    /**\" line168=\"     * BME280 calibration parameters for temperature, pressure and humidity.\" line169=\"     * BME280 の温度・気圧・湿度補正用キャリブレーションパラメータ。\" line170=\"     * \" line171=\"     * Address range: 0x88 to 0xE7 (factory-programmed values)\" line172=\"     * アドレス範囲：0x88 ～ 0xE7（工場出荷時に書き込まれた補正値）\" line173=\"     * \" line174=\"     * Common to BMP280 &amp; BME280 sensors\" line175=\"     * (excluding humidity-related registers 0xA1 to 0xE7)\" line176=\"     * BMP280・BME280 センサーで共通\" line177=\"     *（湿度関連のレジスタ 0xA1 ～ 0xE7は除く）\" line178=\"     */\" line179=\"\" line180=\"    /**\" line181=\"     * Set &quot;BME280 calibration parameter registers&quot;\" line182=\"     * BME280温度・気圧・湿度補正用キャリブレーションパラメータのレジストリ　\" line183=\"     * dig_T1 to dig_T3: temperature/気温補正\" line184=\"     * dig_P1 to dig_P9: pressuere/気圧補正\" line185=\"     * dig_H1 to dig_H6: humidity/湿度補正\" line186=\"     */\" line187=\"    // Temperature calibration parameters / 気温補正用パラメータ\" line188=\"    let dig_T1 = getUInt16LE(0x88)\" line189=\"    let dig_T2 = getInt16LE(0x8A)\" line190=\"    let dig_T3 = getInt16LE(0x8C)\" line191=\"\" line192=\"    // Pressure calibration parameters / 気圧補正用パラメータ\" line193=\"    let dig_P1 = getUInt16LE(0x8E)\" line194=\"    let dig_P2 = getInt16LE(0x90)\" line195=\"    let dig_P3 = getInt16LE(0x92)\" line196=\"    let dig_P4 = getInt16LE(0x94)\" line197=\"    let dig_P5 = getInt16LE(0x96)\" line198=\"    let dig_P6 = getInt16LE(0x98)\" line199=\"    let dig_P7 = getInt16LE(0x9A)\" line200=\"    let dig_P8 = getInt16LE(0x9C)\" line201=\"    let dig_P9 = getInt16LE(0x9E)\" line202=\"\" line203=\"    // Humidity calibration parameters / 湿度補正用パラメータ   &#9;&#9;\" line204=\"    let dig_H1 = getreg(0xA1)\" line205=\"    let dig_H2 = getInt16LE(0xE1)\" line206=\"    let dig_H3 = getreg(0xE3)\" line207=\"    let a = getreg(0xE5)\" line208=\"    let dig_H4 = (getreg(0xE4) &lt;&lt; 4) + (a % 16)\" line209=\"    let dig_H5 = (getreg(0xE6) &lt;&lt; 4) + (a &gt;&gt; 4)\" line210=\"    let dig_H6 = getInt8LE(0xE7)\" line211=\"\" line212=\"    /**\" line213=\"     * Sensor configuration:\" line214=\"     * - Set humidity oversampling to x4 (ctrl_hum, 0xF2)\" line215=\"     * - Set temperature oversampling to x16, pressure oversampling to x1, normal mode (ctrl_meas, 0xF4)\" line216=\"     * - Set standby time to 250ms and filter coefficient to x4 (config, 0xF5)\" line217=\"     *\" line218=\"     * センサーの設定：\" line219=\"     * - 湿度のオーバーサンプリングを4倍に設定（ctrl_hum、0xF2）\" line220=\"     * - 温度のオーバーサンプリングを16倍、気圧を1倍、動作モードをノーマルに設定（ctrl_meas、0xF4）\" line221=\"     * - スタンバイ時間を250ms、フィルター係数を4倍に設定（config、0xF5）\" line222=\"     */\" line223=\"    setreg(0xF2, 0x04)\" line224=\"    setreg(0xF4, 0x2F)\" line225=\"    setreg(0xF5, 0x0C)\" line226=\"\" line227=\"    /**\" line228=\"     * Calculate Temperatuer , Pressure and Humidity\" line229=\"     * 気温・気圧・湿度の算出\" line230=\"     * Reads raw data from the sensor and calculates\" line231=\"     * corrected temperature , pressure and humidity.\" line232=\"     * センサーから生データを読み取り、\" line233=\"     * 補正済みの気温・気圧・湿度を算出。\" line234=\"     */\" line235=\"    function get(): void {\" line236=\"        // Calculate Temperatuer/気温の計算\" line237=\"        // Read raw temperature data (20 bits)\" line238=\"        // 温度の生データ（20ビット）読み取り\" line239=\"        let adc_T = (getreg(0xFA) &lt;&lt; 12) + (getreg(0xFB) &lt;&lt; 4) + (getreg(0xFC) &gt;&gt; 4)\" line240=\"        let var1 = (((adc_T &gt;&gt; 3) - (dig_T1 &lt;&lt; 1)) * dig_T2) &gt;&gt; 11\" line241=\"        let var2 = (((((adc_T &gt;&gt; 4) - dig_T1) * ((adc_T &gt;&gt; 4) - dig_T1)) &gt;&gt; 12) * dig_T3) &gt;&gt; 14\" line242=\"        let t_fine = var1 + var2;\" line243=\"        let temp = t_fine;\" line244=\"        // Calculate corrected temperature(no rounding)\" line245=\"        // 補正後の気温を計算（数値の丸めなし）\" line246=\"        T = ((temp * 5 + 128) / 256.0) / 100.0 ;\" line247=\"\" line248=\"        // Calculate Pressure/気圧の計算\" line249=\"        // Read raw pressure data (20 bits)\" line250=\"        // 気圧の生データ（20ビット）読み取り\" line251=\"        let adc_P = (getreg(0xF7) &lt;&lt; 12) + (getreg(0xF8) &lt;&lt; 4) + (getreg(0xF9) &gt;&gt; 4);\" line252=\"\" line253=\"        // Pressure compensation calculation\" line254=\"        // 気圧補正の計算\" line255=\"        var1 = (t_fine &gt;&gt; 1) - 64000;\" line256=\"        var2 = (((var1 &gt;&gt; 2) * (var1 &gt;&gt; 2)) &gt;&gt; 11) * dig_P6;\" line257=\"        var2 = var2 + ((var1 * dig_P5) &lt;&lt; 1);\" line258=\"        var2 = (var2 &gt;&gt; 2) + (dig_P4 &lt;&lt; 16);\" line259=\"        var1 = (((dig_P3 * ((var1 &gt;&gt; 2) * (var1 &gt;&gt; 2)) &gt;&gt; 13) &gt;&gt; 3) + ((dig_P2 * var1) &gt;&gt; 1)) &gt;&gt; 18;\" line260=\"        var1 = ((32768 + var1) * dig_P1) &gt;&gt; 15;\" line261=\"        if (var1 == 0) {\" line262=\"            return; // Prevent division by zero / 0除算防止\" line263=\"        }\" line264=\"        let _p = ((1048576 - adc_P) - (var2 &gt;&gt; 12)) * 3125;\" line265=\"\" line266=\"        // Calculate Pressure (no rounding)/気圧を算出（数値の丸めなし）\" line267=\"        _p = (_p / var1) * 2 ;\" line268=\"        var1 = (dig_P9 * (((_p &gt;&gt; 3) * (_p &gt;&gt; 3)) &gt;&gt; 13)) &gt;&gt; 12;\" line269=\"        var2 = (((_p &gt;&gt; 2)) * dig_P8) &gt;&gt; 13;\" line270=\"        P = _p + ((var1 + var2 + dig_P7) &gt;&gt; 4);\" line271=\"\" line272=\"        // Calculate Humidity/&#9;湿度の計算\" line273=\"        // Read raw pressure data (16 bits)\" line274=\"        // 湿度の生データ（16ビット）読み取り\" line275=\"        let adc_H = (getreg(0xFD) &lt;&lt; 8) + getreg(0xFE)\" line276=\"        var1 = t_fine - 76800\" line277=\"        var2 = (((adc_H &lt;&lt; 14) - (dig_H4 &lt;&lt; 20) - (dig_H5 * var1)) + 16384) &gt;&gt; 15\" line278=\"        var1 = var2 * (((((((var1 * dig_H6) &gt;&gt; 10) * (((var1 * dig_H3) &gt;&gt; 11) + 32768)) &gt;&gt; 10) + 2097152) * dig_H2 + 8192) &gt;&gt; 14)\" line279=\"        var2 = var1 - (((((var1 &gt;&gt; 15) * (var1 &gt;&gt; 15)) &gt;&gt; 7) * dig_H1) &gt;&gt; 4)\" line280=\"        if (var2 &lt; 0) var2 = 0\" line281=\"        if (var2 &gt; 419430400) var2 = 419430400\" line282=\"        // Calculate Humidity (no rounding)/湿度を算出（数値の丸めなし）\" line283=\"        H = var2 / 4194304.0\" line284=\"    }\" line285=\"    \" line286=\"    /**\" line287=\"     *  Get pressure value from BME280 sensor/BME280 センサーから気圧を取得\" line288=\"     *   \" line289=\"     *  @param u Pressure unit (Pa or hPa) / 気圧の単位（Pa または hPa）\" line290=\"     *  @returns Pressure value / 気圧の値（単位に応じた小数第1位）         \" line291=\"     */\" line292=\"    //% blockId=&quot;BME280_GET_PRESSURE&quot;\" line293=\"    //% block=&quot;Pressuer / 気圧 %Pu　Accuracy / 精度 %Prd&quot;\" line294=\"    //% weight=80 blockGap=8\" line295=\"    export function pressure(Pu: BME280_P,Prd: RPoint): number {\" line296=\"        get();\" line297=\"        return Rnber(P/Pu,Prd)\" line298=\"    }\" line299=\"\" line300=\"    /**\" line301=\"     * Get temperature value from BME280 sensor/ BME280 センサーから気温を取得\" line302=\"     *\" line303=\"     * @param u Temperature unit (C or F) / 温度の単位（C または F）\" line304=\"     * @returns Temperature value / 気温の値（単位に応じた小数第1位）\" line305=\"     */\" line306=\"    //% blockId=&quot;BME280_GET_TEMPERATURE&quot;\" line307=\"    //% block=&quot;Tempratuere /気温 %Tu Accuracy / 精度 %Trd&quot;\" line308=\"    //% weight=80 blockGap=8\" line309=\"    export function temperature(Tu: BME280_T, Trd: RPoint): number {\" line310=\"        get();\" line311=\"        let tmp=T\" line312=\"        if (Tu == BME280_T.T_F) { \" line313=\"            //Fahrenheit degree/華氏&#9;\" line314=\"            tmp = T * 9 / 5 + 32;\" line315=\"        }\" line316=\"        return Rnber(tmp , Trd)\" line317=\"    }\" line318=\"\" line319=\"    /**\" line320=\"     * Get humidity value from BME280 sensor / BME280 センサーから湿度を取得\" line321=\"     *\" line322=\"     * @param u Humidity unit % / 湿度の単位 %\" line323=\"     * @returns Temperature value / 湿度の値（小数第1位）\" line324=\"     */\" line325=\"    //% blockId=&quot;BME280_GET_HUMIDITY&quot;\" line326=\"    //% block=&quot;Humidity / 湿度 精度 %Hrd&quot;\" line327=\"    //% weight=80 blockGap=8\" line328=\"    export function humidity(Hrd:RPoint): number {\" line329=\"        get();\" line330=\"        return Rnber(H,Hrd);\" line331=\"    }\" line332=\"    //Sensor power control (Power ON and OFF)\" line333=\"    //センサーの電源管理（起動と停止）\" line334=\"    /**\" line335=\"     * power on / センサー起動\" line336=\"     */\" line337=\"    //% blockId=&quot;BME280_POWER_ON&quot; block=&quot;\" line338=\"    //% block=&quot;Power On Sensor /センサー起動&quot;&quot;\" line339=\"    //% weight=22 blockGap=8\" line340=\"    export function PowerOn() {\" line341=\"        setreg(0xF4, 0x2F)\" line342=\"    }\" line343=\"\" line344=\"    /**\" line345=\"     * power oFF　センサー停止\" line346=\"     */\" line347=\"    //% blockId=&quot;BME280_POWER_OFF&quot;\" line348=\"    //% block=&quot;Power OFF Sensor/センサー停止&quot;\" line349=\"    //% weight=21 blockGap=8\" line350=\"    export function PowerOff() {\" line351=\"        setreg(0xF4, 0)\" line352=\"    }\" line353=\"\" line354=\"    /**\" line355=\"     * Calculate Elevation difference /標高差の計算\" line356=\"     * Input the reference point pressure P0 into the block\" line357=\"     * Get the current pressure and temperature from the sensor.\" line358=\"     * 基準点の気圧P0をブロックに入力\" line359=\"     * 現在の気圧・気温はセンサ-から取得\" line360=\"     */\" line361=\"    //% block=&quot;Elevation difference(標高差) %ELU Pressure (reference point)(気圧(基準点)) %P0 %uP0&quot;\" line362=\"    //% blockId=&quot;Elevation_difference&quot;\" line363=\"    //% weight=80  blockGap=8\" line364=\"    export function getElevationdifference(Elu:Eldf,P0: number, uP0: BME280_P):number {\" line365=\"        get();\" line366=\"        // Eprs:Current Pressure / 現地点の気圧\" line367=\"        let Eprs = P    \" line368=\"         // Etemp:Current Temperatuer（kelvin） /　現地点の気温（絶対温度）\" line369=\"        let Etemp = T+273.15 //Celsius-&gt;kelvin　/ 摂氏－＞絶対温度\" line370=\"        // Unification of units /単位の統一\" line371=\"        // If the unit of the pressure P0 at the reference point is Pa, multiply P0 by 1. \" line372=\"        // If the unit is hPa, multiply P0 by 100.\" line373=\"        // 基準点の気圧P0の単位がPaならそのまま、hPaなら1/100\" line374=\"        // uP0:P-&gt;1 hPa-&gt;1/100\" line375=\"        Eprs = Eprs *1/uP0 \" line376=\"        // Calculate Elevation difference / 標高差計算\" line377=\"        // 0.0065-&gt; Tropospheric temperature lapse rate (0.65℃/100m) \" line378=\"        // 0.0065-&gt; 対流圏の気温減率（0.65℃/100ｍ）\" line379=\"        let rt=((P0/Eprs)**(1/5.257)-1)*Etemp\" line380=\"        //　Calculate Elevation difference / 標高差を算出 (Units/単位:m)\" line381=\"        let Diffelev=rt/0.0065\" line382=\"        // Convert values ​​according to altitude units /高度の単位に応じて数値を変換\" line383=\"\" line384=\"         return Rnber(Diffelev*Elu,10)\" line385=\"    }\" line386=\"\" line387=\"    /**\" line388=\"     * Calculate Dewpoint　露点計算\" line389=\"     */\" line390=\"    //% block=&quot;Dewpoint / 露点&quot;\" line391=\"    //% weight=60 blockGap=8\" line392=\"    export function Dewpoint(Drd:RPoint): number {\" line393=\"        get();\" line394=\"        return T - Math.idiv(100 - H, 5)\" line395=\"    }\" line396=\"\" line397=\"    /**\" line398=\"     * Event Block\" line399=\"     * イベントブロック\" line400=\"    */\" line401=\"    /**\" line402=\"     * Triggered when pressure is Lower than a specified value.